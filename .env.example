# Express `trust proxy` hop count. 1 behind a single reverse proxy such as
# Caddy (production); 0 for direct exposure and in dev/tests. Never set to a
# non-numeric value like "true" -- see apps/api/src/main.ts for why.
TRUST_PROXY_HOPS=0
