DATABASE_URL=postgres://markiro:markiro@localhost:5432/markiro
BETTER_AUTH_SECRET=dev-secret-change-me
BETTER_AUTH_URL=http://localhost:3000
ADMIN_ORIGIN=http://localhost:5173
# Separate platform authentication secret and exact SaaS admin origin. The
# SaaS admin dev server uses a different origin from customer admin and station.
PLATFORM_AUTH_SECRET=dev-platform-secret-change-me-0001
PLATFORM_AUTH_URL=http://localhost:3000
SAAS_ADMIN_ORIGIN=http://localhost:5473
SUBSCRIPTION_ENFORCEMENT_MODE=managed_only
# Explicit compatibility window for proofless orders queued by kiosk bundles
# deployed before admission proofs. Set per rollout after the final old bundle
# can no longer have queued work. Intentionally blank: every rollout must set
# and validate its own temporary cutoff; unset fails closed.
KIOSK_LEGACY_PROOFLESS_RECOVERY_UNTIL=
# Independent HMAC secret for server-issued kiosk admission proofs. During a
# rotation, move the old current value to PREVIOUS until its last proof expires.
KIOSK_ADMISSION_PROOF_SECRET=dev-kiosk-admission-proof-secret-change-me
# KIOSK_ADMISSION_PROOF_PREVIOUS_SECRET=
# Origin the pickup kiosk PWA is served from, for a deployment that serves it
# from a different host/port than the admin panel. OPTIONAL and intentionally
# left unset here: unset means "no kiosk origin is trusted", and the kiosk dev
# server (port 5373) proxies /api same-origin, so dev never needs it. Set it
# only when the kiosk is served cross-origin, e.g.
# KIOSK_ORIGIN=https://kiosk.example.ru
# Origin the Tauri station webview uses when it calls the API cross-origin.
# Station routes are scoped separately from sessions and kiosk routes. The
# Vite station dev server runs on 5273, so this is the deliberate local CORS
# allowance (not a production fallback).
STATION_ORIGIN=http://localhost:5273
# Build-time API base embedded in apps/station. It must be a canonical HTTP(S)
# origin with no path or userinfo; pairing never derives an API host from the
# webview URL. Production station builds must set their actual API origin.
VITE_STATION_API_URL=http://localhost:3000
PORT=3000
# Keys the HMAC that hashes 8-digit kiosk pairing codes before storage, so a
# DB dump alone can't be brute-forced offline to recover live codes. Rotating
# it invalidates every outstanding pairing code -- fine, they live 15 minutes.
PAIRING_CODE_PEPPER=dev-pairing-code-pepper-change-me
# Express `trust proxy` hop count. 1 behind a single reverse proxy such as
# Caddy (production); 0 for direct exposure and in dev/tests. Never set to a
# non-numeric value like "true" -- see apps/api/src/main.ts for why. Must
# equal exactly the number of proxies that append to X-Forwarded-For --
# setting it too high re-enables header spoofing (an attacker-controlled
# entry closer to the trusted end gets trusted instead).
TRUST_PROXY_HOPS=0

# Development SMTP is captured by Mailpit (UI: http://localhost:8025).
# Production must use the ready mailbox's real SMTP host, credentials and TLS mode.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_FROM_EMAIL=no-reply@markiro.local
SMTP_FROM_NAME=Маркиро
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_REPLY_TO=

# Development-only deterministic key. Production must use an independent,
# random base64-encoded 32-byte key from the secret manager.
MAIL_PAYLOAD_ENCRYPTION_KEY=bW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW1tbW0=

# Private S3-compatible storage. The local compose stack creates this bucket
# in MinIO idempotently; production should point at Object Storage.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=markiro-private
S3_ACCESS_KEY_ID=markiro
S3_SECRET_ACCESS_KEY=markiro-development-only
S3_FORCE_PATH_STYLE=true
