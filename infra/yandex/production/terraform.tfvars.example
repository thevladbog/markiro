cloud_id                  = "replace-with-yandex-cloud-id"
folder_id                 = "replace-with-production-folder-id"
zone                      = "ru-central1-d"
alb_subnet_cidr           = "10.64.0.0/24"
app_subnet_cidr           = "10.64.1.0/24"
data_subnet_cidr          = "10.64.2.0/24"
ubuntu_lts_image_family   = "ubuntu-2404-lts"
kms_key_id                = "replace-with-existing-kms-key-id"
app_service_account_id    = "replace-with-bootstrap-app-service-account-id"
terraform_service_account_id = "replace-with-bootstrap-terraform-service-account-id"
runtime_secret_id         = "replace-with-bootstrap-runtime-lockbox-secret-id"
registry_secret_id        = "replace-with-bootstrap-registry-lockbox-secret-id"
deployment_controller_service_account_id = "replace-with-bootstrap-deployment-controller-service-account-id"
app_deploy_ssh_public_key = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIReplaceWithDedicatedDeploymentPublicKey"
audit_service_account_id  = "replace-with-bootstrap-audit-service-account-id"
audit_log_group_id        = "replace-with-bootstrap-audit-log-group-id"
database_name             = "markiro"
database_disk_size_gb     = 50
state_bucket_name         = "replace-with-bootstrap-state-bucket-name"
media_bucket_name         = "replace-with-private-media-bucket-name"
audit_bucket_name         = "replace-with-private-audit-bucket-name"
domain                    = "admin.markiro.example.ru"
kiosk_domain              = "kiosk.markiro.example.ru"
dns_zone_id               = "replace-with-cloud-dns-zone-id"
public_dns_enabled        = false
# First provisioning deliberately omits notification_channel_id and alert_ids,
# then protected phase records the exact reviewed console values below.
observability_phase       = "protected"
notification_channel_id   = "replace-with-monitoring-notification-channel-id"
alert_ids = {
  alb_healthy_backend                       = "replace-with-alert-id"
  alb_5xx                                   = "replace-with-alert-id"
  alb_latency                               = "replace-with-alert-id"
  sws_deny                                  = "replace-with-alert-id"
  sws_arl                                   = "replace-with-alert-id"
  vm_cpu                                    = "replace-with-alert-id"
  vm_memory                                 = "replace-with-alert-id"
  vm_disk                                   = "replace-with-alert-id"
  postgres_availability                     = "replace-with-alert-id"
  postgres_storage                          = "replace-with-alert-id"
  postgres_connections                      = "replace-with-alert-id"
  postgres_backup_age                       = "replace-with-alert-id"
  certificate_risk                          = "replace-with-alert-id"
  readiness_required_unavailable            = "replace-with-alert-id"
  deployment_failure                        = "replace-with-alert-id"
}
