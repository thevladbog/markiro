cloud_id                    = "replace-with-yandex-cloud-id"
folder_id                   = "replace-with-production-folder-id"
zone                        = "ru-central1-d"
app_subnet_cidr             = "10.64.1.0/24"
data_subnet_cidr            = "10.64.2.0/24"
ubuntu_lts_image_family     = "ubuntu-2404-lts"
kms_key_id                  = "replace-with-existing-kms-key-id"
app_service_account_id      = "replace-with-app-service-account-id"
terraform_service_account_id = "replace-with-terraform-service-account-id"
runtime_secret_id           = "replace-with-runtime-lockbox-secret-id"
app_deploy_ssh_public_key   = "ssh-ed25519 AAAAC3NzaC1lZDI1NTE5AAAAIReplaceWithDedicatedDeploymentPublicKey"
database_name               = "markiro"
database_disk_size_gb       = 50
state_bucket_name           = "replace-with-state-bucket-name"
media_bucket_name           = "replace-with-media-bucket-name"
audit_bucket_name           = "replace-with-temporarily-retained-audit-bucket-name"
domain                      = "admin.markiro.app"
kiosk_domain                = "kiosk.markiro.app"
landing_domain              = "markiro.app"
dns_zone_id                 = "replace-with-cloud-dns-zone-id"
public_dns_enabled          = false
