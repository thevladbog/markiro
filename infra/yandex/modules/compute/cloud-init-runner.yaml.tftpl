#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - iptables
  - jq
  - openssh-client
  - tar
groups:
  - docker
users:
  - name: markiro-runner
    system: true
    shell: /usr/sbin/nologin
    groups: [docker]
  - name: markiro-monitor
    system: true
    shell: /usr/sbin/nologin
write_files:
  - path: /usr/local/lib/markiro/install-container-runtime
    permissions: "0700"
    encoding: b64
    content: ${container_installer_b64}
  - path: /usr/local/lib/markiro/monitoring-producer.mjs
    owner: root:root
    permissions: "0755"
    encoding: b64
    content: ${monitoring_producer_b64}
  - path: /usr/local/lib/markiro/log-sanitizer.mjs
    permissions: "0700"
    encoding: b64
    content: ${log_sanitizer_script_b64}
  - path: /usr/local/lib/markiro/cli-main.mjs
    permissions: "0644"
    encoding: b64
    content: ${cli_main_script_b64}
  - path: /usr/local/lib/markiro/runner-jit
    permissions: "0755"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail
      umask 077

      fail() {
        printf '%s\n' "markiro runner bootstrap failed" >&2
        exit 1
      }
      trap fail ERR

      tmp_dir=/run/markiro-runner
      install -d -m 0700 "$tmp_dir"
      jit_path="$tmp_dir/jitconfig"
      trap 'unset iam_token jit_config; rm -f "$jit_path"' EXIT
      for _ in $(seq 1 120); do
        if curl --fail --silent --show-error \
          --header 'Metadata-Flavor: Google' \
          http://169.254.169.254/computeMetadata/v1/instance/attributes/markiro-runner-jit \
          --output "$jit_path"; then
          break
        fi
        sleep 1
      done
      test -s "$jit_path"
      test "$(wc -c < "$jit_path")" -le 262144
      jit_config="$(cat "$jit_path")"
      rm -f "$jit_path"

      instance_id="$(curl --fail --silent --show-error \
        --header 'Metadata-Flavor: Google' \
        http://169.254.169.254/computeMetadata/v1/instance/id)"
      iam_token="$(curl --fail --silent --show-error \
        --header 'Metadata-Flavor: Google' \
        http://169.254.169.254/computeMetadata/v1/instance/service-accounts/default/token | \
        jq -er '.access_token | select(type == "string" and length > 0)')"
      operation_id="$(curl --fail --silent --show-error \
        --request POST \
        --header "Authorization: Bearer $iam_token" \
        --header 'Content-Type: application/json' \
        --data '{"delete":["markiro-runner-jit"]}' \
        "https://compute.api.cloud.yandex.net/compute/v1/instances/$instance_id/updateMetadata" | \
        jq -er '.id | select(type == "string" and length > 0)')"
      for _ in $(seq 1 30); do
        done_state="$(curl --fail --silent --show-error \
          --header "Authorization: Bearer $iam_token" \
          "https://operation.api.cloud.yandex.net/operations/$operation_id" | jq -er '.done')"
        test "$done_state" = false || break
        sleep 1
      done
      test "$done_state" = true
      unset iam_token
      if curl --fail --silent \
        --header 'Metadata-Flavor: Google' \
        http://169.254.169.254/computeMetadata/v1/instance/attributes/markiro-runner-jit \
        --output /dev/null; then
        fail
      fi
      trap - ERR
      exec /opt/actions-runner/run.sh --jitconfig "$jit_config"

  - path: /etc/systemd/system/markiro-runner.service
    permissions: "0644"
    encoding: b64
    content: ${runner_unit_b64}
  - path: /etc/systemd/system/docker.service
    permissions: "0644"
    encoding: b64
    content: ${docker_unit_b64}
  - path: /etc/systemd/system/markiro-runner-monitoring.service
    permissions: "0644"
    encoding: b64
    content: ${runner_monitoring_unit_b64}
  - path: /etc/systemd/system/markiro-runner-monitoring.timer
    permissions: "0644"
    encoding: b64
    content: ${runner_monitoring_timer_b64}
  - path: /etc/systemd/system/markiro-log-sanitizer.service
    permissions: "0644"
    encoding: b64
    content: ${log_sanitizer_unit_b64}
  - path: /etc/systemd/system/markiro-log-sanitizer.timer
    permissions: "0644"
    encoding: b64
    content: ${log_sanitizer_timer_b64}
  - path: /etc/yandex/unified_agent/conf.d/markiro-logs.yml
    permissions: "0640"
    encoding: b64
    content: ${unified_agent_logs_b64}
  - path: /etc/markiro-monitor/monitoring.conf
    owner: root:root
    permissions: "0600"
    content: |
      MARKIRO_FOLDER_ID=${folder_id}
runcmd:
  - - /usr/bin/bash
    - -ceu
    - |
        set -o pipefail
        install -d -m 0755 /usr/local/lib/markiro /opt/markiro /opt/actions-runner /var/lib/markiro
        install -d -m 0750 -o root -g markiro-monitor /etc/markiro-monitor
        chown root:markiro-monitor /etc/markiro-monitor/monitoring.conf
        chmod 0640 /etc/markiro-monitor/monitoring.conf
        chown -R markiro-runner:markiro-runner /opt/actions-runner
        printf '%s\n' 'MARKIRO_RUNNER_BOOTSTRAP_STAGE container-runtime' > /dev/ttyS0
        /usr/local/lib/markiro/install-container-runtime

        printf '%s\n' 'MARKIRO_RUNNER_BOOTSTRAP_STAGE node' > /dev/ttyS0
        NODE_VERSION=24.11.1
        NODE_SHA256=60e3b0a8500819514aca603487c254298cd776de0698d3cd08f11dba5b8289a8
        archive=/tmp/node.tar.xz
        curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
          "https://nodejs.org/dist/v$${NODE_VERSION}/node-v$${NODE_VERSION}-linux-x64.tar.xz" \
          --output "$${archive}"
        printf '%s  %s\n' "$${NODE_SHA256}" "$${archive}" | sha256sum --check --status
        tar -xJf "$${archive}" -C /opt/markiro
        rm -f "$${archive}"
        ln -sfn "/opt/markiro/node-v$${NODE_VERSION}-linux-x64/bin/node" /usr/bin/node
        test "$(node --version)" = "v$${NODE_VERSION}"

        printf '%s\n' 'MARKIRO_RUNNER_BOOTSTRAP_STAGE unified-agent' > /dev/ttyS0
        UA_VERSION=26.07.11
        UA_SHA256=30e216b61b44eecb443942b986e44c0d83c0548a1bc6dbebb134067d678e2dc7
        package=/tmp/yandex-unified-agent.deb
        curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
          "https://storage.yandexcloud.net/yc-unified-agent/releases/$${UA_VERSION}/deb/ubuntu-24.04-noble/yandex-unified-agent_$${UA_VERSION}_amd64.deb" \
          --output "$${package}"
        printf '%s  %s\n' "$${UA_SHA256}" "$${package}" | sha256sum --check --status
        dpkg -i "$${package}"
        rm -f "$${package}"
        test "$(dpkg-query -W -f='$${Version}' yandex-unified-agent)" = "$${UA_VERSION}"
        install -d -m 2750 -o root -g unified_agent /var/log/markiro
        install -d -m 0750 -o unified_agent -g unified_agent /var/lib/yandex/unified_agent/markiro
        touch /var/log/markiro/observability.log
        chown root:unified_agent /var/log/markiro/observability.log
        chmod 0640 /var/log/markiro/observability.log
        chown root:unified_agent /etc/yandex/unified_agent/conf.d/markiro-logs.yml
        chmod 0640 /etc/yandex/unified_agent/conf.d/markiro-logs.yml
        runuser --user unified_agent -- test -r /var/log/markiro/observability.log
        runuser --user unified_agent -- /usr/bin/unified_agent --config /etc/yandex/unified_agent/config.yml check-config > /dev/null

        printf '%s\n' 'MARKIRO_RUNNER_BOOTSTRAP_STAGE actions-runner' > /dev/ttyS0
        RUNNER_VERSION=2.336.0
        RUNNER_SHA256=04cf0be1aff4c3ec3554466c39124ca250e3effd8873bb7e8d68535aa9505d5d
        archive=/tmp/actions-runner-linux-x64.tar.gz
        test "$(uname -m)" = x86_64
        curl --fail --silent --show-error --location \
          "https://github.com/actions/runner/releases/download/v$RUNNER_VERSION/actions-runner-linux-x64-$RUNNER_VERSION.tar.gz" \
          --output "$archive"
        printf '%s  %s\n' "$RUNNER_SHA256" "$archive" | sha256sum --check --status
        tar -xzf "$archive" -C /opt/actions-runner --no-same-owner
        rm -f "$archive"
        chown -R markiro-runner:markiro-runner /opt/actions-runner

        printf '%s\n' 'MARKIRO_RUNNER_BOOTSTRAP_STAGE yc' > /dev/ttyS0
        YC_VERSION=1.23.0
        YC_SHA256=3e287905b63685847aa77f17f92bf7156037cc63b9a42c6cd901db69a61604c9
        binary=/tmp/yc
        curl --fail --silent --show-error --location --proto '=https' --tlsv1.2 \
          "https://storage.yandexcloud.net/yandexcloud-yc/release/$YC_VERSION/linux/amd64/yc" \
          --output "$binary"
        printf '%s  %s\n' "$YC_SHA256" "$binary" | sha256sum --check --status
        install -m 0755 "$binary" /usr/local/bin/yc
        rm -f "$binary"
        test "$(/usr/local/bin/yc version --semantic)" = "$YC_VERSION"

        printf '%s\n' 'MARKIRO_RUNNER_BOOTSTRAP_STAGE systemd' > /dev/ttyS0
        systemctl daemon-reload
        systemctl enable docker.service markiro-runner-monitoring.timer markiro-log-sanitizer.timer
        systemctl start docker.service
        test "$(docker version --format '{{.Server.Version}}')" = "28.5.2"
        test "$(docker compose version --short)" = "2.40.3"
        systemctl enable --now unified-agent.service
        systemctl is-active --quiet unified-agent.service
        systemctl enable markiro-runner.service
        printf '%s\n' 'MARKIRO_RUNNER_BOOTSTRAP_STAGE complete' > /dev/ttyS0
        touch /var/lib/markiro/markiro-runner-bootstrap-shutdown-pending
        touch /var/lib/markiro/markiro-runner-bootstrap-complete
power_state:
  delay: now
  mode: poweroff
  message: Runner bootstrap complete; controller may start the one-use JIT runner.
  timeout: 30
  condition: test -f /var/lib/markiro/markiro-runner-bootstrap-complete && test -f /var/lib/markiro/markiro-runner-bootstrap-shutdown-pending && rm -f /var/lib/markiro/markiro-runner-bootstrap-shutdown-pending
