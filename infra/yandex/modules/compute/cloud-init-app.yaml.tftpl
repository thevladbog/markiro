#cloud-config
package_update: true
packages:
  - ca-certificates
  - curl
  - iptables
  - xz-utils
groups:
  - docker
users:
  - name: markiro-deploy
    groups: [docker, sudo]
    lock_passwd: true
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    ssh_authorized_keys:
      - ${app_deploy_ssh_public_key}
write_files:
  - path: /etc/ssh/sshd_config.d/60-markiro-deploy.conf
    owner: root:root
    permissions: "0600"
    content: |
      PasswordAuthentication no
      KbdInteractiveAuthentication no
      ChallengeResponseAuthentication no
      PermitRootLogin no
      PubkeyAuthentication yes
      AuthenticationMethods publickey
      AllowUsers markiro-deploy
  - path: /usr/local/lib/markiro/install-container-runtime
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${container_installer_b64}
  - path: /usr/local/lib/markiro/container-runtime.mjs
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${container_runtime_script_b64}
  - path: /usr/local/lib/markiro/registry-auth.mjs
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${registry_auth_script_b64}
  - path: /usr/local/lib/markiro/runtime-env.mjs
    owner: root:root
    permissions: "0700"
    encoding: b64
    content: ${runtime_env_script_b64}
  - path: /usr/local/lib/markiro/cli-main.mjs
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${cli_main_script_b64}
  - path: /usr/local/lib/markiro/.env.production.example
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${environment_inventory_b64}
  - path: /etc/markiro/compose-contract.env
    owner: root:root
    permissions: "0600"
    encoding: b64
    content: ${compose_contract_env_b64}
  - path: /opt/markiro/compose.production.yml
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${production_compose_b64}
  - path: /etc/systemd/system/docker.service
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${docker_unit_b64}
  - path: /etc/systemd/system/markiro-runtime-env.service
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${runtime_env_unit_b64}
  - path: /etc/systemd/system/markiro-compose.service.d/runtime-env.conf
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${compose_runtime_dropin_b64}
  - path: /etc/systemd/system/markiro-deploy.service.d/runtime-env.conf
    owner: root:root
    permissions: "0644"
    encoding: b64
    content: ${deploy_runtime_dropin_b64}
  - path: /etc/markiro/runtime-secret-id
    owner: root:root
    permissions: "0600"
    content: |
      MARKIRO_RUNTIME_SECRET_ID=${runtime_secret_id}
runcmd:
  - - /usr/bin/bash
    - -ceu
    - |
        set -o pipefail
        if test -f /var/lib/markiro/markiro-app-bootstrap-complete; then
          exit 0
        fi

        test "$(dpkg-query -W -f='$${Status}\n' ca-certificates curl iptables xz-utils | grep -c '^install ok installed$')" -eq 4
        install -d -m 0755 /opt/markiro /usr/local/lib/markiro /var/lib/markiro
        install -d -m 0700 /etc/markiro /run/markiro-registry-auth
        chown root:root /etc/markiro /etc/markiro/runtime-secret-id
        chmod 0700 /etc/markiro
        chmod 0600 /etc/markiro/runtime-secret-id /etc/markiro/compose-contract.env

        install -d -m 0755 /run/sshd
        /usr/sbin/sshd -t
        systemctl restart ssh.service
        passwd -S markiro-deploy | awk '$2 == "L" { locked = 1 } END { exit locked ? 0 : 1 }'
        test "$(stat -c '%U:%G:%a' /home/markiro-deploy/.ssh)" = "markiro-deploy:markiro-deploy:700"
        test "$(stat -c '%U:%G:%a' /home/markiro-deploy/.ssh/authorized_keys)" = "markiro-deploy:markiro-deploy:600"

        /usr/local/lib/markiro/install-container-runtime

        NODE_VERSION=24.11.1
        NODE_ARCH=x64
        NODE_SHA256=60e3b0a8500819514aca603487c254298cd776de0698d3cd08f11dba5b8289a8
        test "$(uname -m)" = "x86_64"
        test "$(dpkg --print-architecture)" = "amd64"
        node_archive="node-v$${NODE_VERSION}-linux-$${NODE_ARCH}.tar.xz"
        node_root="/opt/markiro/node-v$${NODE_VERSION}-linux-$${NODE_ARCH}"
        node_workdir="$(mktemp -d)"
        trap 'rm -rf "$${node_workdir}"' EXIT
        curl --fail --location --proto '=https' --tlsv1.2 --output "$${node_workdir}/$${node_archive}" "https://nodejs.org/dist/v$${NODE_VERSION}/$${node_archive}"
        printf '%s  %s\n' "$${NODE_SHA256}" "$${node_workdir}/$${node_archive}" | sha256sum --check --status
        tar -xJf "$${node_workdir}/$${node_archive}" -C "$${node_workdir}"
        mv "$${node_workdir}/node-v$${NODE_VERSION}-linux-$${NODE_ARCH}" "$${node_root}"
        ln -sfn "$${node_root}/bin/node" /usr/bin/node
        test "$(/usr/bin/node --version)" = "v$${NODE_VERSION}"

        systemctl daemon-reload
        systemctl enable --now docker.service
        /usr/bin/node /usr/local/lib/markiro/container-runtime.mjs
        systemctl enable markiro-runtime-env.service

        touch /var/lib/markiro/markiro-app-bootstrap-complete
