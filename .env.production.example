# Release selectors do not belong in this API environment file. Export the
# 40-character MARKIRO_IMAGE_TAG plus MARKIRO_API_IMAGE_DIGEST and
# MARKIRO_EDGE_IMAGE_DIGEST from trusted GitHub Actions release evidence before
# preflight; production Compose selects exact repository digests, not SHA tags.
# Database connection supplied and rotated by the production database operator.
DATABASE_URL=
# Better Auth secret generated and rotated in the secret manager.
BETTER_AUTH_SECRET=
# Public Better Auth base URL supplied by the deployment owner.
BETTER_AUTH_URL=
# Cabinet origin supplied by the deployment owner.
ADMIN_ORIGIN=
# Independent platform-auth secret generated and rotated in the secret manager.
PLATFORM_AUTH_SECRET=
# Public API base URL used only by the platform Better Auth instance.
PLATFORM_AUTH_URL=
# Exact origin serving the separate SaaS administration application.
SAAS_ADMIN_ORIGIN=
SUBSCRIPTION_ENFORCEMENT_MODE=
# Optional kiosk origin supplied by the deployment owner.
KIOSK_ORIGIN=
# Exact origin used by the shipped Windows Tauri 2 station webview. Other
# platforms can use the non-opaque `tauri://localhost` custom-protocol origin,
# but that is not the deployed Windows value. Never set `null`.
STATION_ORIGIN=
# API origin embedded at station Vite build time. Required for fresh pairing;
# canonical HTTP(S) only, no path and no userinfo.
VITE_STATION_API_URL=
# Pairing-code pepper generated and rotated in the secret manager.
PAIRING_CODE_PEPPER=
# SMTP host supplied by the transactional email provider.
SMTP_HOST=
# SMTP port supplied by the transactional email provider.
SMTP_PORT=
# SMTP TLS mode supplied by the transactional email provider.
SMTP_SECURE=
# SMTP username supplied and rotated by the transactional email provider.
SMTP_USER=
# SMTP password supplied and rotated by the transactional email provider.
SMTP_PASSWORD=
# Sender email address approved by the transactional email provider.
SMTP_FROM_EMAIL=
# Sender display name supplied by the deployment owner.
SMTP_FROM_NAME=
# Reply-to address supplied by the deployment owner.
SMTP_REPLY_TO=
# Encryption keys generated and rotated in the secret manager.
MAIL_PAYLOAD_ENCRYPTION_KEY=
CHZ_TOKEN_ENCRYPTION_KEY=
CHZ_TRUE_API_TOKEN_FORMAT=
# Read-only National Catalog endpoint, source tenant, and known GTIN for protected
# diagnostics. Leave the required values blank to keep the integration disabled.
NATIONAL_CATALOG_BASE_URL=
NATIONAL_CATALOG_SCHEMA_SOURCE_TENANT_ID=
NATIONAL_CATALOG_LIVE_GTIN=
NATIONAL_CATALOG_REQUEST_TIMEOUT_MS=
# Duplicate Data Matrix rollout; disabled until printer/scanner acceptance.
VALIDATION_DM_DUPLICATE_ENABLED=

# Public landing demo submission inventory. The feature remains disabled while
# these entries are empty; provision recipients and the SmartCaptcha key from
# the deployment owner's secret/configuration stores before enabling it.
LANDING_DEMO_SUBMISSION_ENABLED=
LANDING_ORIGIN=
LANDING_DEMO_RECIPIENT=
LANDING_DEMO_REPLY_TO=
SMARTCAPTCHA_SERVER_KEY=
LANDING_DEMO_RATE_WINDOW_SECONDS=
LANDING_DEMO_SOURCE_LIMIT=
LANDING_DEMO_GLOBAL_LIMIT=
# Optional landing lead alerts and daily digest in Telegram. Leave the three
# LEAD_TELEGRAM_* entries out of the secret store to keep them disabled; they
# are provisioned together (enabled flag, bot token, chat id), and the API then
# needs outbound HTTPS to https://api.telegram.org. The bot token is a secret.
# LEAD_RETENTION_MONTHS (1..60, default 12) is how long idle or lost leads keep
# their contacts; omit it to use the default.
LEAD_TELEGRAM_ENABLED=
LEAD_TELEGRAM_BOT_TOKEN=
LEAD_TELEGRAM_CHAT_ID=
LEAD_RETENTION_MONTHS=
# Optional «Выпуски автонома»: keys to the public release bucket only
# (releases.markiro.app, prefix standalone/), never to the private bucket. The
# five RELEASES_S3_* entries are provisioned together or left out entirely; the
# endpoint is an exact origin and uploads are path-style PUTs from the admin's
# browser. RELEASES_PUBLIC_ORIGIN (default https://releases.markiro.app) is
# where latest.json links point; omit it to use the default.
RELEASES_S3_ENDPOINT=
RELEASES_S3_REGION=
RELEASES_S3_BUCKET=
RELEASES_S3_ACCESS_KEY_ID=
RELEASES_S3_SECRET_ACCESS_KEY=
RELEASES_PUBLIC_ORIGIN=
# S3 endpoint supplied by the production object-storage provider.
S3_ENDPOINT=
# S3 region supplied by the production object-storage provider.
S3_REGION=
# S3 bucket supplied by the production object-storage provider.
S3_BUCKET=
# S3 access key ID supplied and rotated by the object-storage provider.
S3_ACCESS_KEY_ID=
# S3 secret access key supplied and rotated by the object-storage provider.
S3_SECRET_ACCESS_KEY=
# S3 path-style setting supplied by the object-storage provider.
S3_FORCE_PATH_STYLE=
# Optional DaData credentials from the production secret manager. The API
# boots without them and exposes only an unconfigured integration status.
DADATA_TOKEN=
DADATA_SECRET=

# National Catalog import rollout (each flag defaults to false); stored history remains readable.
NATIONAL_CATALOG_OWN_IMPORT_ENABLED=
NATIONAL_CATALOG_GTIN_IMPORT_ENABLED=
NATIONAL_CATALOG_IMAGE_IMPORT_ENABLED=
# Explicit verified CDN hostnames, comma separated; empty disables new image downloads.
NATIONAL_CATALOG_IMAGE_ALLOWED_HOSTS=
# Confirmed-link provider refresh requires the explicit validated NATIONAL_CATALOG_BASE_URL.
# Removing that URL stops new provider refresh work independently of import rollout flags.

# Optional offline grant protocol. Leave ALL unset until an approved signing rollout.
# Configure all four together. Pre-distribute new public keys before switching KID.
# ORIGIN must be this API's canonical HTTP(S) origin; never a request-body value.
# PRIVATE_KEY_PEM is a server-only P-256 PKCS8 secret; do not put it in client bundles.
OFFLINE_GRANT_ORIGIN=
OFFLINE_GRANT_KID=
OFFLINE_GRANT_PRIVATE_KEY_PEM=
# JSON {protocol,origin,revision,keys:[{kid,jwk}],retiredKids:[]} with public keys only.
OFFLINE_GRANT_KEYSET_JSON=

# Optional standalone («Markiro Автоном») offline license signing — its OWN P-256 key,
# never an offline grant key. Leave ALL unset until the owner's rollout: issuance then
# answers 409 and the API keeps running. Configure all four together.
# ISSUER is this API's canonical HTTP(S) origin; the standalone build trusts it with the
# public keys (apps/standalone/proto/fixtures/trust-keys.json). Ship a build with a new
# public key before switching KID. PRIVATE_KEY_PEM is server-only PKCS8; one-line `\n`
# escapes are accepted.
STANDALONE_LICENSE_ISSUER=
STANDALONE_LICENSE_KID=
STANDALONE_LICENSE_PRIVATE_KEY_PEM=
# JSON {protocol:"standalone-license-v1",origin,revision,keys:[{kid,jwk}],retiredKids:[]}, public keys only.
STANDALONE_LICENSE_KEYSET_JSON=
# Optional standalone («Markiro Автоном») support diagnostics: the PRIVATE keys that open the
# tokens `MKS1.<kid>.<body>` of «Сведения для поддержки». Leave unset until the owner's rollout:
# the API keeps running and the diagnostics tab answers «not configured» on paste. One JSON line,
# an array [{"kid":"sup-…","pem":"-----BEGIN EC PRIVATE KEY-----\n…"}] (SEC1 or PKCS8 PEM; the
# newlines as JSON `\n`). A second entry is a rotation. Its own key: never a license or grant key.
STANDALONE_SUPPORT_KEYS_JSON=

# Explicitly provision pgboss_platform before enabling; false preserves automatic
# schema creation for existing installations. Only platform-only jobs use this.
# PLATFORM_PGBOSS_PREPROVISIONED_SCHEMA=false

# Immutable release catalog: leave ALL empty until protected import/recovery and rollout.
# Separate GetObjectVersion/ledger-only credential. Never use publisher or backup keys.
RELEASE_CATALOG_S3_ENDPOINT=
RELEASE_CATALOG_S3_REGION=
RELEASE_CATALOG_S3_BUCKET=
RELEASE_CATALOG_S3_ACCESS_KEY_ID=
RELEASE_CATALOG_S3_SECRET_ACCESS_KEY=
# Private dedicated mounts and explicit capacity; one API process per mount.
RELEASE_CATALOG_CACHE_DIR=
RELEASE_CATALOG_JOURNAL_DIR=
RELEASE_CATALOG_CACHE_BYTES=
RELEASE_CATALOG_OBJECT_BYTES=
RELEASE_CATALOG_DISK_RESERVE_BYTES=
RELEASE_CATALOG_DOWNLOADS=
RELEASE_CATALOG_TIMEOUT_MS=
# Exact reviewed GitHub immutable repo/owner IDs and workflow SHA/environment pins (JSON).
RELEASE_CATALOG_PUBLISHERS_JSON=
