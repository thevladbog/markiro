{
  "name": "@markiro/db",
  "version": "0.1.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./organization-access": {
      "types": "./dist/organization-access.d.ts",
      "default": "./dist/organization-access.js"
    },
    "./runtime-migrate": {
      "types": "./dist/runtime-migrate.d.ts",
      "default": "./dist/runtime-migrate.js"
    },
    "./station-sqlite": {
      "types": "./dist/station-sqlite.d.ts",
      "default": "./dist/station-sqlite.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:runtime": "node dist/migrate-cli.js",
    "db:generate:sqlite": "drizzle-kit generate --config drizzle.sqlite.config.ts"
  },
  "dependencies": {
    "@better-auth/api-key": "1.6.23",
    "better-auth": "1.6.23",
    "drizzle-orm": "0.45.2",
    "pg": "8.22.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/pg": "8.20.0",
    "drizzle-kit": "0.31.10",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
