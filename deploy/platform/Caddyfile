	import common_headers
	import application_csp
	import saas_admin_routes
}

https://{$MARKIRO_LANDING_DOMAIN}:8443 {
	import common_headers
	import landing_csp
	import landing_routes
}

http://{$MARKIRO_RETIRED_ADMIN_DOMAIN}:8080 {
	import common_headers
	import application_csp
	import retired_routes
}

https://{$MARKIRO_RETIRED_ADMIN_DOMAIN}:8443 {
	import common_headers
