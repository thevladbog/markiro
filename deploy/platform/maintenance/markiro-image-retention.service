[Unit]
Description=Markiro verified Docker image retention
After=docker.service network-online.target
ConditionPathExists=/opt/markiro-platform/state/upgrade-index.json

[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/markiro-platform/maintenance/image_retention.py --apply
TimeoutStartSec=15min
Nice=10
NoNewPrivileges=yes
PrivateTmp=yes
UMask=0077
