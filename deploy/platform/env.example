# Preparation inventory only. Never use these placeholders as credentials.
# Copy to an explicit absolute path owned by the runner/operator, mode 0600.
# Syntax is KEY=literal-value (Compose env_file format: raw). No quotes, exports,
# interpolation, duplicate keys or multiline values. Do not source this file.
SERVER_PROFILE=platform-only
VITE_SERVER_PROFILE=platform-only
MARKIRO_SOURCE_SHA=
MARKIRO_TOOLING_SHA=
MARKIRO_API_IMAGE_DIGEST=
MARKIRO_PLATFORM_EDGE_IMAGE_DIGEST=
MARKIRO_SAAS_ADMIN_DOMAIN=saas-admin.markiro.app
MARKIRO_LANDING_DOMAIN=markiro.app
MARKIRO_RETIRED_ADMIN_DOMAIN=admin.markiro.app
MARKIRO_RETIRED_KIOSK_DOMAIN=kiosk.markiro.app
SAAS_ADMIN_ORIGIN=https://saas-admin.markiro.app
PLATFORM_AUTH_URL=https://saas-admin.markiro.app
LANDING_ORIGIN=https://markiro.app
ACME_EMAIL=
# Private PostgreSQL address; verify-full and the explicit CA must be
# proven in the isolated restore gate. For compact local PG use db.private and
# sslmode=verify-full&sslrootcert=/run/markiro-postgres/ca.crt (URL-encode credentials).
DATABASE_URL=
PLATFORM_AUTH_SECRET=
# Preserve this key exactly for existing encrypted mail; do not regenerate.
MAIL_PAYLOAD_ENCRYPTION_KEY=
# Private bucket; endpoint is an exact HTTPS origin. Set a separately reviewed
# exact presigned origin for img-src (no wildcard, path or CSP fragment).
# Path-style requires the endpoint origin; virtual-host style prefixes the bucket.
S3_ENDPOINT=
S3_PUBLIC_ORIGIN=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# markiro.app mail already resides at Timeweb: verify existing SMTP, no MX edit.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Маркиро
# Optional SMTP_REPLY_TO
LANDING_DEMO_SUBMISSION_ENABLED=false
# If enabled, also provide LANDING_DEMO_RECIPIENT, LANDING_DEMO_REPLY_TO and
# SMARTCAPTCHA_SERVER_KEY. Build matching PUBLIC_DEMO_SUBMISSION_ENABLED and
# PUBLIC_SMARTCAPTCHA_CLIENT_KEY into the platform edge; keys are not interchangeable.
SUPPORT_CHAT_ENABLED=false
# Optional transcript import only: SUPPORT_CHATWOOT_BASE_URL (exact HTTPS
# origin), SUPPORT_CHATWOOT_ACCOUNT_ID, SUPPORT_CHATWOOT_INBOX_ID,
# SUPPORT_CHATWOOT_API_TOKEN. CRM provisioning/sizing remains deferred.
# Restore existing issuer/key identity before license operations:
# STANDALONE_LICENSE_ISSUER, STANDALONE_LICENSE_KID,
# STANDALONE_LICENSE_PRIVATE_KEY_PEM, STANDALONE_LICENSE_KEYSET_JSON,
# STANDALONE_SUPPORT_KEYS_JSON; also preserve CHZ_TOKEN_ENCRYPTION_KEY when
# retained encrypted records need it. Escaped JSON is one literal line.
# Set all four license values together: ISSUER, KID, PRIVATE_KEY_PEM, KEYSET_JSON.
# PRIVATE_KEY_PEM is a separate literal single-line value with \n separators:
# STANDALONE_LICENSE_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nTEST-ONLY-PLACEHOLDER\n-----END PRIVATE KEY-----
# KEYSET_JSON contains public JWK keys only, never the private PEM.

# Optional compact composition only: compose.yml + compose.compact.yml.
# Approved official PG17 digest, including sha256: prefix, for the target architecture.
# These bind-source paths must be absolute existing files outside the repository.
# No certificate/private-key generation or secret defaults are supplied here.
# PostgreSQL's server certificate SAN must include db.private.
# CA/server cert readable by runtime users; server key root:70 mode 0640 or
# 70:70 mode 0600; bootstrap password file readable by uid/gid 70 only.
MARKIRO_POSTGRES_IMAGE_DIGEST=
MARKIRO_POSTGRES_CA_FILE=
MARKIRO_POSTGRES_SERVER_CERT_FILE=
MARKIRO_POSTGRES_SERVER_KEY_FILE=
MARKIRO_POSTGRES_PASSWORD_FILE=
