# Preparation inventory only. Never use these placeholders as credentials.
# Copy to an explicit absolute path owned by the runner/operator, mode 0600.
# Syntax is KEY=literal-value (Compose env_file format: raw). No quotes, exports,
# interpolation, duplicate keys or multiline values. Do not source this file.
SERVER_PROFILE=platform-only
VITE_SERVER_PROFILE=platform-only
MARKIRO_SOURCE_SHA=
MARKIRO_TOOLING_SHA=
MARKIRO_API_IMAGE_DIGEST=
MARKIRO_PLATFORM_EDGE_IMAGE_DIGEST=
MARKIRO_SAAS_ADMIN_DOMAIN=saas-admin.markiro.app
MARKIRO_LANDING_DOMAIN=markiro.app
MARKIRO_RETIRED_ADMIN_DOMAIN=admin.markiro.app
MARKIRO_RETIRED_KIOSK_DOMAIN=kiosk.markiro.app
# releases.markiro.app: the edge proxies GET/HEAD of the published release
# layouts (station/, signer/, handheld/, standalone/) to this Timeweb S3 bucket,
# path-style on https://s3.twcstorage.ru, and refuses everything else. The edge
# reads anonymously and holds no key: the bucket allows public reads of those
# prefixes (never listings). Never the private S3_BUCKET.
MARKIRO_RELEASES_DOMAIN=releases.markiro.app
MARKIRO_RELEASES_BUCKET=
SAAS_ADMIN_ORIGIN=https://saas-admin.markiro.app
PLATFORM_AUTH_URL=https://saas-admin.markiro.app
LANDING_ORIGIN=https://markiro.app
ACME_EMAIL=
# Private PostgreSQL address; verify-full and the explicit CA must be
# proven in the isolated restore gate. For compact local PG use db.private and
# sslmode=verify-full&sslrootcert=/run/markiro-postgres/ca.crt (URL-encode credentials).
DATABASE_URL=
PLATFORM_AUTH_SECRET=
# Preserve this key exactly for existing encrypted mail; do not regenerate.
MAIL_PAYLOAD_ENCRYPTION_KEY=
# Private bucket; endpoint is an exact HTTPS origin. Set a separately reviewed
# exact presigned origin for img-src (no wildcard, path or CSP fragment).
# Path-style requires the endpoint origin; virtual-host style prefixes the bucket.
S3_ENDPOINT=
S3_PUBLIC_ORIGIN=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Timeweb mailbox is provisioned; verify authoritative DNS and SMTP readiness separately.
# Preparation never changes DNS or MX automatically.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Маркиро
# Optional SMTP_REPLY_TO
LANDING_DEMO_SUBMISSION_ENABLED=false
# If enabled, also provide LANDING_DEMO_RECIPIENT and LANDING_DEMO_REPLY_TO.
# Build matching PUBLIC_DEMO_SUBMISSION_ENABLED into the platform edge.
# Download and invoice forms do not require SmartCaptcha keys.
# Landing lead alerts and the daily digest in Telegram (optional). Leads and
# their e-mails work without it and readiness never depends on Telegram. When
# enabled, provide LEAD_TELEGRAM_BOT_TOKEN (secret, <bot id>:<key>) and
# LEAD_TELEGRAM_CHAT_ID (numeric id or @channel); the API container then needs
# outbound HTTPS to https://api.telegram.org. LEAD_RETENTION_MONTHS (1..60,
# default 12) is how long idle or lost leads keep their contacts.
LEAD_TELEGRAM_ENABLED=false
# Optional LEAD_TELEGRAM_BOT_TOKEN, LEAD_TELEGRAM_CHAT_ID, LEAD_RETENTION_MONTHS
# «Выпуски автонома» (optional; readiness never depends on it): keys to the
# public release bucket only, all five together or none. RELEASES_S3_ENDPOINT
# must be https://s3.twcstorage.ru (RELEASES_S3_REGION=ru-1), the upload origin
# the admin CSP allows (path-style PUTs from the browser), and RELEASES_S3_BUCKET
# must equal MARKIRO_RELEASES_BUCKET; the bucket needs CORS for PUT from
# SAAS_ADMIN_ORIGIN. RELEASES_PUBLIC_ORIGIN defaults to https://releases.markiro.app
# and must be https://MARKIRO_RELEASES_DOMAIN.
# Optional RELEASES_S3_ENDPOINT, RELEASES_S3_REGION, RELEASES_S3_BUCKET,
# RELEASES_S3_ACCESS_KEY_ID, RELEASES_S3_SECRET_ACCESS_KEY, RELEASES_PUBLIC_ORIGIN
SUPPORT_CHAT_ENABLED=false
# Optional transcript import only: SUPPORT_CHATWOOT_BASE_URL (exact HTTPS
# origin), SUPPORT_CHATWOOT_ACCOUNT_ID, SUPPORT_CHATWOOT_INBOX_ID,
# SUPPORT_CHATWOOT_API_TOKEN. CRM provisioning/sizing remains deferred.
# Restore existing issuer/key identity before license operations:
# STANDALONE_LICENSE_ISSUER, STANDALONE_LICENSE_KID,
# STANDALONE_LICENSE_PRIVATE_KEY_PEM, STANDALONE_LICENSE_KEYSET_JSON,
# STANDALONE_SUPPORT_KEYS_JSON; also preserve CHZ_TOKEN_ENCRYPTION_KEY when
# retained encrypted records need it. Escaped JSON is one literal line.
# Set all four license values together: ISSUER, KID, PRIVATE_KEY_PEM, KEYSET_JSON.
# PRIVATE_KEY_PEM is a separate literal single-line value with \n separators:
# STANDALONE_LICENSE_PRIVATE_KEY_PEM=-----BEGIN PRIVATE KEY-----\nTEST-ONLY-PLACEHOLDER\n-----END PRIVATE KEY-----
# KEYSET_JSON contains public JWK keys only, never the private PEM.

# Optional compact composition only: compose.yml + compose.compact.yml.
# Approved official PG17 digest, including sha256: prefix, for the target architecture.
# These bind-source paths must be absolute existing files outside the repository.
# No certificate/private-key generation or secret defaults are supplied here.
# PostgreSQL's server certificate SAN must include db.private.
# CA/server cert readable by runtime users; server key root:70 mode 0640 or
# 70:70 mode 0600; bootstrap password file readable by uid/gid 70 only.
MARKIRO_POSTGRES_IMAGE_DIGEST=
MARKIRO_POSTGRES_CA_FILE=
MARKIRO_POSTGRES_SERVER_CERT_FILE=
MARKIRO_POSTGRES_SERVER_KEY_FILE=
MARKIRO_POSTGRES_PASSWORD_FILE=

# Supply the migration input separately: one DATABASE_URL line only, using
# markiro_migrator and the same database/host/CA/verify-full TLS as markiro_app.
# snapshotMigrationConfig publishes candidates/<uuid>/migration.env; pass its
# validated path as MARKIRO_PLATFORM_MIGRATION_ENV_FILE in Compose interpolation.
# Provision roles explicitly with postgres/roles.mjs before migrations/startup.
# The app has business DML and owns only pgboss_platform for queue-local DDL.

# Compact/CI overlays set this to true after explicit queue-schema provisioning.
# Optional for the portable base topology; default false preserves old behavior.
# PLATFORM_PGBOSS_PREPROVISIONED_SCHEMA=false

# Immutable catalog. Provision both host directories explicitly as uid/gid1000,
# mode0700; one API process owns the mounts. Protected deployment selects
# compose.catalog.yml only for complete configuration; absent catalog has no binds.
# Empty configuration fails closed.
# Capacity values must be measured for the accepted artifact set before rollout.
# Bootstrap with writers=false; enable only after reviewed import/recovery proof.
RELEASE_CATALOG_S3_ENDPOINT=
RELEASE_CATALOG_S3_REGION=
RELEASE_CATALOG_S3_BUCKET=
RELEASE_CATALOG_S3_ACCESS_KEY_ID=
RELEASE_CATALOG_S3_SECRET_ACCESS_KEY=
RELEASE_CATALOG_CACHE_DIR=
RELEASE_CATALOG_JOURNAL_DIR=
RELEASE_CATALOG_CACHE_BYTES=
RELEASE_CATALOG_OBJECT_BYTES=
RELEASE_CATALOG_DISK_RESERVE_BYTES=
RELEASE_CATALOG_DOWNLOADS=
RELEASE_CATALOG_TIMEOUT_MS=
RELEASE_CATALOG_WRITERS_ENABLED=
RELEASE_CATALOG_PUBLISHERS_JSON=
