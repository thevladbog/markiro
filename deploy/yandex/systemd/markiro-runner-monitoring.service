[Unit]
Description=Markiro runner runtime metric producer
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
UMask=0077
EnvironmentFile=/etc/markiro/monitoring.conf
ExecStart=/usr/bin/node /usr/local/lib/markiro/monitoring-producer.mjs runner
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/proc/uptime
