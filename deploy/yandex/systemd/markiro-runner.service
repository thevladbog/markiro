[Unit]
Description=Markiro one-use GitHub Actions deployment runner
Wants=network-online.target docker.service
After=network-online.target docker.service
Before=shutdown.target

[Service]
Type=simple
User=markiro-runner
Group=markiro-runner
SupplementaryGroups=docker
UMask=0077
RuntimeDirectory=markiro-runner
RuntimeDirectoryMode=0700
Environment=GITHUB_REPOSITORY=thevladbog/q
Environment=GITHUB_RUNNER_GROUP_ID=1
ExecStart=/usr/local/lib/markiro/runner-jit
ExecStopPost=+/usr/sbin/poweroff
Restart=no
TimeoutStartSec=45min
TimeoutStopSec=2min
KillMode=mixed

[Install]
WantedBy=multi-user.target
