{
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	auto_https disable_redirects
}

(standard_api_transport) {
	transport http {
		response_header_timeout 30s
		read_timeout 60s
		write_timeout 60s
	}
}

(commerce_ml_transport) {
	transport http {
		response_header_timeout 5m
		read_timeout 5m
		write_timeout 5m
	}
}

(common_headers) {
	encode zstd gzip

	header {
		defer
		-Server
		X-Markiro-Release-Sha "{$MARKIRO_RELEASE_SHA}"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
	}
}

(application_csp) {
	header {
		defer
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob: https://storage.yandexcloud.net; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'"
	}
}

(landing_csp) {
	header {
		defer
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' https://smartcaptcha.cloud.yandex.ru; frame-src 'self' https://smartcaptcha.cloud.yandex.ru; connect-src 'self' https://smartcaptcha.cloud.yandex.ru; worker-src 'self' blob:; manifest-src 'self'"
	}
}

(vbtech_headers) {
	encode zstd gzip

	header {
		defer
		-Server
		X-Vbtech-Release-Sha "{env.VBTECH_RELEASE_SHA}"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), geolocation=(), microphone=(), payment=(), usb=()"
		Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; frame-src https://smartcaptcha.cloud.yandex.ru; img-src 'self' data:; object-src 'none'; script-src 'self' 'unsafe-inline' https://smartcaptcha.cloud.yandex.ru; style-src 'self' 'unsafe-inline'; upgrade-insecure-requests"
	}
}

(vbtech_routes) {
	route {
		@vbtechContact {
			method POST
			path /api/contact
			vars {env.VBTECH_SUBMISSION_STATE} enabled
		}
		handle @vbtechContact {
			request_body {
				max_size 16KB
			}
			rewrite * {env.VBTECH_FUNCTION_PATH}
			reverse_proxy https://functions.yandexcloud.net {
				import standard_api_transport
			}
		}

		@vbtechReserved path /api /api/*
		handle @vbtechReserved {
			respond 404
		}

		reverse_proxy vbtech-web:8080 {
			import standard_api_transport
		}
	}
}

(admin_routes) {
	root * /srv/admin
	route {
		@adminDemo path /api/demo-requests
		handle @adminDemo {
			respond 404
		}

		@apiAuth path /api/auth/*
		handle @apiAuth {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		handle_path /api/* {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@commerceMl path /1c_exchange
		handle @commerceMl {
			reverse_proxy api:3000 {
				import commerce_ml_transport
			}
		}

		@device path /station/* /kiosk/* /health /health/* /openapi.json /docs /docs/*
		handle @device {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@stationRoot {
			path /shifts /shifts/box-label-templates /products /products/gtin-check
			header X-Api-Key *
		}
		handle @stationRoot {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@stationRootPreflight {
			path /shifts /shifts/box-label-templates /products /products/gtin-check
			method OPTIONS
		}
		handle @stationRootPreflight {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@stationShift {
			path_regexp stationShift ^/shifts/[^/]+/(open|bundle|reference-bundle)$
			header X-Api-Key *
		}
		handle @stationShift {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@stationShiftPreflight {
			path_regexp stationShiftPreflight ^/shifts/[^/]+/(open|bundle|reference-bundle)$
			method OPTIONS
		}
		handle @stationShiftPreflight {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@assets path /assets/*
		handle @assets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@spa method GET HEAD
		handle @spa {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}

		respond 404
	}
}

(saas_admin_routes) {
	root * /srv/saas-admin
	route {
		@platformAuth path /api/platform-auth/*
		handle @platformAuth {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@platformApi path /api/platform/*
		handle @platformApi {
			uri strip_prefix /api
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@platformReserved path /api /api/* /1c_exchange /station /station/* /kiosk /kiosk/* /health* /openapi.json /docs*
		handle @platformReserved {
			respond 404
		}

		@saasAdminAssets path /assets/*
		handle @saasAdminAssets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@saasAdminSpa method GET HEAD
		handle @saasAdminSpa {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}

		respond 404
	}
}

(kiosk_routes) {
	root * /srv/kiosk
	route {
		@kioskApi path /api/kiosk/*
		handle @kioskApi {
			uri strip_prefix /api
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@kioskReserved path /api /api/auth/* /api/* /1c_exchange /station /station/* /kiosk /kiosk/* /health* /openapi.json /docs*
		handle @kioskReserved {
			respond 404
		}

		@kioskAssets path /assets/*
		handle @kioskAssets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@kioskSpa method GET HEAD
		handle @kioskSpa {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}

		respond 404
	}
}

(landing_routes) {
	root * /srv/landing
	route {
		@landingDemo {
			method POST
			path /api/demo-requests
		}
		handle @landingDemo {
			request_body {
				max_size 4KB
			}
			uri strip_prefix /api
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@landingReserved path /api /api/* /1c_exchange /station /station/* /kiosk /kiosk/* /health* /openapi.json /docs*
		handle @landingReserved {
			respond 404
		}

		@landingAssets {
			path /assets/*
			method GET HEAD
		}
		handle @landingAssets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@landingPolicy {
			path /robots.txt /sitemap.xml /llms.txt
			method GET HEAD
		}
		handle @landingPolicy {
			header Cache-Control "public, max-age=300"
			file_server
		}

		@legacyLegalPd01 {
			method GET HEAD
			path_regexp legacyLegalPd01 ^/d/MKR-PD-01/2026\.08\.01/2026-08-15$
		}
		handle @legacyLegalPd01 {
			redir * /d/MKR-PD-01/2026.08/01/15.08.2026 308
		}

		@legacyLegalPd02 {
			method GET HEAD
			path_regexp legacyLegalPd02 ^/d/MKR-PD-02/2026\.08\.01/2026-08-15$
		}
		handle @legacyLegalPd02 {
			redir * /d/MKR-PD-02/2026.08/01/15.08.2026 308
		}

		@legacyLegalDpa01 {
			method GET HEAD
			path_regexp legacyLegalDpa01 ^/d/MKR-DPA-01/2026\.08\.01/2026-08-15$
		}
		handle @legacyLegalDpa01 {
			redir * /d/MKR-DPA-01/2026.08/01/15.08.2026 308
		}

		@legacyLegalBrd01 {
			method GET HEAD
			path_regexp legacyLegalBrd01 ^/d/MKR-BRD-01/2026\.08\.01/2026-08-15$
		}
		handle @legacyLegalBrd01 {
			redir * /d/MKR-BRD-01/2026.08/01/15.08.2026 308
		}

		@landingDocument {
			file {path} {path}/index.html
			method GET HEAD
		}
		handle @landingDocument {
			header Cache-Control "no-cache"
			try_files {path} {path}/index.html
			file_server
		}

		@landingMissing method GET HEAD
		handle @landingMissing {
			header Cache-Control "no-cache"
			rewrite * /404.html
			file_server {
				status 404
			}
		}

		respond 404
	}
}

