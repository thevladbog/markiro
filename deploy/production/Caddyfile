{
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	auto_https disable_redirects
}

(standard_api_transport) {
	transport http {
		response_header_timeout 30s
		read_timeout 60s
		write_timeout 60s
	}
}

(commerce_ml_transport) {
	transport http {
		response_header_timeout 5m
		read_timeout 5m
		write_timeout 5m
	}
}

(common_headers) {
	encode zstd gzip

	header {
		defer
		-Server
		X-Markiro-Release-Sha "{$MARKIRO_RELEASE_SHA}"
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'"
	}
}

(admin_routes) {
	root * /srv/admin
	route {
		@apiAuth path /api/auth/*
		handle @apiAuth {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		handle_path /api/* {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@commerceMl path /1c_exchange
		handle @commerceMl {
			reverse_proxy api:3000 {
				import commerce_ml_transport
			}
		}

		@device path /station/* /kiosk/* /health /health/* /openapi.json /docs /docs/*
		handle @device {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@stationRoot {
			path /shifts /products /products/gtin-check
			header X-Api-Key *
		}
		handle @stationRoot {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@stationRootPreflight {
			path /shifts /products /products/gtin-check
			method OPTIONS
		}
		handle @stationRootPreflight {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@stationShift {
			path_regexp stationShift ^/shifts/[^/]+/(open|bundle|reference-bundle)$
			header X-Api-Key *
		}
		handle @stationShift {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@stationShiftPreflight {
			path_regexp stationShiftPreflight ^/shifts/[^/]+/(open|bundle|reference-bundle)$
			method OPTIONS
		}
		handle @stationShiftPreflight {
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@assets path /assets/*
		handle @assets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@spa method GET HEAD
		handle @spa {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}

		respond 404
	}
}

(kiosk_routes) {
	root * /srv/kiosk
	route {
		@kioskApi path /api/kiosk/*
		handle @kioskApi {
			uri strip_prefix /api
			reverse_proxy api:3000 {
				import standard_api_transport
			}
		}

		@kioskReserved path /api /api/auth/* /api/* /1c_exchange /station /station/* /kiosk /kiosk/* /health* /openapi.json /docs*
		handle @kioskReserved {
			respond 404
		}

		@kioskAssets path /assets/*
		handle @kioskAssets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@kioskSpa method GET HEAD
		handle @kioskSpa {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}

		respond 404
	}
}

(landing_routes) {
	root * /srv/landing
	route {
		@landingReserved path /api /api/* /1c_exchange /station /station/* /kiosk /kiosk/* /health* /openapi.json /docs*
		handle @landingReserved {
			respond 404
		}

		@landingAssets {
			path /assets/*
			method GET HEAD
		}
		handle @landingAssets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@landingPolicy {
			path /robots.txt /sitemap.xml /llms.txt
			method GET HEAD
		}
		handle @landingPolicy {
			header Cache-Control "public, max-age=300"
			file_server
		}

		@landingDocument method GET HEAD
		handle @landingDocument {
			header Cache-Control "no-cache"
			try_files {path} {path}/index.html
			file_server
		}

		respond 404
	}
}

http://{$MARKIRO_DOMAIN}:8080 {
	redir https://{$MARKIRO_DOMAIN}{uri} permanent
}

http://{$MARKIRO_KIOSK_DOMAIN}:8080 {
	redir https://{$MARKIRO_KIOSK_DOMAIN}{uri} permanent
}

http://{$MARKIRO_LANDING_DOMAIN}:8080 {
	redir https://{$MARKIRO_LANDING_DOMAIN}{uri} permanent
}

https://{$MARKIRO_DOMAIN}:8443 {
	import common_headers
	import admin_routes
}

https://{$MARKIRO_KIOSK_DOMAIN}:8443 {
	import common_headers
	import kiosk_routes
}

https://{$MARKIRO_LANDING_DOMAIN}:8443 {
	import common_headers
	import landing_routes
}
