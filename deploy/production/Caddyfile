{
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	auto_https disable_redirects
}

http://{$MARKIRO_DOMAIN}:8080 {
	redir https://{$MARKIRO_DOMAIN}{uri} permanent
}

https://{$MARKIRO_DOMAIN}:8443 {
	encode zstd gzip
	root * /srv

	header {
		-Server
		Strict-Transport-Security "max-age=63072000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'self'; form-action 'self'; img-src 'self' data: blob:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; worker-src 'self' blob:; manifest-src 'self'"
	}

	route {
		@apiAuth path /api/auth/*
		handle @apiAuth {
			reverse_proxy api:3000
		}

		handle_path /api/* {
			reverse_proxy api:3000
		}

		@device path /station/* /kiosk/* /1c_exchange /health* /openapi.json /docs*
		handle @device {
			reverse_proxy api:3000
		}

		@assets path /assets/*
		handle @assets {
			header Cache-Control "public, max-age=31536000, immutable"
			file_server
		}

		@spa method GET HEAD
		handle @spa {
			header Cache-Control "no-cache"
			try_files {path} /index.html
			file_server
		}

		respond 404
	}
}
