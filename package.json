{
  "name": "markiro",
  "private": true,
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test:yandex-runtime": "node --test deploy/yandex/test/*.test.mjs",
    "test:station-release:contract": "node --test tools/station-release/test/*.test.mjs",
    "verify:station-production-cors": "node tools/station-release/verify-api-cors.mjs https://admin.markiro.app",
    "test:yandex-runbooks:contract": "node --test infra/yandex/test/runbook-contract.test.mjs",
    "test:production-bundle:contract": "node --test deploy/production/test/*.test.mjs",
    "test:production-docs:browser": "pnpm --dir tools/production-browser --ignore-workspace test",
    "test:yandex-infra:contract": "node --test infra/yandex/test/*.test.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.7.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.7.0",
    "js-yaml": "5.2.2",
    "prettier": "3.9.5",
    "turbo": "2.10.4",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0"
  }
}
