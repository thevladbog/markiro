{
  "name": "markiro",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:deps": "node tools/check-no-major-bumps.mjs",
    "test:dependency-guard": "node --test tools/test/*.test.mjs",
    "test:ci-policy": "node --test tools/ci/test/*.test.mjs",
    "test:yandex-runtime": "node --test deploy/yandex/test/*.test.mjs",
    "test:station-release:contract": "node --test tools/station-release/test/*.test.mjs",
    "test:signer-release:contract": "node --test tools/signer-release/test/*.test.mjs",
    "verify:station-production-cors": "node tools/station-release/verify-api-cors.mjs https://admin.markiro.app",
    "test:yandex-runbooks:contract": "node --test infra/yandex/test/runbook-contract.test.mjs",
    "test:production-bundle:contract": "node --test deploy/production/test/*.test.mjs",
    "test:production-docs:browser": "pnpm --dir tools/production-browser --ignore-workspace test",
    "test:station-inventory:browser": "pnpm --dir tools/production-browser --ignore-workspace test:station-inventory",
    "test:inventory:browser": "pnpm --dir tools/production-browser --ignore-workspace test:inventory",
    "test:landing:browser": "pnpm --dir tools/production-browser --ignore-workspace test:landing",
    "test:landing:lighthouse": "pnpm --dir tools/production-browser --ignore-workspace test:landing:lighthouse",
    "test:yandex-infra:contract": "node --test infra/yandex/test/*.test.mjs",
    "evidence:init": "node tools/evidence-package/init.mjs",
    "evidence:seal": "node tools/evidence-package/seal.mjs",
    "evidence:station-date": "node tools/evidence-package/station-date.mjs",
    "evidence:verify": "node tools/evidence-package/verify.mjs",
    "test:evidence-package": "node --test tools/evidence-package/test/*.test.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "3.1114.0",
    "@eslint/js": "10.0.1",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.11.0",
    "js-yaml": "5.2.2",
    "prettier": "3.9.6",
    "turbo": "2.10.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0"
  }
}
