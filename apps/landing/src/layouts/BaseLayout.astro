---
import "@markiro/ui/styles.css";
import "../styles/landing.css";

import { getUiCopy } from "../content/ui";
import {
  attachOrganizationContact,
  mirrorPathFor,
  serializeJsonLd,
  type PageGraph,
  type PageMetadata,
} from "../lib/seo";
import { findHubPage, hubPath } from "../content/hubs";
import { readPublicSiteConfig } from "../lib/site-config";
import { socialImageDimensions } from "../lib/social-image";
import ConsentPanel from "../components/ConsentPanel.astro";

interface Props {
  metadata: PageMetadata;
  graph: PageGraph;
  noindex?: boolean;
}

const { metadata: page, graph, noindex = false } = Astro.props;
const canonicalUrl = new URL(page.path, Astro.site);
const socialImageUrl = new URL(page.socialImage, Astro.site);
const socialImageSize = socialImageDimensions(page.socialImage);
const alternateUrl =
  page.alternatePath === undefined || page.alternatePath === page.path
    ? null
    : new URL(page.alternatePath, Astro.site);
const ruUrl = page.locale === "ru" ? canonicalUrl : alternateUrl;
const enUrl = page.locale === "en" ? canonicalUrl : alternateUrl;
const copy = getUiCopy(page.locale).common;
const publicPhone = readPublicSiteConfig({ PUBLIC_PHONE: import.meta.env.PUBLIC_PHONE }).phone;
const feedHub = findHubPage(hubPath(page.locale, "articles"));
const feedPath = `${feedHub.path}rss.xml`;
const markdownPath = noindex ? null : mirrorPathFor(page.path);
const jsonLd = serializeJsonLd(
  attachOrganizationContact(graph, { telephone: publicPhone?.display ?? null }),
);
---

<!doctype html>
<html lang={page.locale} data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={page.description} />
    <meta name="robots" content={noindex ? "noindex,follow" : "index,follow,max-image-preview:large,max-snippet:-1,max-video-preview:-1"} />
    <meta name="theme-color" content="#131216" />
    <meta property="og:type" content={page.ogType ?? "website"} />
    {page.publishedAt && <meta property="article:published_time" content={page.publishedAt} />}
    {page.modifiedAt && <meta property="article:modified_time" content={page.modifiedAt} />}
    <meta property="og:locale" content={page.locale === "ru" ? "ru_RU" : "en_US"} />
    {alternateUrl && <meta property="og:locale:alternate" content={page.locale === "ru" ? "en_US" : "ru_RU"} />}
    <meta property="og:site_name" content="Markiro" />
    <meta property="og:title" content={page.title} />
    <meta property="og:description" content={page.description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={socialImageUrl} />
    {socialImageSize && <meta property="og:image:width" content={String(socialImageSize.width)} />}
    {socialImageSize && <meta property="og:image:height" content={String(socialImageSize.height)} />}
    <meta property="og:image:alt" content={page.socialImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={page.title} />
    <meta name="twitter:description" content={page.description} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={page.socialImageAlt} />
    <link rel="canonical" href={canonicalUrl} />
    {ruUrl && enUrl && (
      <>
        <link rel="alternate" hreflang="ru" href={ruUrl} />
        <link rel="alternate" hreflang="en" href={enUrl} />
        <link rel="alternate" hreflang="x-default" href={ruUrl} />
      </>
    )}
    <link rel="alternate" type="application/rss+xml" title={feedHub.title} href={feedPath} />
    {markdownPath && <link rel="alternate" type="text/markdown" href={markdownPath} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href={page.locale === "ru" ? "/site.webmanifest" : "/site.en.webmanifest"} />
    <title>{page.title}</title>
    <script type="application/ld+json" set:html={jsonLd} is:inline />
  </head>
  <body>
    <a class="skip-link" href="#main">{copy.skipLink}</a>
    <ConsentPanel locale={page.locale} />
    <slot />
    <script>
      import { GTM_CONTAINER_ID, initConsentPanel, initTagManager } from "../scripts/tracking";

      initConsentPanel(document, window);
      initTagManager(document, window, GTM_CONTAINER_ID);
    </script>
  </body>
</html>
