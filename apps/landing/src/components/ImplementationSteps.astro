---
const steps = [
  ["01", "Разбираем линию", "Фиксируем оборудование, роли и текущий маршрут кодов."],
  ["02", "Настраиваем сценарий", "Собираем рабочий процесс под конкретный продукт и упаковку."],
  ["03", "Проверяем на смене", "Запускаем вместе с оператором и проверяем восстановление после ошибок."],
  ["04", "Расширяем контур", "Добавляем кабинеты, киоски и интеграции по готовности."],
] as const;
---

<section class="section section--implementation" id="implementation" aria-labelledby="implementation-title">
  <div class="container implementation-grid">
    <div data-reveal>
      <p class="section-index">06 / ВНЕДРЕНИЕ</p>
      <h2 id="implementation-title" class="display-heading display-heading--sentence">Запускаем без большого проекта.</h2>
      <p class="section-lead">Начните с одной станции и реального рабочего сценария. Масштабирование идёт после проверки процесса на линии.</p>
      <a class="text-link" href="#demo">Обсудить первую линию <span aria-hidden="true">→</span></a>
    </div>
    <ol class="implementation-steps" data-reveal-group>
      {steps.map(([number, title, description]) => (
        <li data-reveal><span>{number}</span><div><h3>{title}</h3><p>{description}</p></div></li>
      ))}
    </ol>
  </div>
</section>
