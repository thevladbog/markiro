---
import type { Locale } from "../content/pages";
import { getUiCopy } from "../content/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = getUiCopy(locale).home.implementation;
---

<section class="section section--implementation" id="implementation" aria-labelledby="implementation-title">
  <div class="container implementation-grid">
    <div data-reveal>
      <p class="section-index">{copy.kicker}</p>
      <h2 id="implementation-title" class="display-heading display-heading--sentence">{copy.heading}</h2>
      <p class="section-lead">{copy.lead}</p>
      <a class="text-link" href="#demo">{copy.link} <span aria-hidden="true">→</span></a>
    </div>
    <ol class="implementation-steps" data-reveal-group>
      {copy.steps.map(([title, description], index) => (
        <li data-reveal><span>{String(index + 1).padStart(2, "0")}</span><div><h3>{title}</h3><p>{description}</p></div></li>
      ))}
    </ol>
  </div>
</section>
