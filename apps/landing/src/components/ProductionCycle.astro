---
import LineConsole from "./LineConsole.astro";
import type { Locale } from "../content/pages";
import { getUiCopy } from "../content/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = getUiCopy(locale).home.cycle;
---

<section class="section section--cycle" id="cycle" aria-labelledby="cycle-title">
  <div class="container">
    <p class="section-index">{copy.kicker}</p>
    <h2 id="cycle-title" class="display-heading display-heading--wide">{copy.heading[0]}<br />{copy.heading[1]}</h2>
    <p class="section-lead">{copy.lead}</p>

    <div class="cycle-grid">
      <ol class="process-list" data-reveal-group>
        {copy.stages.map(([title, description], index) => (
          <li data-reveal>
            <span>{String(index + 1).padStart(2, "0")}</span>
            <div><h3>{title}</h3><p>{description}</p></div>
          </li>
        ))}
      </ol>
      <div class="cycle-console" data-reveal>
        <LineConsole locale={locale} compact inverse />
      </div>
    </div>
  </div>
</section>
