---
import type { PublicLegalLinks, PublicPhone } from "../lib/site-config";

interface Props {
  demoEndpoint: string | null;
  legalLinks: PublicLegalLinks | null;
  phone: PublicPhone | null;
}

const { demoEndpoint, legalLinks, phone } = Astro.props;
---

<section class="section section--demo" id="demo" aria-labelledby="demo-title">
  <div class="container demo-grid">
    <div data-reveal>
      <p class="section-index">07 / ДЕМО НА ВАШЕЙ ЛИНИИ</p>
      <h2 id="demo-title" class="display-heading display-heading--sentence">Покажем Markiro на вашей линии.</h2>
      <p class="section-lead">Разберём ваш процесс и покажем рабочий сценарий без абстрактной презентации.</p>
      {phone ? (
        <a class="demo-phone" href={phone.href} data-analytics="landing_phone_click" data-placement="demo">{phone.display}</a>
      ) : (
        <p class="contact-note">Контактный телефон появится после подключения публичной линии.</p>
      )}
    </div>

    <form class="demo-form" data-demo-form data-endpoint={demoEndpoint ?? undefined} novalidate data-reveal>
      <div class="form-field">
        <label for="name">Как к вам обращаться</label>
        <input id="name" name="name" type="text" autocomplete="name" maxlength="80" required />
        <span class="field-error" id="name-error"></span>
      </div>
      <div class="form-field">
        <label for="company">Компания</label>
        <input id="company" name="company" type="text" autocomplete="organization" maxlength="120" required />
        <span class="field-error" id="company-error"></span>
      </div>
      <div class="form-field">
        <label for="phone">Телефон для связи</label>
        <input id="phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="30" placeholder="+7 999 123-45-67" required />
        <span class="field-error" id="phone-error"></span>
      </div>
      <button class="button demo-form__submit" type="submit" data-analytics="landing_form_submit">
        <span>Запросить демонстрацию</span><span aria-hidden="true">→</span>
      </button>
      <p class="form-status" data-form-status aria-live="polite"></p>
      {legalLinks ? (
        <p class="form-legal">
          Отправляя форму, вы принимаете <a href={legalLinks.consent}>согласие на обработку персональных данных</a>
          и подтверждаете, что ознакомились с <a href={legalLinks.privacy}>политикой обработки данных</a>.
        </p>
      ) : (
        <p class="form-legal">Онлайн-отправка будет доступна после подключения CRM и утверждения документов об обработке данных.</p>
      )}
    </form>
  </div>
</section>
