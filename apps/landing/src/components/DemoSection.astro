---
import type { PublicLegalLinks, PublicPhone } from "../lib/site-config";
import type { Locale } from "../content/pages";
import { getUiCopy } from "../content/ui";

interface Props {
  captchaClientKey: string | null;
  consentVersion: string | null;
  demoEndpoint: string | null;
  legalLinks: PublicLegalLinks | null;
  locale: Locale;
  phone: PublicPhone | null;
  sourcePath: string;
}

const {
  captchaClientKey,
  consentVersion,
  demoEndpoint,
  legalLinks,
  locale,
  phone,
  sourcePath,
} = Astro.props;
const rootCopy = getUiCopy(locale);
const copy = rootCopy.home.demo;
const submissionEnabled =
  demoEndpoint !== null &&
  legalLinks !== null &&
  captchaClientKey !== null &&
  consentVersion !== null;
---

<section class="section section--demo" id="demo" aria-labelledby="demo-title">
  <div class="container demo-grid">
    <div data-reveal>
      <p class="section-index">{copy.kicker}</p>
      <h2 id="demo-title" class="display-heading display-heading--sentence">{copy.heading}</h2>
      <p class="section-lead">{copy.lead}</p>
      {phone ? (
        <a class="demo-phone" href={phone.href} data-analytics="landing_phone_click" data-placement="demo">{phone.display}</a>
      ) : (
        <p class="contact-note">{copy.contactNote}</p>
      )}
    </div>

    <form
      class="demo-form"
      data-demo-form
      data-locale={locale}
      data-endpoint={submissionEnabled ? demoEndpoint : undefined}
      data-consent-version={submissionEnabled ? consentVersion : undefined}
      data-source-path={sourcePath}
      novalidate
      data-reveal
    >
      <div class="form-field">
        <label for="name">{copy.name}</label>
        <input id="name" name="name" type="text" autocomplete="name" maxlength="80" required />
        <span class="field-error" id="name-error"></span>
      </div>
      <div class="form-field">
        <label for="company">{copy.company}</label>
        <input id="company" name="company" type="text" autocomplete="organization" maxlength="120" required />
        <span class="field-error" id="company-error"></span>
      </div>
      <div class="form-field">
        <label for="email">{copy.email}</label>
        <input
          id="email"
          name="email"
          type="email"
          autocomplete="email"
          maxlength="254"
          required
        />
        <span class="field-error" id="email-error"></span>
      </div>
      <div class="form-field">
        <label for="phone">{copy.phone}</label>
        <input
          id="phone"
          name="phone"
          type="tel"
          autocomplete="tel"
          inputmode="tel"
          maxlength="30"
          placeholder={locale === "ru" ? "+7 999 123-45-67" : "+1 202 555 0114"}
        />
        <span class="field-error" id="phone-error"></span>
      </div>
      {submissionEnabled && (
        <>
          <div class="demo-form__honeypot" aria-hidden="true">
            <label for="website">Website</label>
            <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
          </div>
          <div class="demo-form__consent">
            <input id="consent" name="consent" type="checkbox" required />
            <label for="consent">
              {copy.legal.prefix} <a href={legalLinks.consent}>{copy.legal.consent}</a>
              {copy.legal.separator} <a href={legalLinks.privacy}>{copy.legal.privacy}</a>.
            </label>
            <span class="field-error" id="consent-error" data-consent-error></span>
          </div>
          <div class="demo-form__captcha">
            <div class="smart-captcha" data-sitekey={captchaClientKey}></div>
            <p class="field-error" id="captcha-error" data-captcha-error tabindex="-1"></p>
          </div>
        </>
      )}
      <button class="button demo-form__submit" type="submit" data-analytics="landing_form_submit">
        <span>{rootCopy.common.requestDemo}</span><span aria-hidden="true">→</span>
      </button>
      <p class="form-status" data-form-status aria-live="polite"></p>
      {!submissionEnabled && (
        <p class="form-legal">{copy.unavailable}</p>
      )}
    </form>
  </div>
  {submissionEnabled && (
    <script is:inline src="https://smartcaptcha.cloud.yandex.ru/captcha.js" defer></script>
  )}
</section>
