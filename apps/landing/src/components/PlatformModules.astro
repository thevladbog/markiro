---
import type { Locale } from "../content/pages";
import { getUiCopy } from "../content/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = getUiCopy(locale).home.platform;
---

<section class="section section--platform" id="platform" aria-labelledby="platform-title">
  <div class="container">
    <p class="section-index">{copy.kicker}</p>
    <h2 id="platform-title" class="display-heading display-heading--sentence">{copy.heading[0]}<br />{copy.heading[1]}</h2>
    <p class="section-lead">{copy.lead}</p>

    <div class="module-grid" data-reveal-group>
      {copy.modules.map(([title, description], index) => (
        <article class="module-card" data-reveal>
          <span class="module-card__number">{String(index + 1).padStart(2, "0")}</span>
          <span class="module-icon" aria-hidden="true"></span>
          <h3>{title}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
