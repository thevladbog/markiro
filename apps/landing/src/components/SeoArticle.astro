---
import { formatLegalEffectiveDate } from "@markiro/legal-documents";

import type { PublicPhone } from "../lib/site-config";
import type { SeoPageDefinition } from "../content/pages";
import { getUiCopy } from "../content/ui";
import { buildPageGraph } from "../lib/seo";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "./Breadcrumbs.astro";
import LandingFooter from "./LandingFooter.astro";
import LandingHeader from "./LandingHeader.astro";
import RelatedPages from "./RelatedPages.astro";

interface Props {
  page: SeoPageDefinition;
  phone: PublicPhone | null;
}

const { page, phone } = Astro.props;
const copy = getUiCopy(page.locale).common;
const homePath = page.locale === "ru" ? "/" : "/en/";
const stationDownloadUrl = "https://releases.markiro.app/station/download";
---

<BaseLayout metadata={page} graph={buildPageGraph(page)}>
  <LandingHeader page={page} phone={phone} />
  <main id="main" class="seo-page">
    <header class="seo-hero">
      <div class="container seo-hero__inner">
        <Breadcrumbs locale={page.locale} current={page.navigationLabel} />
        <p class="section-index">{page.eyebrow}</p>
        <h1>{page.heading}</h1>
        <p class="seo-hero__lead">{page.introduction}</p>
        <a class="button" href={`${homePath}#demo`} data-analytics="landing_demo_click" data-placement="seo-hero">
          {copy.discussTask} <span aria-hidden="true">→</span>
        </a>
        <p class="seo-hero__reviewed">
          {copy.reviewedLabel}: <time datetime={page.reviewedAt} data-reviewed-at>{formatLegalEffectiveDate(page.reviewedAt, page.locale)}</time>
        </p>
      </div>
    </header>

    <article class="container seo-article">
      {page.summary.length > 0 && (
        <aside class="article-summary seo-summary" data-page-summary aria-labelledby="page-summary-title">
          <p class="section-index">{copy.summaryKicker}</p>
          <h2 id="page-summary-title">{copy.summaryHeading}</h2>
          <ul>
            {page.summary.map((item) => <li>{item}</li>)}
          </ul>
        </aside>
      )}

      {page.sections.map((section, index) => (
        <section aria-labelledby={`section-${index}`}>
          <p class="section-index">{String(index + 1).padStart(2, "0")}</p>
          <h2 id={`section-${index}`}>{section.heading}</h2>
          {section.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          {section.bullets && <ul>{section.bullets.map((bullet) => <li>{bullet}</li>)}</ul>}
        </section>
      ))}

      {page.faq && (
        <div class="faq-list" data-faq-list>
          <p class="section-index faq-list__kicker">{copy.faqKicker}</p>
          {page.faq.map((entry) => (
            <section data-faq-item>
              <h2>{entry.question}</h2>
              <p>{entry.answer}</p>
            </section>
          ))}
        </div>
      )}

      {page.stationDownload && (
        <section class="seo-download" data-station-download aria-labelledby="station-download-title">
          <p class="section-index">{page.stationDownload.eyebrow}</p>
          <div class="seo-download__content">
            <h2 id="station-download-title">{page.stationDownload.title}</h2>
            <p>{page.stationDownload.description}</p>
            <div class="seo-download__actions">
              <a
                class="button"
                href={stationDownloadUrl}
                data-analytics="station_download_click"
                data-placement="workstation-page"
              >
                {page.stationDownload.actionLabel} <span aria-hidden="true">↓</span>
              </a>
              <span>{page.stationDownload.meta}</span>
            </div>
          </div>
        </section>
      )}

      <RelatedPages page={page} />
    </article>

    <section class="seo-cta" aria-labelledby="seo-cta-title">
      <div class="container seo-cta__inner">
        <div>
          <p class="section-index">{copy.seoCtaKicker}</p>
          <h2 id="seo-cta-title">{copy.seoCtaHeading}</h2>
        </div>
        <div class="seo-cta__actions">
          <a class="button" href={`${homePath}#demo`} data-analytics="landing_demo_click" data-placement="seo-cta">{copy.requestDemo} <span aria-hidden="true">→</span></a>
          {phone && (
            <a class="seo-cta__phone" href={phone.href} data-analytics="landing_phone_click" data-placement="seo-cta">{phone.display}</a>
          )}
        </div>
      </div>
    </section>
  </main>
  <LandingFooter page={page} />

  <script>
    import { browserLandingRuntime, initLanding } from "../scripts/site";

    initLanding(document, browserLandingRuntime(window));
  </script>
</BaseLayout>
