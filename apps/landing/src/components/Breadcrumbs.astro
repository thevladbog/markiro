---
import type { Locale } from "../content/pages";
import { getUiCopy } from "../content/ui";

export interface Crumb {
  label: string;
  path: string;
}

interface Props {
  locale: Locale;
  current: string;
  trail?: readonly Crumb[];
}

const { locale, current, trail = [] } = Astro.props;
const copy = getUiCopy(locale).common;
const homePath = locale === "ru" ? "/" : "/en/";
---

<nav class="breadcrumbs" aria-label={copy.breadcrumbsLabel}>
  <ol>
    <li><a href={homePath}>Markiro</a></li>
    {trail.map((crumb) => <li><a href={crumb.path}>{crumb.label}</a></li>)}
    <li aria-current="page">{current}</li>
  </ol>
</nav>
