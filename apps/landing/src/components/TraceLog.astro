---
import type { Locale } from "../content/pages";
import { getUiCopy } from "../content/ui";

interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = getUiCopy(locale).home.trace;
---

<section class="section section--trace" id="traceability" aria-labelledby="trace-title">
  <div class="container trace-layout">
    <div class="trace-copy" data-reveal>
      <p class="section-index">{copy.kicker}</p>
      <h2 id="trace-title" class="display-heading display-heading--sentence">{copy.heading[0]}<br />{copy.heading[1]}</h2>
      <p class="section-lead">{copy.lead}</p>
      <ul class="compact-benefits">
        {copy.benefits.map((benefit) => <li>{benefit}</li>)}
      </ul>
    </div>

    <div class="trace-panel" aria-label={copy.panelLabel} data-reveal>
      <div class="scene-toolbar"><span>{copy.toolbar}</span><span>{copy.station}</span></div>
      <ol class="trace-events">
        {copy.events.map(([time, title, description, status]) => (
          <li class:list={{ "trace-event--problem": status === "problem" }}>
            <time datetime={`2026-08-14T${time}+03:00`}>{time}</time>
            <i aria-hidden="true"></i>
            <div><strong>{title}</strong><span>{description}</span></div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>
