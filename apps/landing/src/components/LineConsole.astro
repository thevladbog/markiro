---
import type { Locale } from "../content/pages";
import { getUiCopy } from "../content/ui";

interface Props {
  compact?: boolean;
  inverse?: boolean;
  locale: Locale;
}

const { compact = false, inverse = false, locale } = Astro.props;
const copy = getUiCopy(locale).home.lineConsole;
---

<div class:list={["line-console", { "line-console--compact": compact, "line-console--inverse": inverse }]} aria-hidden="true">
  <div class="line-console__topline">
    <span>{copy.station}</span>
    <span class="status-inline"><i></i> {copy.lineActive}</span>
  </div>
  <div class="line-console__body">
    <div class="line-console__primary">
      <span class="interface-kicker">{copy.assembly}</span>
      <strong>{copy.caseAssembly}</strong>
      <div class="line-console__count"><b>18</b><span>/ 24</span></div>
      <div class="progress-track"><i></i></div>
    </div>
    <div class="line-console__secondary">
      <span class="interface-kicker">{copy.shiftAccepted}</span>
      <strong>1 248</strong>
      <small>{copy.codes}</small>
    </div>
  </div>
  <div class="line-console__footer">
    <span>{copy.accepted}</span>
    <b>52.40 {copy.timeUnit}</b>
  </div>
</div>
