---
import type { SeoPageDefinition } from "../content/pages";
import { findSeoPage } from "../content/pages";
import { findArticlePage } from "../content/articles";
import { getUiCopy } from "../content/ui";

interface Props {
  page: SeoPageDefinition;
}

const { page } = Astro.props;
const relatedPages = page.relatedPaths.map(findSeoPage);
const relatedArticles = page.relatedArticlePaths.map(findArticlePage);
const copy = getUiCopy(page.locale).common;
---

<section class="seo-related" aria-labelledby="related-title" data-related-pages>
  <p class="section-index">{copy.relatedKicker}</p>
  <h2 id="related-title">{copy.relatedHeading}</h2>
  <div class="seo-related__grid">
    {relatedPages.map((relatedPage) => (
      <a href={relatedPage.path}>
        <span>{relatedPage.navigationLabel}</span>
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>

{relatedArticles.length > 0 && (
  <section class="seo-related seo-related--articles" aria-labelledby="related-articles-title" data-related-articles>
    <p class="section-index">{copy.relatedArticlesKicker}</p>
    <h2 id="related-articles-title">{copy.relatedArticlesHeading}</h2>
    <div class="seo-related__grid">
      {relatedArticles.map((article) => (
        <a href={article.path}>
          <span>{article.navigationLabel}</span>
          <span aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
)}
