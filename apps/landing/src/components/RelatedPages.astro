---
import type { SeoPageDefinition } from "../content/pages";
import { findSeoPage } from "../content/pages";
import { BEER_CASE_AGGREGATION_ARTICLE } from "../content/articles";
import { getUiCopy } from "../content/ui";

interface Props {
  page: SeoPageDefinition;
}

const { page } = Astro.props;
const relatedPages = page.relatedPaths.map(findSeoPage);
const relatedLinks: Array<{ navigationLabel: string; path: string }> = relatedPages.map(
  ({ navigationLabel, path }) => ({ navigationLabel, path }),
);
if (page.path === "/sscc-i-agregatsiya/") {
  relatedLinks.push({
    navigationLabel: BEER_CASE_AGGREGATION_ARTICLE.navigationLabel,
    path: BEER_CASE_AGGREGATION_ARTICLE.path,
  });
}
const copy = getUiCopy(page.locale).common;
---

<section class="seo-related" aria-labelledby="related-title" data-related-pages>
  <p class="section-index">{copy.relatedKicker}</p>
  <h2 id="related-title">{copy.relatedHeading}</h2>
  <div class="seo-related__grid">
    {relatedLinks.map((relatedPage) => (
      <a href={relatedPage.path}>
        <span>{relatedPage.navigationLabel}</span>
        <span aria-hidden="true">→</span>
      </a>
    ))}
  </div>
</section>
