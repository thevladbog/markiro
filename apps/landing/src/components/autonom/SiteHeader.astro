---
import { DOWNLOAD_PATH, SITE_NAV } from "../../content/autonom";
import { SITE_CONTACTS } from "../../content/contacts";
import type { PublicPhone } from "../../lib/site-config";
import BrandMark from "../BrandMark.astro";
import Icon from "./Icon.astro";

interface Props {
  path: string;
  phone: PublicPhone | null;
}

const { path, phone } = Astro.props;
const themes = [
  { choice: "system", label: "Системная", icon: "monitor" },
  { choice: "light", label: "Светлая", icon: "sun" },
  { choice: "dark", label: "Тёмная", icon: "moon" },
] as const;
---

<header class="ax-header" data-header>
  <div class="ax-header__bar">
    <a class="ax-header__brand" href="/" aria-label="Маркиро, на главную страницу">
      <BrandMark locale="ru" />
    </a>

    <nav class="ax-nav" aria-label="Разделы сайта">
      {SITE_NAV.map((item) => (
        <a href={item.href} aria-current={item.href === path ? "page" : undefined}>{item.label}</a>
      ))}
    </nav>

    <div class="ax-header__actions">
      <div class="ax-theme">
        <button
          class="ax-icon-button ax-theme__toggle"
          type="button"
          aria-controls="ax-theme-menu"
          aria-expanded="false"
          aria-label="Тема оформления"
          data-theme-toggle
        >
          <Icon name="moon" class="ax-theme__icon ax-theme__icon--moon" />
          <Icon name="sun" class="ax-theme__icon ax-theme__icon--sun" />
        </button>
        <div class="ax-theme__menu" id="ax-theme-menu" role="group" aria-label="Тема оформления" hidden>
          {themes.map((theme) => (
            <button type="button" class="ax-theme__option" data-theme-option={theme.choice} aria-pressed="false">
              <Icon name={theme.icon} size={16} />
              {theme.label}
            </button>
          ))}
        </div>
      </div>
      {phone && (
        <a class="ax-header__phone" href={phone.href} data-analytics="landing_phone_click" data-placement="header">
          {phone.display}
        </a>
      )}
      <a class="ax-btn ax-btn--accent ax-btn--sm ax-header__cta" href={DOWNLOAD_PATH} data-analytics="landing_download_click" data-placement="header">
        <span>Скачать пробную версию</span>
        <span class="ax-btn__icon"><Icon name="download" size={18} /></span>
      </a>
      {phone && (
        <a class="ax-icon-button ax-header__call" href={phone.href} aria-label={`Позвонить: ${phone.display}`} data-analytics="landing_phone_click" data-placement="header_mobile">
          <Icon name="phone" />
        </a>
      )}
      <button
        class="ax-icon-button ax-icon-button--inverse ax-header__menu-trigger"
        type="button"
        aria-controls="ax-menu"
        aria-expanded="false"
        aria-label="Открыть меню"
        data-menu-open-label="Открыть меню"
        data-menu-close-label="Закрыть меню"
        data-menu-trigger
      >
        <Icon name="menu" class="ax-menu-icon ax-menu-icon--open" />
        <Icon name="close" class="ax-menu-icon ax-menu-icon--close" />
      </button>
    </div>
  </div>

  <div class="ax-menu" id="ax-menu" data-menu>
    <nav class="ax-menu__nav" aria-label="Разделы сайта">
      {SITE_NAV.map((item) => (
        <a href={item.href} aria-current={item.href === path ? "page" : undefined}>
          {item.label}
          <Icon name="arrow-right" />
        </a>
      ))}
    </nav>
    <div class="ax-menu__theme">
      <span class="ax-menu__theme-label" id="ax-menu-theme-label">Тема</span>
      <div class="ax-segmented" role="group" aria-labelledby="ax-menu-theme-label">
        {themes.map((theme) => (
          <button type="button" data-theme-option={theme.choice} aria-pressed="false">
            <Icon name={theme.icon} size={16} />
            {theme.label}
          </button>
        ))}
      </div>
    </div>
    <div class="ax-menu__actions">
      <div class="ax-menu__contacts">
        {phone && (
          <a class="ax-btn ax-btn--outline" href={phone.href} data-analytics="landing_phone_click" data-placement="menu">
            <Icon name="phone" size={18} />
            <span>Позвонить</span>
          </a>
        )}
        <a class="ax-btn ax-btn--outline" href={SITE_CONTACTS.telegram.href}>
          <Icon name="send" size={18} />
          <span>Telegram</span>
        </a>
      </div>
      <a class="ax-btn ax-btn--accent ax-btn--block" href={DOWNLOAD_PATH} data-analytics="landing_download_click" data-placement="menu">
        <span>Прислать ссылку на почту</span>
        <span class="ax-btn__icon"><Icon name="mail" size={18} /></span>
      </a>
    </div>
  </div>
</header>
