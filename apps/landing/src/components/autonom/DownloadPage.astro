---
import { findLegalRelease } from "@markiro/legal-documents";
import { DOWNLOAD_COPY } from "../../content/autonom";
import { findAutonomPage } from "../../content/autonom-pages";
import { SITE_CONTACTS } from "../../content/contacts";
import { buildAutonomPageGraph } from "../../lib/seo";
import { readPublicSiteConfig } from "../../lib/site-config";
import AutonomPage from "./AutonomPage.astro";
import Icon from "./Icon.astro";
import LeadConsent from "./LeadConsent.astro";
import LeadSubmit from "./LeadSubmit.astro";

const page = findAutonomPage("/skachat/");
const config = readPublicSiteConfig(
  {
    PUBLIC_DEMO_SUBMISSION_ENABLED: import.meta.env.PUBLIC_DEMO_SUBMISSION_ENABLED,
    PUBLIC_PHONE: import.meta.env.PUBLIC_PHONE,
  },
  "ru",
);
const enabled =
  config.leadEndpoint !== null &&
  config.legalLinks !== null &&
  config.consentVersion !== null;
const copy = DOWNLOAD_COPY;
---

<AutonomPage metadata={page} graph={buildAutonomPageGraph(page)} phone={config.phone} footer="short">
  <section class="v4-section v4-download" aria-labelledby="download-title" data-download-start>
    <div class="ax-container v4-download__grid">
      <header class="v4-download__intro v4-stack">
        <nav class="ax-note" aria-label="Хлебные крошки">
          <a href="/">Главная</a> / Скачать</nav>
        <h1 id="download-title">{copy.title}</h1>
        <p>Все функции доступны <a href={findLegalRelease("MKR-LIC-01").routes.ru}>14 дней</a>. Оплачивать заранее не нужно.</p>
        <p class="v4-eyebrow">Windows 10 / 11 · x64</p>
      </header>
      <div class="ax-form-card v4-download__form">        <form
        class="ax-form"
        id="lead-form"
        data-lead-form
        data-intent="download"
        data-endpoint={enabled ? config.leadEndpoint : undefined}
        data-consent-version={enabled ? config.consentVersion : undefined}
        novalidate
        >
        <input type="hidden" name="tariffCode" data-download-tariff/>
        <p class="ax-note" data-selected-tariff hidden>
        </p>
        <h2 class="ax-h3 ax-form__title">{copy.form.title}</h2>
        <fieldset class="ax-form__fields" data-lead-fields disabled={!enabled}>
          <div class="ax-field">
            <label for="download-email">{copy.form.email}</label>
            <input id="download-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" placeholder={copy.form.emailPlaceholder} required />
            <p class="ax-field__error" id="download-email-error" data-error-for="email">
            </p>
          </div>
          <div class="ax-field">
            <label for="download-company">{copy.form.company}</label>
            <input id="download-company" name="company" type="text" autocomplete="organization" maxlength="120" placeholder={copy.form.companyPlaceholder} required />
            <p class="ax-field__error" id="download-company-error" data-error-for="company">
            </p>
          </div>
          <p class="ax-form__hint">{copy.form.later}</p>
          {enabled && config.legalLinks && (
          <LeadConsent idPrefix="download" legalLinks={config.legalLinks} />
          )}
          <LeadSubmit label={copy.form.submit} labelNarrow={copy.form.submitPhone} icon="arrow-right" iconNarrow="mail" />
        </fieldset>
        <p class="ax-form__status" data-form-status aria-live="polite">
        </p>
        {enabled ? (
        <p class="ax-form__note">
          <span class="ax-only-wide">{copy.form.note}</span>
          <span class="ax-only-narrow">{copy.form.notePhone}</span>
        </p>
        ) : (
        <p class="ax-form__note">
          Отправка формы пока не подключена. Напишите на <a href={`mailto:${SITE_CONTACTS.email}`}>{SITE_CONTACTS.email}</a>,
          пришлём ссылку на установщик.
        </p>
        )}
      </form>
    </div>
    <div class="v4-download__requirements">
      <details open class="v4-details">
        <summary>
          <h2>Системные требования</h2>
        </summary>
        <ul>{copy.requirements.map(requirement=>
          <li>{requirement}</li>)}</ul>
      </details>
      <details class="v4-details">
        <summary>
          <h2>Что входит в установщик</h2>
        </summary>
        <p>Один установщик для главного ПК, станции и офиса. При установке выберите роль компьютера.</p>
        <ul>{copy.inside.map(item=>
          <li>
            <strong>{item.title}</strong> — {item.text}</li>)}</ul>
        <p>ТСД: проверка кодов, сборка коробов и паллет, печать этикеток — как на станции. Приложение Android устанавливается отдельно.</p>
      </details>
      <dl class="ax-meta" data-release-fact hidden>
        <div data-release-fact hidden>
          <dt>Версия</dt>
          <dd data-release="version">
          </dd>
        </div>
        <div data-release-fact hidden>
          <dt>Выпущена</dt>
          <dd data-release="date">
          </dd>
        </div>
        <div data-release-fact hidden>
          <dt>Размер</dt>
          <dd data-release="size">
          </dd>
        </div>
      </dl>
    </div>
  </div>
</section>
<section class="v4-section v4-download-ready" aria-label="Установщик" data-download-ready hidden>
  <div class="ax-container v4-stack v4-stack--wide">
    <div data-loading-only hidden role="status">
      <h2 tabindex="-1" data-ready-heading>Заявка принята. Проверяем установщик</h2>
      <p data-loading-copy>Читаем сведения о текущем релизе. Повторно отправлять форму не нужно.</p>
    </div>
    <div data-release-only hidden class="v4-stack">
      <h2 class="v4-result-title" tabindex="-1" data-ready-heading>
        <span class="ax-only-wide">{copy.ready.title}</span>
        <span class="ax-only-narrow">{copy.ready.titlePhone}</span>
      </h2>
      <p data-accepted-only>Заявка принята. Письмо для <strong data-ready-email>
        </strong> поставлено в очередь отправки. На телефоне: откройте полученное письмо на ПК с Windows.</p>
      <div class="v4-release-card v4-stack">
        <h2 data-release="file">
        </h2>
        <p>Версия <span data-release="version">
          </span> · <span data-release="date">
          </span> · <span data-release="size">
          </span> · Windows 10/11 x64</p>
        <a class="ax-btn ax-btn--accent" href="#" data-release-link data-analytics="landing_installer_download" data-placement="ready">Скачать установщик <Icon name="download" size={18}/>
        </a>
        <button type="button" class="ax-btn ax-btn--outline" data-copy="link" data-copied-label="Ссылка скопирована">Скопировать ссылку</button>
        <details class="v4-details">
          <summary>Проверить SHA-256</summary>
          <code class="v4-hash" data-release="sha256">
          </code>
          <button type="button" class="ax-btn ax-btn--outline" data-copy="sha256" data-copied-label="SHA-256 скопирован">Скопировать SHA-256</button>
          <p>В PowerShell в папке с установщиком:</p>
          <code class="v4-hash" data-release="command">
          </code>
          <button type="button" class="ax-btn ax-btn--outline" data-copy="command" data-copied-label="Команда скопирована">Скопировать команду</button>
        </details>
      </div>
      <details class="v4-details">
        <summary>Перед первым запуском Windows</summary>
        <p>Сверьте SHA-256 скачанного файла с контрольной суммой релиза. Если Windows сообщает о неизвестном издателе, сначала проверьте файл и источник загрузки. Если сведения не совпадают или остаются сомнения, остановите запуск и напишите на hello@markiro.app.</p>
        <a href="/instruktsii/ustanovka-i-pervyy-zapusk/">Инструкция по установке</a>
      </details>
    </div>
    <div data-pending-only hidden class="v4-stack">
      <h2 class="v4-result-title" tabindex="-1" data-ready-heading>{copy.ready.pendingTitle}</h2>
      <p data-accepted-only>Заявка для <strong data-ready-email>
        </strong> принята. Повторите проверку релиза или напишите нам. Повторно отправлять форму не нужно.</p>
      <button type="button" class="ax-btn ax-btn--accent" data-release-retry>Проверить ещё раз</button>
      <a href="mailto:hello@markiro.app">hello@markiro.app</a>
    </div>
<p data-email-only hidden>Установщик для Windows 10/11 x64. Пробный период 14 дней со всеми функциями. Если релиз недоступен, повторите проверку или напишите на hello@markiro.app.</p>
<div data-accepted-only class="v4-stack"><button type="button" class="ax-btn ax-btn--outline" data-resend-link disabled>Повторить письмо через 60 с</button><p data-followup-status aria-live="polite"></p><button type="button" class="ax-link" data-change-email>Изменить почту</button></div>
    <p aria-live="polite" data-copy-status>
    </p>
  </div>
</section>
<section class="v4-section" data-download-after hidden>
  <div class="ax-container">
    <h2>Что дальше</h2>
    <p>Установите программу на главный ПК, пройдите мастер и проведите пробную смену со своими кодами. Подключите дополнительные станции или ТСД по локальной сети.</p>
    <a class="ax-link" href="/instruktsii/">Инструкции оператора и офиса <Icon name="arrow-up-right" size={16}/>
    </a>
  </div>
</section>
<script>
      import { initDownloadFollowup } from "../../scripts/download-followup";
    import { initDownloadPage } from "../../scripts/download-page";
      import { browserLeadFormRuntime, fetchLatestRelease, initLeadForm } from "../../scripts/lead-form";
      import { tariffFromSearch } from "../../scripts/invoice";
      import { findTariff, type TariffCode } from "../../content/pricing";
      const downloadPage = initDownloadPage(document, {fetchRelease:()=>fetchLatestRelease(window),copy:text=>navigator.clipboard.writeText(text)});
      const form = document.querySelector<HTMLFormElement>('[data-lead-form]');
      const selected = tariffFromSearch(window.location.search);
      const field = document.querySelector<HTMLInputElement>('[data-download-tariff]');
      const label = document.querySelector<HTMLElement>('[data-selected-tariff]');
      if(selected && field) {field.value=selected;if(label){label.hidden=false;label.textContent=`Тариф «${findTariff(selected as TariffCode).name}». Проба 14 дней со всеми функциями.`;}}
      if(new URLSearchParams(window.location.search).get("installer")==="1") void downloadPage.openFromEmail();
    if(form){const runtime=browserLeadFormRuntime(window);const followup=initDownloadFollowup(document,form,runtime,downloadPage.edit);form.addEventListener('focusin',downloadPage.prefetch,{once:true});form.addEventListener('pointerdown',downloadPage.prefetch,{once:true});initLeadForm(form,runtime,({email})=>{followup.accepted();void downloadPage.accept(email);});}
</script>
</AutonomPage>
