---
import station from "../../assets/standalone/station-aggregation-dark-r3.png";
import duplicate from "../../assets/standalone/station-duplicate-dark-r3.png";
import office from "../../assets/standalone/office-overview-dark.png";
import handheld from "../../assets/standalone/tsd-work-dark.png";
import label from "../../assets/standalone/label-box-100x150.png";
import { PRODUCT_FACTS_EN as facts, V4_HOME_FAQ_EN as V4_HOME_FAQ } from "../../content/product-facts-en";
import { RU_PAGES_NOTE } from "../../content/autonom-en";
import { SITE_CONTACTS } from "../../content/contacts";
import { findTariff, formatRoubles } from "../../content/pricing";
import type { SeoPageDefinition } from "../../content/pages";
import { buildPageGraph } from "../../lib/seo";
import { readPublicSiteConfig } from "../../lib/site-config";
import AutonomPage from "./AutonomPage.astro";
import ClientStrip from "./ClientStrip.astro";
import Icon from "./Icon.astro";
import PriceCards from "./PriceCards.astro";
import ProductScreen from "./ProductScreen.astro";
import ScreenGallery from "./ScreenGallery.astro";
interface Props { page: SeoPageDefinition; }
const { page } = Astro.props;
const phone = readPublicSiteConfig({ PUBLIC_PHONE: import.meta.env.PUBLIC_PHONE }).phone;
const startPrice = formatRoubles(findTariff("start").priceFrom);
---

<AutonomPage metadata={page} graph={buildPageGraph(page)} phone={phone}>
  <section class="v4-section v4-hero" aria-labelledby="hero-title">
    <div class="ax-container v4-hero__grid">
      <div class="v4-stack">
        <p class="v4-eyebrow">Markiro Autonom · Windows</p>
        <h1 id="hero-title">{facts.heading}</h1>
        <p class="ax-lead">{facts.description}</p>
        <div class="ax-actions">
          <a class="ax-btn ax-btn--accent" href="/skachat/" hreflang="ru" data-analytics="landing_download_click" data-placement="hero">Try for 14 days <Icon name="download" size={18}/>
          </a>
          <a class="ax-btn ax-btn--outline" href="/stoimost/" hreflang="ru">From {startPrice} RUB a year</a>
        </div>
        <p class="ax-note">Every feature, no payment required</p>
        <p class="ax-note">{RU_PAGES_NOTE} The application interface is in Russian.</p>
      </div>
      <ProductScreen src={station} alt="Station: code checks and case aggregation" caption="Station: code checks and case aggregation. Demo data; interface in Russian." label="View the station screen" eager />
    </div>
  </section>
  <ClientStrip locale="en" kicker="Manufacturers using Markiro" />
  <section class="v4-section" id="product" aria-labelledby="product-title">
    <div class="ax-container v4-stack v4-stack--wide">
      <header>
        <h2 id="product-title">How Markiro works</h2>
        <p class="ax-muted">Scan your products. Markiro checks their codes and records the contents of each case.</p>
      </header>
      <div class="v4-workflow">
        <article class="v4-workflow__row">
          <div>
            <h3>Scan the product codes</h3>
            <p>Duplicate codes and codes for a different product are rejected.</p>
          </div>
          <ProductScreen src={duplicate} alt="Station rejecting a duplicate code" caption="Example: this code is already in the case. Markiro rejects the duplicate scan." label="View the code check" kind="duplicate" />
        </article>
        <article class="v4-workflow__row">
          <div>
            <h3>Close the case</h3>
            <p>When the case is packed, close it in the application. Markiro records its contents and prints an SSCC label.</p>
          </div>
          <div class="v4-label">
            <ProductScreen src={label} alt="SSCC label for a completed case" label="View the label" kind="label"/>
            <div>
              <h3>Label for the completed case</h3>
              <p>The SSCC links the case to the product codes inside it.</p>
            </div>
          </div>
        </article>
        <article class="v4-workflow__row">
          <div>
            <h3>Build a pallet in the same shift</h3>
            <p>Build cases and pallets in one aggregation shift, on a station or a handheld.</p>
          </div>
          <a class="ax-link" href="#no-cloud">More about handhelds <Icon name="arrow-up-right" size={16}/>
          </a>
        </article>
      </div>
      <aside class="v4-equipment">
        <div>
          <h3>
            <Icon name="monitor" size={22}/> What you need to get started</h3>
          <p>Start with one Windows 10/11 x64 PC, a Data Matrix scanner and a label printer that supports ZPL or TSPL.</p>
        </div>
        <a class="ax-link" href="/en/packing-workstation/">Equipment requirements <Icon name="arrow-up-right" size={16}/>
        </a>
      </aside>
    </div>
  </section>
  <section class="v4-section v4-section--panel" id="pricing" aria-labelledby="pricing-title">
    <div class="ax-container v4-stack v4-stack--wide">
      <header>
        <h2 id="pricing-title">Pricing</h2>
        <p class="ax-muted">Choose a plan and try every feature for 14 days. Prices are per site, per year, without VAT.</p>
      </header>
      <PriceCards compact locale="en"/>
      <a class="ax-link" href="/stoimost/" hreflang="ru">Compare plans <Icon name="arrow-up-right" size={16}/>
      </a>
    </div>
  </section>
  <section class="v4-section" id="no-cloud" aria-labelledby="local-title">
    <div class="ax-container v4-stack v4-stack--wide">
      <header>
        <h2 id="local-title">Work without internet access</h2>
        <p class="ax-muted">The application and database run on your production PC. Packing and aggregation do not require internet access.</p>
      </header>
      <div class="v4-roles">
        <article class="v4-stack">
          <h3>Office on PC</h3>
          <ProductScreen src={office} alt="Office on PC: shifts, products and production results" caption="Shifts, products and production results. Demo data; interface in Russian." label="View the office screen" kind="office"/>
        </article>
        <article class="v4-handheld">
          <div class="v4-handheld__copy v4-stack">
            <h3>{facts.handheld.heading}</h3>
            <p>{facts.handheld.description}</p>
            <p class="ax-note">{facts.handheld.connection}</p>
          </div>
          <ProductScreen src={handheld} alt="Handheld: code checks, case and pallet aggregation" label="View the handheld screen" kind="handheld"/>
        </article>
      </div>
      <div class="v4-data-facts">
        <article>
          <h3>Local database</h3>
          <p>Your database and shift results stay on your PC.</p>
        </article>
        <article>
          <h3>Backups</h3>
          <p>Database backups stay on your own equipment.</p>
        </article>
        <article>
          <h3>Files for GIS MT and 1C</h3>
          <p>Export shift results in TXT, CSV or XML.</p>
        </article>
      </div>
    </div>
  </section>
  <section class="v4-section v4-section--panel" id="start" aria-labelledby="trial-title">
    <div class="ax-container v4-two">
      <article class="v4-stack">
        <h2 id="trial-title">Try your own workflow</h2>
        <p>Check your own product codes, print a case label and export the shift results.</p>
        <a class="ax-btn ax-btn--accent" href="/skachat/" hreflang="ru" data-analytics="landing_download_click" data-placement="start">Try for 14 days <Icon name="download" size={18}/>
        </a>
        <p class="ax-note">Every feature is available during the trial. No advance licence payment is required.</p>
      </article>
      <article class="v4-stack" id="demo" aria-labelledby="support-title">
        <span id="about">
        </span>
        <h3 id="support-title">Vladislav Bogatyrev</h3>
        <p>I develop Markiro and answer support questions. I can help check your equipment before you start.</p>
        <a class="ax-link" href={`mailto:${SITE_CONTACTS.email}`}>{SITE_CONTACTS.email}</a>
        <a class="v4-material-link" href="/en/instructions/">
          <strong>Operator and office instructions <Icon name="arrow-up-right" size={16}/>
          </strong>
          <span>Codes, cases, pallets and exports.</span>
        </a>
        <a class="v4-material-link" href="/en/legal/">
          <strong>Documents and company details <Icon name="arrow-up-right" size={16}/>
          </strong>
          <span>Purchase terms and invoice details.</span>
        </a>
        <a class="ax-link" href={SITE_CONTACTS.telegram.href}>Telegram @{SITE_CONTACTS.telegram.handle}</a>{phone && <a href={phone.href} data-analytics="landing_phone_click" data-placement="final">{phone.display}</a>}</article>
    </div>
  </section>
  <section class="v4-section" id="faq" aria-labelledby="faq-title">
    <div class="ax-container v4-stack v4-stack--wide">
      <h2 id="faq-title">Questions before you start</h2>
      <div class="v4-faq" data-faq>{V4_HOME_FAQ.map((entry,i)=>
        <details data-faq-item open={i===0}>
          <summary>
            <h3>{entry.question}</h3>
          </summary>
          <p>{entry.answer}</p>
        </details>)}</div>
      <div class="ax-actions">
        <a class="ax-btn ax-btn--accent" href="/skachat/" hreflang="ru" data-analytics="landing_download_click" data-placement="final">Try for 14 days <Icon name="download" size={18}/>
        </a>
        <span class="ax-note">14 days, no payment required</span>
      </div>
    </div>
  </section>
  <ScreenGallery locale="en"/>
</AutonomPage>
