---
import { DOWNLOAD_PATH, HOME_COPY } from "../../content/autonom";
import { HOME_COPY_EN, RU_PAGES_NOTE } from "../../content/autonom-en";
import { SITE_CONTACTS } from "../../content/contacts";
import type { PublicPhone } from "../../lib/site-config";
import Icon from "./Icon.astro";

interface Props {
  phone: PublicPhone | null;
  /** The old site linked «/#demo» from every article; the final block keeps that anchor. */
  id?: string;
  locale?: "ru" | "en";
}

const { phone, id, locale = "ru" } = Astro.props;
const en = locale === "en";
const copy = en ? HOME_COPY_EN.final : HOME_COPY.final;
const labels = en
  ? { download: "Download the trial", phone: "Phone", email: "Email" }
  : { download: "Скачать пробную версию", phone: "Телефон", email: "Почта" };
// «Разобрать линию» is a call or a letter: the button opens a letter, the list beside it has the phone.
const callHref = `mailto:${SITE_CONTACTS.email}`;
---

<section class="ax-section ax-final" id={id} data-theme="dark" aria-labelledby="final-title">
  <div class="ax-container ax-final__inner">
    <div>
      <p class="ax-kicker">{copy.kicker}</p>
      <h2 class="ax-h2 ax-h2--lg" id="final-title">{copy.title}</h2>
      <div class="ax-actions">
        <a class="ax-btn ax-btn--accent ax-btn--lg" href={DOWNLOAD_PATH} hreflang={en ? "ru" : undefined} data-analytics="landing_download_click" data-placement="final">
          <span>{labels.download}</span>
          <span class="ax-btn__icon"><Icon name="download" size={18} /></span>
        </a>
        <a class="ax-btn ax-btn--outline ax-btn--lg" href={callHref} data-analytics="landing_demo_click" data-placement="final">{copy.call}</a>
      </div>
      {en && <p class="ax-note ax-final__note">{RU_PAGES_NOTE}</p>}
    </div>
    <dl class="ax-contacts">
      {phone && (
        <div>
          <dt>{labels.phone}</dt>
          <dd><a href={phone.href} data-analytics="landing_phone_click" data-placement="final">{phone.display}</a></dd>
        </div>
      )}
      <div>
        <dt>Telegram</dt>
        <dd><a href={SITE_CONTACTS.telegram.href}>@{SITE_CONTACTS.telegram.handle}</a></dd>
      </div>
      <div>
        <dt>{labels.email}</dt>
        <dd><a href={`mailto:${SITE_CONTACTS.email}`}>{SITE_CONTACTS.email}</a></dd>
      </div>
    </dl>
  </div>
</section>
