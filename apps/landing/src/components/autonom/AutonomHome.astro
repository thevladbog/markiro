---
import station from "../../assets/standalone/station-aggregation-dark-r3.png";
import duplicate from "../../assets/standalone/station-duplicate-dark-r3.png";
import office from "../../assets/standalone/office-overview-dark.png";
import handheld from "../../assets/standalone/tsd-work-dark.png";
import label from "../../assets/standalone/label-box-100x150.png";
import { PRODUCT_FACTS as facts, V4_HOME_FAQ } from "../../content/product-facts";
import { SITE_CONTACTS } from "../../content/contacts";
import { findTariff, formatRoubles } from "../../content/pricing";
import type { SeoPageDefinition } from "../../content/pages";
import { buildPageGraph } from "../../lib/seo";
import { readPublicSiteConfig } from "../../lib/site-config";
import AutonomPage from "./AutonomPage.astro";
import ClientStrip from "./ClientStrip.astro";
import Icon from "./Icon.astro";
import PriceCards from "./PriceCards.astro";
import ProductScreen from "./ProductScreen.astro";
import ScreenGallery from "./ScreenGallery.astro";
interface Props { page: SeoPageDefinition; }
const { page } = Astro.props;
const phone = readPublicSiteConfig({ PUBLIC_PHONE: import.meta.env.PUBLIC_PHONE }).phone;
const startPrice = formatRoubles(findTariff("start").priceFrom);
---

<AutonomPage metadata={page} graph={buildPageGraph(page)} phone={phone}>
  <section class="v4-section v4-hero" aria-labelledby="hero-title">
    <div class="ax-container v4-hero__grid">
      <div class="v4-stack">
        <p class="v4-eyebrow">Маркиро Автоном · Windows</p>
        <h1 id="hero-title">{facts.heading}</h1>
        <p class="ax-lead">{facts.description}</p>
        <div class="ax-actions">
          <a class="ax-btn ax-btn--accent" href="/skachat/" data-analytics="landing_download_click" data-placement="hero">Попробовать 14 дней <Icon name="download" size={18}/>
          </a>
          <a class="ax-btn ax-btn--outline" href="/stoimost/">От {startPrice} ₽ в год</a>
        </div>
        <p class="ax-note">Все функции, без оплаты</p>
      </div>
      <ProductScreen src={station} alt="Станция: проверка кодов и сборка короба" caption="Станция: проверка кодов и сборка короба. Демонстрационные данные." label="Посмотреть экран станции" eager />
    </div>
  </section>
  <ClientStrip kicker="С Маркиро работают" />
  <section class="v4-section" id="produkt" aria-labelledby="product-title">
    <div class="ax-container v4-stack v4-stack--wide">
      <header>
        <h2 id="product-title">Как работает Маркиро</h2>
        <p class="ax-muted">Вы сканируете продукцию. Маркиро проверяет коды и сохраняет состав каждого короба.</p>
      </header>
      <div class="v4-workflow">
        <article class="v4-workflow__row">
          <div>
            <h3>Сканируйте коды на товарах</h3>
            <p>Дубли и коды другого товара не попадут в короб.</p>
          </div>
          <ProductScreen src={duplicate} alt="Станция отклоняет повторный скан кода" caption="Пример: этот код уже есть в коробе. Маркиро отклонит повторный скан." label="Посмотреть проверку кода" kind="duplicate" />
        </article>
        <article class="v4-workflow__row">
          <div>
            <h3>Закройте короб</h3>
            <p>Когда короб собран, закройте его в программе. Маркиро сохранит состав и напечатает этикетку SSCC.</p>
          </div>
          <div class="v4-label">
            <ProductScreen src={label} alt="Этикетка SSCC готового короба" label="Открыть этикетку" kind="label"/>
            <div>
              <h3>Этикетка готового короба</h3>
              <p>SSCC связывает короб с кодами продукции внутри.</p>
            </div>
          </div>
        </article>
        <article class="v4-workflow__row">
          <div>
            <h3>Соберите паллету в этой же смене</h3>
            <p>Собирайте короба и паллеты в одной смене агрегации — на станции или ТСД.</p>
          </div>
          <a class="ax-link" href="#bez-oblaka">Подробнее о ТСД <Icon name="arrow-up-right" size={16}/>
          </a>
        </article>
      </div>
      <aside class="v4-equipment">
        <div>
          <h3>
            <Icon name="monitor" size={22}/> Что нужно для начала</h3>
          <p>Достаточно одного ПК с Windows 10/11 x64, сканера Data Matrix и принтера этикеток с ZPL или TSPL.</p>
        </div>
        <a class="ax-link" href="/rabochee-mesto-upakovki/">Требования к оборудованию <Icon name="arrow-up-right" size={16}/>
        </a>
      </aside>
    </div>
  </section>
  <section class="v4-section v4-section--panel" id="tseny" aria-labelledby="pricing-title">
    <div class="ax-container v4-stack v4-stack--wide">
      <header>
        <h2 id="pricing-title">Стоимость</h2>
        <p class="ax-muted">Выберите тариф и попробуйте программу 14 дней со всеми функциями. Цены за год на одну площадку, без НДС.</p>
      </header>
      <PriceCards compact/>
      <a class="ax-link" href="/stoimost/">Сравнить тарифы <Icon name="arrow-up-right" size={16}/>
      </a>
    </div>
  </section>
  <section class="v4-section" id="bez-oblaka" aria-labelledby="local-title">
    <div class="ax-container v4-stack v4-stack--wide">
      <header>
        <h2 id="local-title">Работайте без интернета</h2>
        <p class="ax-muted">Программа и база находятся на ПК производства. Для упаковки и агрегации интернет не нужен.</p>
      </header>
      <div class="v4-roles">
        <article class="v4-stack">
          <h3>Офис на ПК</h3>
          <ProductScreen src={office} alt="Офис на ПК: смены, продукция и результаты работы" caption="Смены, продукция и результаты работы. Демонстрационные данные." label="Увеличить экран офиса" kind="office"/>
        </article>
        <article class="v4-handheld">
          <div class="v4-handheld__copy v4-stack">
            <h3>{facts.handheld.heading}</h3>
            <p>{facts.handheld.description}</p>
            <p class="ax-note">{facts.handheld.connection}</p>
          </div>
          <ProductScreen src={handheld} alt="ТСД: проверка кодов, сборка коробов и паллет" label="Посмотреть экран ТСД" kind="handheld"/>
        </article>
      </div>
      <div class="v4-data-facts">
        <article>
          <h3>Локальная база</h3>
          <p>База и результаты смен хранятся на вашем ПК.</p>
        </article>
        <article>
          <h3>Резервные копии</h3>
          <p>Копии базы хранятся на вашем оборудовании.</p>
        </article>
        <article>
          <h3>Файлы для ГИС МТ и 1С</h3>
          <p>Выгружайте результаты смены в TXT, CSV или XML.</p>
        </article>
      </div>
    </div>
  </section>
  <section class="v4-section v4-section--panel" id="start" aria-labelledby="trial-title">
    <div class="ax-container v4-two">
      <article class="v4-stack">
        <h2 id="trial-title">Проверьте ваш рабочий сценарий</h2>
        <p>Проверьте коды своего товара, напечатайте этикетку короба и выгрузите результаты смены.</p>
        <a class="ax-btn ax-btn--accent" href="/skachat/" data-analytics="landing_download_click" data-placement="start">Попробовать 14 дней <Icon name="download" size={18}/>
        </a>
        <p class="ax-note">В пробный период доступны все функции. Оплачивать лицензию заранее не нужно.</p>
      </article>
      <article class="v4-stack" id="demo" aria-labelledby="support-title">
        <span id="kto">
        </span>
        <h3 id="support-title">Владислав Богатырев</h3>
        <p>Я разрабатываю Маркиро и отвечаю на вопросы. Помогу проверить оборудование перед запуском.</p>
        <a class="ax-link" href={`mailto:${SITE_CONTACTS.email}`}>{SITE_CONTACTS.email}</a>
        <a class="v4-material-link" href="/instruktsii/">
          <strong>Инструкции оператора и офиса <Icon name="arrow-up-right" size={16}/>
          </strong>
          <span>Коды, короба, паллеты и выгрузки.</span>
        </a>
        <a class="v4-material-link" href="/legal/">
          <strong>Документы и реквизиты <Icon name="arrow-up-right" size={16}/>
          </strong>
          <span>Условия покупки и данные для счёта.</span>
        </a>
        <a class="ax-link" href={SITE_CONTACTS.telegram.href}>Telegram @{SITE_CONTACTS.telegram.handle}</a>{phone && <a href={phone.href} data-analytics="landing_phone_click" data-placement="final">{phone.display}</a>}</article>
    </div>
  </section>
  <section class="v4-section" id="voprosy" aria-labelledby="faq-title">
    <div class="ax-container v4-stack v4-stack--wide">
      <h2 id="faq-title">Вопросы перед запуском</h2>
      <div class="v4-faq" data-faq>{V4_HOME_FAQ.map((entry,i)=>
        <details data-faq-item open={i===0}>
          <summary>
            <h3>{entry.question}</h3>
          </summary>
          <p>{entry.answer}</p>
        </details>)}</div>
      <div class="ax-actions">
        <a class="ax-btn ax-btn--accent" href="/skachat/" data-analytics="landing_download_click" data-placement="final">Попробовать 14 дней <Icon name="download" size={18}/>
        </a>
        <span class="ax-note">14 дней, без оплаты</span>
      </div>
    </div>
  </section>
  <ScreenGallery/>
</AutonomPage>
