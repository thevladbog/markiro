---
import {
  ALTERNATIVES,
  INVOICE_ANCHOR,
  PRICE_EXAMPLES,
  PRICING_COPY,
  PRICING_FAQ,
  TARIFF_TABLE,
} from "../../content/autonom";
import { findAutonomPage } from "../../content/autonom-pages";
import { SITE_CONTACTS } from "../../content/contacts";
import {
  ADDONS,
  FIRST_SITES_SEATS_LEFT,
  formatRoubles,
  LAUNCH_OPTIONS,
  TARIFFS,
} from "../../content/pricing";
import { buildAutonomPageGraph } from "../../lib/seo";
import { readPublicSiteConfig } from "../../lib/site-config";
import AutonomPage from "./AutonomPage.astro";
import FaqSection from "./FaqSection.astro";
import FinalCta from "./FinalCta.astro";
import Icon from "./Icon.astro";
import LeadConsent from "./LeadConsent.astro";
import LeadSubmit from "./LeadSubmit.astro";
import PriceCards from "./PriceCards.astro";

const page = findAutonomPage("/stoimost/");
const config = readPublicSiteConfig(
  {
    PUBLIC_DEMO_SUBMISSION_ENABLED: import.meta.env.PUBLIC_DEMO_SUBMISSION_ENABLED,
    PUBLIC_PHONE: import.meta.env.PUBLIC_PHONE,
    PUBLIC_SMARTCAPTCHA_CLIENT_KEY: import.meta.env.PUBLIC_SMARTCAPTCHA_CLIENT_KEY,
  },
  "ru",
);
const enabled =
  config.leadEndpoint !== null &&
  config.legalLinks !== null &&
  config.captchaClientKey !== null &&
  config.consentVersion !== null;
const copy = PRICING_COPY;
const tableHeads = TARIFFS.map((tariff) => tariff.name);
const sellable = TARIFFS.filter((tariff) => tariff.pricePerYear !== null);
const contactsLine = config.phone === null ? "" : `, ${config.phone.display}`;
---

<AutonomPage metadata={page} graph={buildAutonomPageGraph(page, { offers: true, faq: PRICING_FAQ })} phone={config.phone}>
  <section class="ax-hero ax-hero--page" aria-labelledby="pricing-title">
    <div class="ax-container">
      <div class="ax-section__head ax-section__head--split ax-section__head--page">
        <div>
          <p class="ax-kicker">{copy.kicker}</p>
          <h1 class="ax-h1 ax-h1--page" id="pricing-title">{copy.title}</h1>
          <p class="ax-lead">{copy.lead}</p>
        </div>
        <aside class="ax-offer ax-offer--strong">
          <p class="ax-kicker">{copy.firstSites.kicker}</p>
          <p class="ax-offer__title">{copy.firstSites.text}</p>
          <p class="ax-offer__terms">{copy.firstSites.terms} Осталось мест: {FIRST_SITES_SEATS_LEFT}.</p>
        </aside>
      </div>
      <PriceCards />
    </div>
  </section>

  <section class="ax-section ax-section--card" id="sravnenie" aria-labelledby="table-title">
    <div class="ax-container">
      <p class="ax-kicker">{copy.table.kicker}</p>
      <h2 class="ax-h2 ax-h2--md" id="table-title">{copy.table.title}</h2>
      <div class="ax-table-wrap" tabindex="0" role="region" aria-labelledby="table-title">
        <table class="ax-table">
          <thead>
            <tr>
              <td></td>
              {tableHeads.map((name, index) => (
                <th scope="col" class:list={{ "ax-table__hl": TARIFFS[index]?.recommended }}>{name}</th>
              ))}
            </tr>
          </thead>
          {TARIFF_TABLE.map((group) => (
            <tbody>
              <tr class="ax-table__group"><th scope="rowgroup" colspan="5">{group.label}</th></tr>
              {group.rows.map(([label, ...cells]) => (
                <tr>
                  <th scope="row">{label}</th>
                  {cells.map((cell, index) => (
                    <td class:list={{ "ax-table__hl": TARIFFS[index]?.recommended, "ax-table__mono": typeof cell === "string" && /\d/.test(cell) && group.label !== "Поддержка" }}>
                      {cell === true ? (
                        <><Icon name="check" size={16} class="ax-table__check" /><span class="ax-visually-hidden">да</span></>
                      ) : cell === false ? (
                        <><span aria-hidden="true">—</span><span class="ax-visually-hidden">нет</span></>
                      ) : cell}
                    </td>
                  ))}
                </tr>
              ))}
            </tbody>
          ))}
        </table>
      </div>
      <p class="ax-note">{copy.table.note}</p>
    </div>
  </section>

  <section class="ax-section" aria-label="Дополнения и запуск">
    <div class="ax-container ax-two">
      <article class="ax-card ax-price-card">
        <p class="ax-kicker">{copy.addons.kicker}</p>
        <h2 class="ax-h3 ax-h3--lg">{copy.addons.title}</h2>
        <dl class="ax-price-rows">
          {ADDONS.map((item) => (
            <div><dt>{item.name}</dt><dd class="ax-price-rows__price">{item.price}</dd><dd class="ax-price-rows__note">{item.note}</dd></div>
          ))}
        </dl>
      </article>
      <article class="ax-card ax-price-card">
        <p class="ax-kicker">{copy.launch.kicker}</p>
        <h2 class="ax-h3 ax-h3--lg">{copy.launch.title}</h2>
        <dl class="ax-price-rows">
          {LAUNCH_OPTIONS.map((item) => (
            <div><dt>{item.name}</dt><dd class="ax-price-rows__price">{item.price}</dd><dd class="ax-price-rows__note">{item.note}</dd></div>
          ))}
        </dl>
      </article>
    </div>
  </section>

  <section class="ax-section ax-section--card" id="primery" aria-labelledby="examples-title">
    <div class="ax-container">
      <p class="ax-kicker">{copy.examples.kicker}</p>
      <h2 class="ax-h2 ax-h2--md" id="examples-title">{copy.examples.title}</h2>
      <div class="ax-examples">
        {PRICE_EXAMPLES.map((example) => (
          <article class="ax-card ax-example">
            <h3 class="ax-h3">{example.title}</h3>
            <dl class="ax-example__lines">
              {example.lines.map(([name, price]) => <div><dt>{name}</dt><dd>{formatRoubles(price)} ₽</dd></div>)}
            </dl>
            <div class="ax-example__total">
              <p><span>Первый год</span><strong>{formatRoubles(example.firstYear)} ₽</strong></p>
              <small>{example.note}</small>
            </div>
          </article>
        ))}
      </div>
      <p class="ax-note">{copy.examples.note}</p>
    </div>
  </section>

  <section class="ax-section ax-compare" data-theme="dark" aria-labelledby="compare-title">
    <div class="ax-container">
      <p class="ax-kicker">{copy.comparison.kicker}</p>
      <h2 class="ax-h2 ax-h2--md ax-h2--narrow" id="compare-title">{copy.comparison.title}</h2>
      <ul class="ax-compare__list">
        {ALTERNATIVES.map((item) => (
          <li class:list={{ "ax-compare__ours": "ours" in item }}>
            <strong>{item.name}</strong>
            <span class="ax-compare__price">{item.price}</span>
            <span class="ax-compare__note">{item.note}</span>
          </li>
        ))}
      </ul>
      <p class="ax-note ax-note--mono">{copy.comparison.note}</p>
    </div>
  </section>

  <section class="ax-section ax-invoice" id={INVOICE_ANCHOR} aria-labelledby="invoice-title">
    <div class="ax-container">
      <form
        class="ax-form ax-form--inline"
        data-lead-form
        data-intent="invoice"
        data-endpoint={enabled ? config.leadEndpoint : undefined}
        data-consent-version={enabled ? config.consentVersion : undefined}
        novalidate
      >
        <h2 class="ax-h3 ax-h3--lg" id="invoice-title">{copy.invoice.title}</h2>
        <p class="ax-muted">{copy.invoice.lead}</p>
        <fieldset class="ax-form__fields ax-form__fields--row" data-lead-fields disabled={!enabled}>
          <div class="ax-field">
            <label for="invoice-inn">{copy.invoice.inn}</label>
            <input id="invoice-inn" name="inn" type="text" inputmode="numeric" autocomplete="off" maxlength="14" placeholder={copy.invoice.innPlaceholder} required />
            <p class="ax-field__error" id="invoice-inn-error" data-error-for="inn"></p>
          </div>
          <div class="ax-field">
            <label for="invoice-tariff">{copy.invoice.tariff}</label>
            <div class="ax-select">
              <select id="invoice-tariff" name="tariffCode" required data-invoice-select>
                {sellable.map((tariff) => (
                  <option value={tariff.code} selected={tariff.recommended} data-tariff-name={tariff.name}>
                    «{tariff.name}», {formatRoubles(tariff.pricePerYear ?? tariff.priceFrom)} ₽/год
                  </option>
                ))}
              </select>
              <Icon name="arrow-right" size={16} class="ax-select__chevron" />
            </div>
            <p class="ax-field__error" id="invoice-tariff-error" data-error-for="tariffCode"></p>
          </div>
          <div class="ax-field">
            <label for="invoice-email">{copy.invoice.email}</label>
            <input id="invoice-email" name="email" type="email" autocomplete="email" inputmode="email" maxlength="254" placeholder={copy.invoice.emailPlaceholder} required />
            <p class="ax-field__error" id="invoice-email-error" data-error-for="email"></p>
          </div>
          <div class="ax-field ax-field--submit">
            <LeadSubmit label={copy.invoice.submit} tone="dark" />
          </div>
          {enabled && config.legalLinks && config.captchaClientKey && (
            <div class="ax-form__extras">
              <LeadConsent idPrefix="invoice" legalLinks={config.legalLinks} captchaClientKey={config.captchaClientKey} />
            </div>
          )}
        </fieldset>
        <p class="ax-form__status" data-form-status aria-live="polite"></p>
        {!enabled && (
          <p class="ax-form__note">
            Отправка формы пока не подключена. Для счёта напишите ИНН и тариф на
            <a href={`mailto:${SITE_CONTACTS.email}`}>{SITE_CONTACTS.email}</a>.
          </p>
        )}
      </form>
      <div class="ax-success" data-invoice-success tabindex="-1" hidden>
        <Icon name="check-circle" size={22} />
        <div>
          <h2 class="ax-h3">{copy.invoice.successTitle}</h2>
          <p data-invoice-success-text data-template={copy.invoice.successText}></p>
        </div>
      </div>
    </div>
  </section>

  <FaqSection id="oplata" kicker={copy.faq.kicker} title={copy.faq.title} entries={PRICING_FAQ}>
    Нужен счёт или особые условия: Telegram <a href={SITE_CONTACTS.telegram.href}>@{SITE_CONTACTS.telegram.handle}</a>,
    <a href={`mailto:${SITE_CONTACTS.email}`}>{SITE_CONTACTS.email}</a>{contactsLine}.
  </FaqSection>

  <FinalCta phone={config.phone} />

  <script>
    import { browserLeadFormRuntime, initLeadForm } from "../../scripts/lead-form";
    import { selectInvoiceTariff, showInvoiceAccepted } from "../../scripts/invoice";

    const form = document.querySelector<HTMLFormElement>("[data-lead-form]");
    const select = document.querySelector<HTMLSelectElement>("[data-invoice-select]");
    selectInvoiceTariff(document, window, select);
    if (form !== null) {
      initLeadForm(form, browserLeadFormRuntime(window), ({ email }) => {
        showInvoiceAccepted(document, form, email);
      });
    }
  </script>
</AutonomPage>
