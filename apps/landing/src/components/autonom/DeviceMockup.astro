---
interface Props {
  kind: "monitor" | "handheld" | "none";
}

const { kind } = Astro.props;
---

{kind === "none" ? <slot /> : (
  <div class:list={["device-mockup", `device-mockup--${kind}`]} data-device-mockup={kind}>
    <div class="device-mockup__body">
      <span class="device-mockup__top" aria-hidden="true"></span>
      <div class="device-mockup__display"><slot /></div>
      <span class="device-mockup__bottom" aria-hidden="true"></span>
      {kind === "handheld" && <>
        <span class="device-mockup__key" aria-hidden="true"></span>
        <span class="device-mockup__bumper device-mockup__bumper--top" aria-hidden="true"></span>
        <span class="device-mockup__bumper device-mockup__bumper--bottom" aria-hidden="true"></span>
      </>}
    </div>
    {kind === "monitor" && <div class="device-mockup__stand" aria-hidden="true">
      <span class="device-mockup__neck"></span>
      <span class="device-mockup__foot"></span>
    </div>}
  </div>
)}

<style>
  .device-mockup {
    --mockup-screen-radius: 0.25rem;
    width: 100%;
    min-width: 0;
    isolation: isolate;
  }
  .device-mockup__body {
    position: relative;
    padding: 1.25% 1.25% 3%;
    border: 1px solid #88929b;
    border-radius: 0.75rem;
    background: #30363d;
    box-shadow: inset 0 1px 0 #a0a8af, 0 8px 20px rgb(0 0 0 / 14%);
  }
  .device-mockup__display {
    position: relative;
    z-index: 1;
    min-width: 0;
    overflow: hidden;
    border: 2px solid #15191e;
    border-radius: calc(var(--mockup-screen-radius) + 2px);
    background: #15191e;
  }
  .device-mockup__top {
    position: absolute;
    top: 0.45%;
    left: calc(50% - 2px);
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: #15191e;
  }
  .device-mockup__bottom {
    position: absolute;
    right: 2.5%;
    bottom: 1.3%;
    width: 3px;
    height: 3px;
    border-radius: 50%;
    background: var(--accent);
  }
  .device-mockup__stand {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: -1px;
  }
  .device-mockup__neck {
    width: 19%;
    height: clamp(1.5rem, 4vw, 3.25rem);
    background: linear-gradient(90deg, #353c44, #727c85 48%, #444d56);
    clip-path: polygon(23% 0, 77% 0, 100% 100%, 0 100%);
  }
  .device-mockup__foot {
    width: 41%;
    height: clamp(0.375rem, 0.65vw, 0.625rem);
    border: 1px solid #89939d;
    border-bottom: 2px solid #343b43;
    border-radius: 50% 50% 0.25rem 0.25rem;
    background: #59636e;
    box-shadow: 0 5px 8px rgb(0 0 0 / 12%);
  }
  .device-mockup--handheld {
    --mockup-screen-radius: 0.375rem;
    width: min(100%, 16.5rem);
    margin-inline: auto;
  }
  .device-mockup--handheld .device-mockup__body {
    padding: 10% 5% 8%;
    border: 2px solid #7b8791;
    border-radius: 1.25rem;
    background: #343d46;
    box-shadow: inset 0 0 0 2px #1a2026, 0 8px 20px rgb(0 0 0 / 16%);
  }
  .device-mockup--handheld .device-mockup__top {
    top: -0.6%;
    left: 18%;
    width: 64%;
    height: 4%;
    border: 1px solid #66737d;
    border-radius: 0.25rem;
    background: #26313b;
    box-shadow: inset 0 2px 0 #324750;
  }
  .device-mockup--handheld .device-mockup__top::after {
    content: "";
    position: absolute;
    inset: 28% 18%;
    border-top: 1px solid #385960;
    background: #111b21;
  }
  .device-mockup--handheld .device-mockup__bottom {
    right: 36%;
    bottom: 1.8%;
    width: 28%;
    height: 1%;
    min-height: 3px;
    border: 1px solid #7c8994;
    border-radius: 0.25rem;
    background: #20282f;
  }
  .device-mockup__key {
    position: absolute;
    top: 29%;
    right: -2%;
    width: 2%;
    height: 9%;
    border-radius: 0 0.2rem 0.2rem 0;
    background: #718077;
  }
  .device-mockup__bumper {
    position: absolute;
    right: -1%;
    left: -1%;
    height: 4.5%;
    border-inline: 4px solid #171d23;
    pointer-events: none;
  }
  .device-mockup__bumper--top {
    top: 1.5%;
    border-radius: 0.75rem 0.75rem 0 0;
  }
  .device-mockup__bumper--bottom {
    bottom: 1.5%;
    border-radius: 0 0 0.75rem 0.75rem;
  }
</style>
