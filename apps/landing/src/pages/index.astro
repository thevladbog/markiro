---
import { Picture } from "astro:assets";

import factoryImage from "../assets/factory-line.jpg";
import BrandMark from "../components/BrandMark.astro";
import DemoSection from "../components/DemoSection.astro";
import ImplementationSteps from "../components/ImplementationSteps.astro";
import LandingHeader from "../components/LandingHeader.astro";
import LineConsole from "../components/LineConsole.astro";
import PlatformModules from "../components/PlatformModules.astro";
import ProductModes from "../components/ProductModes.astro";
import ProductionCycle from "../components/ProductionCycle.astro";
import TraceLog from "../components/TraceLog.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { readPublicSiteConfig } from "../lib/site-config";

const siteConfig = readPublicSiteConfig({
  PUBLIC_DEMO_ENDPOINT: import.meta.env.PUBLIC_DEMO_ENDPOINT,
  PUBLIC_PHONE: import.meta.env.PUBLIC_PHONE,
});
---

<BaseLayout
  title="Markiro - маркировка и агрегация для производства"
  description="Markiro помогает выпускать коды, печатать этикетки, собирать короба и паллеты и сохранять прослеживаемость на производственной линии."
>
  <LandingHeader phone={siteConfig.phone} />

  <main id="main">
    <section class="hero" id="hero" aria-labelledby="hero-title">
      <div class="hero__media" aria-hidden="true">
        <Picture
          src={factoryImage}
          alt=""
          widths={[640, 960, 1376]}
          formats={["avif", "webp"]}
          sizes="(max-width: 767px) 100vw, 64vw"
          loading="eager"
          fetchpriority="high"
          data-hero-image
        />
      </div>
      <div class="hero__shade"></div>
      <div class="container hero__content">
        <p class="section-index" data-reveal>МАРКИРОВКА / АГРЕГАЦИЯ / ПРОСЛЕЖИВАЕМОСТЬ</p>
        <h1 id="hero-title" data-reveal>Линия идёт.<br />Маркировка под контролем.</h1>
        <p class="hero__lead" data-reveal>Проверяем коды, собираем короба и печатаем этикетки даже без интернета. Инженер поймёт процесс, работа продолжится.</p>
        <div class="hero__actions" data-reveal>
          <a class="button" href="#demo" data-analytics="landing_demo_click" data-placement="hero">Запросить демо <span aria-hidden="true">→</span></a>
          {siteConfig.phone && <a class="hero__phone" href={siteConfig.phone.href}>{siteConfig.phone.display}</a>}
        </div>
        <p class="hero__note" data-reveal>ДЛЯ ЛИНИЙ, КОТОРЫЕ НЕЛЬЗЯ ОСТАНАВЛИВАТЬ</p>
      </div>
      <div class="hero__console" data-reveal><LineConsole /></div>
    </section>

    <section class="section section--continuity" id="continuity" aria-labelledby="continuity-title">
      <div class="container">
        <div class="continuity-statement" data-reveal>
          <span aria-hidden="true"></span>
          <div>
            <p class="section-index">01 / НЕПРЕРЫВНОСТЬ</p>
            <h2 id="continuity-title">Сеть может исчезнуть.<br />Производство не должно.</h2>
            <p>Станция работает локально и синхронизирует операции, когда соединение возвращается.</p>
          </div>
        </div>
        <div class="continuity-points" data-reveal-group>
          <article data-reveal><span>01</span><h3>Проверка на месте</h3><p>Коды проходят проверку на станции без ожидания ответа сервера.</p></article>
          <article data-reveal><span>02</span><h3>Операции сохраняются</h3><p>Каждое действие остаётся в локальном журнале до уверенной отправки.</p></article>
          <article data-reveal><span>03</span><h3>Линия продолжает работу</h3><p>Оператор видит состояние и может восстановиться после сбоя.</p></article>
        </div>
      </div>
    </section>

    <ProductionCycle />
    <ProductModes />
    <TraceLog />
    <PlatformModules />
    <ImplementationSteps />
    <DemoSection phone={siteConfig.phone} demoEndpoint={siteConfig.demoEndpoint} />
  </main>

  <footer class="landing-footer">
    <div class="container landing-footer__inner">
      <a href="#hero" aria-label="Markiro, к началу страницы"><BrandMark /></a>
      <nav aria-label="Ссылки в подвале">
        <a href="#cycle">Как работает</a><a href="#platform">Система</a><a href="#demo">Контакты</a>
      </nav>
      <span>© 2026</span>
    </div>
  </footer>

  <script>
    import { browserDemoFormRuntime, initDemoForm } from "../scripts/demo-form";
    import { browserLandingRuntime, initLanding } from "../scripts/site";

    initLanding(document, browserLandingRuntime(window));
    const demoForm = document.querySelector<HTMLFormElement>("[data-demo-form]");
    if (demoForm !== null) initDemoForm(demoForm, browserDemoFormRuntime(window));
  </script>
</BaseLayout>
