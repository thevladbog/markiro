import productGtinOwner from "@markiro/legal-documents/assets/instructions/mkr-ins-10/ru/product-gtin-owner.png?url";
import productDraftBanner from "@markiro/legal-documents/assets/instructions/mkr-ins-10/ru/product-draft-banner.png?url";
