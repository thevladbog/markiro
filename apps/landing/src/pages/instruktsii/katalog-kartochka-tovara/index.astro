import productDraft from "@markiro/legal-documents/assets/instructions/mkr-ins-10/ru/product-draft.png?url";
import productCard from "@markiro/legal-documents/assets/instructions/mkr-ins-10/ru/product-card.png?url";
import productCardEnd from "@markiro/legal-documents/assets/instructions/mkr-ins-10/ru/product-card-end.png?url";
