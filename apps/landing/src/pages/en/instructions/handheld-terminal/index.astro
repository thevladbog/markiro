  "pairing-source": { src: pairingSource, width: 720, height: 1280 },
  "pairing-form": { src: pairingForm, width: 720, height: 1280 },
  "pairing-fingerprint": { src: pairingFingerprint, width: 720, height: 1280 },
  "pairing-done": { src: pairingDone, width: 720, height: 1280 },
  "office-devices": officeDevices,
  "office-handheld-line": officeHandheldLine,
  "sign-in": { src: signIn, width: 720, height: 1440 },
  "hub": { src: hub, width: 720, height: 1280 },
  "printer-add": { src: printerAdd, width: 720, height: 1280 },
  "printer-assignments": { src: printerAssignments, width: 720, height: 1280 },
  "pallet-empty": { src: palletEmpty, width: 720, height: 1280 },
  "pallet-boxes": { src: palletBoxes, width: 720, height: 1280 },
  "pallet-verdict": { src: palletVerdict, width: 720, height: 1280 },
  "pallet-close-confirm": { src: palletCloseConfirm, width: 720, height: 1280 },
  "pallet-printed": { src: palletPrinted, width: 720, height: 1600 },
  "pallet-print-failed": { src: palletPrintFailed, width: 720, height: 1600 },
  "pallet-disassemble-scan": { src: palletDisassembleScan, width: 720, height: 1600 },
  "pallet-disassemble-reason": { src: palletDisassembleReason, width: 720, height: 1600 },
  "pallet-disassemble-confirm": { src: palletDisassembleConfirm, width: 720, height: 1600 },
  "hub-offline": { src: hubOffline, width: 720, height: 1280 },
  "host-queue": { src: hostQueue, width: 720, height: 1280 },
};
---

<InstructionDocument page={getLegalDocumentPage("MKR-INS-14", "en")} images={images} />
