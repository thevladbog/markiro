---
import loginBadge from "@markiro/legal-documents/assets/instructions/mkr-ins-01/en/login-badge.png?url";
import loginPin from "@markiro/legal-documents/assets/instructions/mkr-ins-01/en/login-pin.png?url";
import loginNameSearch from "@markiro/legal-documents/assets/instructions/mkr-ins-01/en/login-name-search.png?url";
import loginWrongPin from "@markiro/legal-documents/assets/instructions/mkr-ins-01/en/login-wrong-pin.png?url";
import shiftSelect from "@markiro/legal-documents/assets/instructions/mkr-ins-01/en/shift-select.png?url";
import newShift from "@markiro/legal-documents/assets/instructions/mkr-ins-01/en/new-shift.png?url";
import newShiftPallets from "@markiro/legal-documents/assets/instructions/mkr-ins-01/en/new-shift-pallets.png?url";
import newShiftTemplate from "@markiro/legal-documents/assets/instructions/mkr-ins-01/en/new-shift-template.png?url";
import newShiftPalletTemplate from "@markiro/legal-documents/assets/instructions/mkr-ins-01/en/new-shift-pallet-template.png?url";
import workStart from "@markiro/legal-documents/assets/instructions/mkr-ins-01/en/work-start.png?url";

import { getLegalDocumentPage } from "../../../../content/legal-pages";
import InstructionDocument from "../../../../components/InstructionDocument.astro";

const images = {
  "login-badge": loginBadge,
  "login-pin": loginPin,
  "login-name-search": loginNameSearch,
  "login-wrong-pin": loginWrongPin,
  "shift-select": shiftSelect,
  "new-shift": newShift,
  "new-shift-pallets": newShiftPallets,
  "new-shift-template": newShiftTemplate,
  "new-shift-pallet-template": newShiftPalletTemplate,
  "work-start": workStart,
};
---

<InstructionDocument page={getLegalDocumentPage("MKR-INS-01", "en")} images={images} />
