import palletBoxes from "@markiro/legal-documents/assets/instructions/mkr-ins-15/en/pallet-boxes.png?url";
import palletClose from "@markiro/legal-documents/assets/instructions/mkr-ins-15/en/pallet-close.png?url";
import palletLabel from "@markiro/legal-documents/assets/instructions/mkr-ins-15/en/pallet-label.png?url";
import officePallet from "@markiro/legal-documents/assets/instructions/mkr-ins-15/en/office-pallet.png?url";

import { getLegalDocumentPage } from "../../../../content/legal-pages";
