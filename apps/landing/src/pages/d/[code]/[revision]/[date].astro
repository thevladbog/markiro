---
import { LEGAL_RELEASES, type LegalDocumentRelease } from "@markiro/legal-documents";

import LegalVerification from "../../../../components/LegalVerification.astro";

export function getStaticPaths() {
  return (LEGAL_RELEASES as readonly LegalDocumentRelease[])
    .filter(({ status }) => status !== "draft")
    .map((release) => ({
    params: {
      code: release.code,
      revision: release.revision,
      date: release.effectiveDate,
    },
    props: { release },
    }));
}

interface Props {
  release: LegalDocumentRelease;
}

const { release } = Astro.props;
---

<LegalVerification release={release} />
