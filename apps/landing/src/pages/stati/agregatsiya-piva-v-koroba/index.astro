---
import { Picture } from "astro:assets";

import articleHero from "../../../assets/beer-case-aggregation-hero.png";
import LandingFooter from "../../../components/LandingFooter.astro";
import LandingHeader from "../../../components/LandingHeader.astro";
import { BEER_CASE_AGGREGATION_ARTICLE } from "../../../content/articles";
import { buildArticlePageGraph } from "../../../lib/seo";
import { readPublicSiteConfig } from "../../../lib/site-config";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const article = BEER_CASE_AGGREGATION_ARTICLE;
const config = readPublicSiteConfig({ PUBLIC_PHONE: import.meta.env.PUBLIC_PHONE });
---

<BaseLayout metadata={article} graph={buildArticlePageGraph(article)}>
  <LandingHeader page={article} phone={config.phone} />
  <main id="main" class="article-page">
    <header class="article-hero">
      <div class="container article-hero__inner">
        <nav class="breadcrumbs" aria-label="Хлебные крошки">
          <ol>
            <li><a href="/">Markiro</a></li>
            <li aria-current="page">{article.navigationLabel}</li>
          </ol>
        </nav>
        <div class="article-hero__layout">
          <div class="article-hero__copy">
            <p class="section-index">{article.eyebrow}</p>
            <h1>{article.heading}</h1>
            <p class="article-hero__lead">{article.introduction}</p>
            <div class="article-byline" aria-label="Сведения о публикации">
              <span>{article.authorName}</span>
              <time datetime={article.publishedAt}>26 августа 2026</time>
              <span>{article.readingTimeMinutes} минут чтения</span>
            </div>
          </div>
          <figure class="article-hero__media" data-article-visual>
            <Picture
              src={articleHero}
              alt="Оператор сканирует Data Matrix на бутылке перед укладкой в короб и печатью SSCC"
              widths={[480, 720, 1080]}
              formats={["avif", "webp"]}
              sizes="(max-width: 767px) 100vw, 45vw"
              loading="eager"
              fetchpriority="high"
              data-article-hero-image
            />
            <figcaption>Проверка кода до укладки связывает физический короб с достоверным цифровым составом.</figcaption>
          </figure>
        </div>
      </div>
    </header>

    <article class="container article-body">
      <aside class="article-summary" aria-labelledby="article-summary-title">
        <p class="section-index">Коротко</p>
        <h2 id="article-summary-title">Что важно предусмотреть</h2>
        <ul>
          <li data-key-takeaway>Агрегация должна быть частью рабочего цикла упаковщика, а не отдельной операцией после смены.</li>
          <li data-key-takeaway>Каждый код проверяется до добавления в короб.</li>
          <li data-key-takeaway>SSCC идентифицирует конкретную транспортную упаковку и не используется повторно для другого короба.</li>
          <li data-key-takeaway>Ошибка печати, неверный скан и потеря сети требуют явного сценария восстановления.</li>
          <li data-key-takeaway>Локальная станция сохраняет допустимые операции до синхронизации с сервером.</li>
        </ul>
      </aside>

      <nav class="article-toc" aria-label="Содержание статьи">
        <p class="section-index">Содержание</p>
        <ol>
          <li><a href="#category">Товарная группа</a></li>
          <li><a href="#aggregation">Агрегация и SSCC</a></li>
          <li><a href="#workflow">Рабочий цикл короба</a></li>
          <li><a href="#exceptions">Ошибки на линии</a></li>
          <li><a href="#checklist">Проверка перед запуском</a></li>
          <li><a href="#markiro">Как работает Markiro</a></li>
        </ol>
      </nav>

      <section id="category" aria-labelledby="category-title">
        <p class="section-index">01 / Категория</p>
        <h2 id="category-title">Какие напитки относятся к товарной группе</h2>
        <p>Официальное название категории — <strong>«Пиво, напитки, изготавливаемые на основе пива, и отдельные виды слабоалкогольных напитков»</strong>.</p>
        <p>В неё входят пиво и пивные напитки, а также отдельные виды слабоалкогольной продукции, включая соответствующие установленным кодам виды сидра. Одного коммерческого названия напитка недостаточно: применимость правил определяется одновременно по коду ТН ВЭД ЕАЭС и коду ОКПД 2.</p>
        <p>Актуальный состав продукции следует проверять по <a href="https://markirovka.ru/knowledge/tovarnye-gruppy/pivo-pivniye-napitki/kakie-tovary-podlezhat-obyazatelnoy-markirovke-pivo">материалам «Честного знака»</a> и действующей редакции Постановления Правительства РФ № 2173.</p>
      </section>

      <section id="aggregation" aria-labelledby="aggregation-title">
        <p class="section-index">02 / Идентификация</p>
        <h2 id="aggregation-title">Что такое агрегация и зачем коробу SSCC</h2>
        <p><strong>Агрегация создаёт проверенную связь между кодами отдельных бутылок или банок и транспортной упаковкой, в которую они уложены.</strong> Для идентификации такой упаковки может использоваться SSCC — серийный номер транспортной упаковки.</p>
        <p><a href="https://www.gs1ru.org/gs1_system/capture/sscc/">Ассоциация GS1</a> описывает SSCC как уникальный идентификатор логистической единицы: короба, паллеты или другой упаковки, используемой для хранения и транспортировки продукции.</p>
        <p>В системе маркировки транспортной упаковке соответствует КИТУ. Для SSCC применяется идентификатор применения <code>(00)</code>. Код маркировки отдельной единицы и SSCC решают разные задачи: первый идентифицирует товар, второй — транспортный короб и его состав.</p>
        <figure class="article-visual" data-article-visual>
          <img
            src="/images/articles/agregatsiya-piva-sscc-flow.svg"
            width="1200"
            height="520"
            loading="lazy"
            decoding="async"
            alt="Схема: Data Matrix единицы проверяется, состав короба закрывается, затем печатается и проверяется уникальный SSCC"
            data-article-diagram
          />
          <figcaption>Агрегация фиксирует проверенную связь: код единицы → состав короба → уникальная этикетка SSCC.</figcaption>
        </figure>
        <div class="article-callout">
          <strong>SSCC нельзя возвращать в оборот.</strong>
          <p>Если закрытый короб расформирован, его номер остаётся в истории. Повторно собранный физический короб получает новый SSCC.</p>
        </div>
        <p>Официальная инструкция указывает, что сформированные КИТУ должны быть уникальными и сохраняются в системе для проверки. Подробнее — в <a href="https://markirovka.ru/knowledge/tovarnye-gruppy/pivo-pivniye-napitki/agregirovanie-markirovannogo-tovara-moloko">инструкции по агрегированию маркированного товара</a>.</p>
      </section>

      <section id="workflow" aria-labelledby="workflow-title">
        <p class="section-index">03 / Рабочий цикл</p>
        <h2 id="workflow-title">Как должен проходить рабочий цикл короба</h2>
        <p>Надёжный процесс начинается не с печати этикетки, а с производственного задания и правил упаковки. Оператор должен видеть следующий допустимый шаг и результат каждого сканирования.</p>
        <ol class="article-steps">
          <li>
            <h3>Открыть смену и получить задание</h3>
            <p>Станция знает продукт, параметры упаковки, рабочее место и оператора. Эти данные задают контекст проверки.</p>
          </li>
          <li>
            <h3>Открыть новый короб</h3>
            <p>На экране появляется пустая упаковка и счётчик заполнения. Пока короб открыт, в него добавляются только допустимые коды.</p>
          </li>
          <li>
            <h3>Проверять каждую единицу</h3>
            <p>Станция принимает Data Matrix и сразу сообщает результат: код принят, уже сканировался, имеет неверный формат или не соответствует текущему заданию.</p>
          </li>
          <li>
            <h3>Проверить состав и закрыть короб</h3>
            <p>Один код не может принадлежать двум упаковкам. После набора установленного количества единиц состав фиксируется, а коробу назначается SSCC.</p>
          </li>
          <li>
            <h3>Напечатать и проверить этикетку</h3>
            <p>Этикетка содержит SSCC в GS1-128 и человекочитаемом виде. При включённой проверке оператор сканирует готовую этикетку до передачи короба дальше.</p>
          </li>
        </ol>
        <p>Подробнее о текущем контуре можно прочитать на странице <a href="/sscc-i-agregatsiya/">SSCC и агрегация коробов в Markiro</a>.</p>
      </section>

      <section id="exceptions" aria-labelledby="exceptions-title">
        <p class="section-index">04 / Исключения</p>
        <h2 id="exceptions-title">Какие ошибки чаще всего нарушают агрегацию</h2>
        <p><strong>Производственную систему определяет не только успешное закрытие короба, но и поведение при неизбежной ошибке оператора или оборудования.</strong></p>
        <figure class="article-visual" data-article-visual>
          <img
            src="/images/articles/agregatsiya-piva-exception-map.svg"
            width="1200"
            height="620"
            loading="lazy"
            decoding="async"
            alt="Карта восстановления: повторный скан, сбой печати, потеря сети и перезапуск проходят через локальный журнал станции"
            data-article-diagram
          />
          <figcaption>Ошибка не должна превращаться в остановку: станция сохраняет контекст и показывает оператору однозначный результат.</figcaption>
        </figure>
        <div class="article-cases">
          <article>
            <h3>Повторный скан</h3>
            <p>Система отклоняет дубль и не увеличивает счётчик короба. Проверка учитывает уже принятые операции, а не только текущий экран.</p>
          </article>
          <article>
            <h3>Код попал не в тот короб</h3>
            <p>Последний скан можно отменить, а открытый короб — очистить. Освобождённые коды должны снова стать доступными для корректного сканирования.</p>
          </article>
          <article>
            <h3>Короб закрыли раньше времени</h3>
            <p>Расформирование фиксируется отдельным событием. Исходный SSCC остаётся в истории, а новый короб получает новый номер.</p>
          </article>
          <article>
            <h3>Этикетка не напечаталась</h3>
            <p>Повторная печать относится к тому же закрытому коробу и использует тот же SSCC. Причина остаётся в журнале операций.</p>
          </article>
          <article>
            <h3>Пропал интернет</h3>
            <p>Допустимые операции выполняются локально. Оператор видит состояние соединения и количество событий, ожидающих отправки.</p>
          </article>
          <article>
            <h3>Станция перезапустилась</h3>
            <p>Активная смена, текущий короб и локальная очередь восстанавливаются. Уже назначенный SSCC не заменяется новым.</p>
          </article>
          <article>
            <h3>Сервер обнаружил конфликт</h3>
            <p>Конфликт становится видимым и восстанавливаемым: система различает принятую и отклонённую операцию вместо бесконечного скрытого повтора.</p>
          </article>
        </div>
        <p>Принципы локального журнала и синхронизации разобраны отдельно на странице <a href="/oflayn-rabota/">офлайн-работы производственной станции</a>.</p>
      </section>

      <section id="checklist" aria-labelledby="checklist-title">
        <p class="section-index">05 / Подготовка</p>
        <h2 id="checklist-title">Что проверить до пилотного запуска</h2>
        <div class="article-checklist">
          <div>
            <h3>Данные</h3>
            <ul>
              <li>Определены товары, GTIN и параметры упаковки.</li>
              <li>Проверены ТН ВЭД ЕАЭС и ОКПД 2.</li>
              <li>Настроен уникальный диапазон SSCC.</li>
              <li>Согласован состав обмена с учётными системами.</li>
            </ul>
          </div>
          <div>
            <h3>Оборудование</h3>
            <ul>
              <li>Сканер читает реальные коды с продукции.</li>
              <li>Принтер стабильно печатает SSCC и кириллицу.</li>
              <li>Этикетка читается после нанесения на короб.</li>
              <li>Оператор различает сигналы принятия и ошибки.</li>
            </ul>
          </div>
          <div>
            <h3>Восстановление</h3>
            <ul>
              <li>Проверены отмена скана и очистка короба.</li>
              <li>Проверены повторная печать и расформирование.</li>
              <li>Локальная очередь переживает перезапуск.</li>
              <li>После возвращения сети виден результат синхронизации.</li>
            </ul>
          </div>
        </div>
      </section>

      <section id="markiro" aria-labelledby="markiro-title">
        <p class="section-index">06 / Markiro</p>
        <h2 id="markiro-title">Как этот процесс организован в Markiro</h2>
        <p>Markiro связывает сканер, принтер, производственное задание и журнал операций в одном рабочем месте упаковщика.</p>
        <p>Основная специализация сейчас — продукция товарной группы «Пиво, напитки, изготавливаемые на основе пива, и отдельные виды слабоалкогольных напитков», включая пиво и соответствующие категории сидра. <strong>Новые товарные группы добавляются поэтапно.</strong></p>
        <ul>
          <li>проверка кодов и обнаружение повторов;</li>
          <li>сбор единиц в короб и назначение SSCC;</li>
          <li>печать и проверка этикетки;</li>
          <li>локальная работа при отсутствии сети;</li>
          <li>отмена скана, очистка, повторная печать и контролируемое расформирование;</li>
          <li>история действий по смене, оператору и рабочему месту.</li>
        </ul>
        <div class="article-callout article-callout--boundary">
          <strong>Текущий контур Markiro — «единица → короб → SSCC».</strong>
          <p>Паллетная агрегация относится к следующему этапу развития и не описывается здесь как уже доступная функция.</p>
        </div>
        <p>Состав обмена с «Честным знаком», 1С и другими системами определяется для конкретного предприятия: версия учётной системы, формат заданий и порядок восстановления ошибок могут различаться.</p>
      </section>

      <section class="article-conclusion" aria-labelledby="conclusion-title">
        <p class="section-index">Вывод</p>
        <h2 id="conclusion-title">Проверять нужно не только успешный короб</h2>
        <p>Агрегация пива — это производственный цикл, в котором участвуют оператор, сканер, принтер, сеть и учётные системы. Чем раньше ошибка обнаруживается на линии, тем меньше ручной сверки потребуется перед отгрузкой.</p>
        <p>При выборе решения проверьте поведение при дубле, ошибочной упаковке, повторной печати, потере сети и перезапуске станции — именно эти сценарии определяют устойчивость реального процесса.</p>
        <a class="button" href="/#demo" data-analytics="landing_demo_click" data-placement="article-conclusion">
          Разобрать одну линию <span aria-hidden="true">→</span>
        </a>
      </section>

      <section class="article-related" aria-labelledby="article-related-title">
        <p class="section-index">По теме</p>
        <h2 id="article-related-title">Следующие материалы</h2>
        <div class="seo-related__grid">
          <a href="/stati/markirovka-piva-2026/"><span>Маркировка пива в 2026 году</span><span aria-hidden="true">→</span></a>
          <a href="/sscc-i-agregatsiya/"><span>SSCC и агрегация</span><span aria-hidden="true">→</span></a>
          <a href="/rabochee-mesto-upakovki/"><span>Рабочее место упаковщика</span><span aria-hidden="true">→</span></a>
          <a href="/oflayn-rabota/"><span>Офлайн-работа производства</span><span aria-hidden="true">→</span></a>
        </div>
      </section>
    </article>
  </main>
  <LandingFooter page={article} />

  <script>
    import { browserLandingRuntime, initLanding } from "../../../scripts/site";

    initLanding(document, browserLandingRuntime(window));
  </script>
</BaseLayout>
