---
import { Picture } from "astro:assets";

import articleHero from "../../../assets/offline-beer-marking-hero.png";
import LandingFooter from "../../../components/LandingFooter.astro";
import LandingHeader from "../../../components/LandingHeader.astro";
import { OFFLINE_BEER_MARKING_ARTICLE } from "../../../content/articles";
import { buildArticlePageGraph } from "../../../lib/seo";
import { readPublicSiteConfig } from "../../../lib/site-config";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const article = OFFLINE_BEER_MARKING_ARTICLE;
const config = readPublicSiteConfig({ PUBLIC_PHONE: import.meta.env.PUBLIC_PHONE });
---

<BaseLayout metadata={article} graph={buildArticlePageGraph(article)}>
  <LandingHeader page={article} phone={config.phone} />
  <main id="main" class="article-page">
    <header class="article-hero">
      <div class="container article-hero__inner">
        <nav class="breadcrumbs" aria-label="Хлебные крошки"><ol><li><a href="/">Markiro</a></li><li aria-current="page">{article.navigationLabel}</li></ol></nav>
        <div class="article-hero__layout">
          <div class="article-hero__copy">
            <p class="section-index">{article.eyebrow}</p>
            <h1>{article.heading}</h1>
            <p class="article-hero__lead">{article.introduction}</p>
            <div class="article-byline" aria-label="Сведения о публикации"><span>{article.authorName}</span><time datetime={article.publishedAt}>26 августа 2026</time><span>{article.readingTimeMinutes} минут чтения</span></div>
          </div>
          <figure class="article-hero__media" data-article-visual>
            <Picture src={articleHero} alt="Оператор продолжает локальную проверку кодов на компактной линии розлива во время сбоя сети" widths={[480, 720, 1080]} formats={["avif", "webp"]} sizes="(max-width: 767px) 100vw, 45vw" loading="eager" fetchpriority="high" data-article-hero-image />
            <figcaption>Устойчивая линия не скрывает потерю связи: она отделяет локально допустимую работу от операций, которым нужен сервер.</figcaption>
          </figure>
        </div>
      </div>
    </header>

    <article class="container article-body">
      <aside class="article-summary" aria-labelledby="article-summary-title">
        <p class="section-index">Коротко</p><h2 id="article-summary-title">Что важно при работе без сети</h2>
        <ul>
          <li data-key-takeaway>Офлайн на производстве — не кассовый локальный модуль «Честного знака», а заранее подготовленный локальный контур станции.</li>
          <li data-key-takeaway>Продолжать можно только задание, данные и права для которого уже загружены и проверены.</li>
          <li data-key-takeaway>Каждый скан, короб и исключение должны сначала попасть в устойчивый локальный журнал, а затем — в исходящую очередь.</li>
          <li data-key-takeaway>Повторная отправка обязана сохранять идентичность операции: отсутствие ответа ещё не означает, что сервер её не принял.</li>
          <li data-key-takeaway>Локальные дубли блокируются сразу; межтерминальные конфликты могут обнаружиться после синхронизации и требуют явного разбора.</li>
          <li data-key-takeaway>Markiro поддерживает контур единица → короб → SSCC; прямой обмен с ГИС МТ настраивается и принимается отдельно.</li>
        </ul>
      </aside>

      <nav class="article-toc" aria-label="Содержание статьи"><p class="section-index">Содержание</p><ol><li><a href="#answer">Короткий ответ</a></li><li><a href="#boundary">Граница офлайна</a></li><li><a href="#prepare">Подготовка смены</a></li><li><a href="#outage">Действия при сбое</a></li><li><a href="#journal">Журнал и дубли</a></li><li><a href="#recovery">Возврат связи</a></li><li><a href="#test">Приёмочные испытания</a></li><li><a href="#markiro">Граница Markiro</a></li></ol></nav>

      <section id="answer" aria-labelledby="answer-title">
        <p class="section-index">01 / Ответ</p><h2 id="answer-title">Можно ли маркировать пиво без интернета</h2>
        <p><strong>Да, подготовленная производственная станция может продолжать ограниченный локальный сценарий, если задание, справочники, коды и диапазоны SSCC получены заранее.</strong> Сканирование, локальная проверка, упаковка в короб и печать SSCC не должны зависеть от мгновенного ответа облака на каждую единицу. Но отсутствие сети не отменяет обязанности нанести средство идентификации и передать требуемые сведения в систему маркировки.</p>
        <p>Официальный материал по этапам маркировки пива прямо разделяет физическое нанесение и передачу сведений и указывает, что производство и перемещение продукции без нанесённого средства идентификации запрещены. Актуальный состав требований лучше сверять в <a href="https://markirovka.ru/knowledge/tovarnye-gruppy/pivo-pivniye-napitki/sroki-i-etapy-zapuska-obyazatelnoy-markirovki-piva-pivnykh-i-slaboalkogolnykh-napitkov">официальной памятке «Честного знака» по пиву и слабоалкогольным напиткам</a>.</p>
        <div class="article-callout"><strong>Правильная формулировка — «линия продолжает заранее разрешённую работу».</strong><p>Нельзя обещать, что интернет вообще не нужен. Новое задание, свежие права, пополнение кодов, внешнее подтверждение отчёта и итоговые статусы требуют связи.</p></div>
      </section>

      <section id="boundary" aria-labelledby="boundary-title">
        <p class="section-index">02 / Граница</p><h2 id="boundary-title">Что продолжает работать локально, а что должно ждать</h2>
        <p><strong>Граница проходит не между «программа работает» и «программа не работает», а между уже подготовленными данными и новой серверной информацией.</strong> Если сменное задание находится на станции, оператор может сканировать нанесённые коды, получать локальный вердикт, закрывать короб и печатать его SSCC из заранее выделенного диапазона. Каждая операция фиксируется на устройстве.</p>
        <p>Получать новый производственный заказ, расширять локальный запас кодов, менять серверно управляемые права или считать внешний отчёт подтверждённым без ответа нельзя. Станция должна показывать ограничение, а не зелёный успех. Официальное разъяснение о выдаче кодов подчёркивает, что автоматизированные системы получают и хранят коды в защищённом контуре: <a href="https://markirovka.ru/knowledge/tovarnyegruppy/obschie-voprosy-gis/pochemu-otklyuchena-vozmozhnost-polucheniya-kodov-markirovki-v-csv-formate-v-stantsii-upravleniya-za">требования к получению и хранению кодов в СУЗ</a>.</p>
        <figure class="article-visual" data-article-visual>
          <img src="/images/articles/markirovka-piva-offline-boundary.svg" width="1200" height="620" loading="lazy" decoding="async" alt="Граница между локальной работой станции маркировки пива и операциями, ожидающими восстановления сети" data-article-diagram />
          <figcaption>Локально выполняется только заранее подготовленный сценарий. Новые данные и внешнее подтверждение остаются в ожидании связи.</figcaption>
        </figure>
        <div class="article-callout article-callout--boundary"><strong>Не путайте производственный офлайн с офлайн-проверкой на кассе.</strong><p>Кассовый режим использует локальную базу продавца для решения о продаже. Его официальный порядок описан отдельно в <a href="https://markirovka.ru/knowledge/tovarnye-gruppy/pivo-pivniye-napitki/rezhim-proverok-na-kassakh-pivo">правилах проверок пивной продукции на кассах</a>. Он не заменяет журнал, очередь и восстановление производственной станции.</p></div>
      </section>

      <section id="prepare" aria-labelledby="prepare-title">
        <p class="section-index">03 / До смены</p><h2 id="prepare-title">Что нужно загрузить до потери связи</h2>
        <p><strong>Офлайн-устойчивость создаётся до начала розлива.</strong> Перед сменой станция должна получить производственное задание, GTIN и параметры продукта, шаблон этикетки, правила упаковки, полномочия оператора и локальный запас идентификаторов, достаточный для согласованного сценария. Если хотя бы один критичный элемент отсутствует, запускать работу «на доверии» нельзя.</p>
        <div class="article-checklist">
          <div><h3>Данные задания</h3><ul><li>продукт и GTIN;</li><li>плановый объём;</li><li>тип тары и короб;</li><li>версия шаблона.</li></ul></div>
          <div><h3>Локальные запасы</h3><ul><li>коды для текущей серии;</li><li>диапазон SSCC;</li><li>справочник операторов;</li><li>параметры принтера.</li></ul></div>
          <div><h3>Проверка старта</h3><ul><li>тестовый скан;</li><li>тестовая печать;</li><li>свободное место диска;</li><li>видимый статус сети.</li></ul></div>
        </div>
        <p>Для небольшого производства это не требует отдельного «космического» серверного проекта в цехе. Компактная станция может хранить нужный рабочий срез локально. Важно не количество стоек, а проверяемый контракт: какой запас подготовлен, кто его выдал и что произойдёт, когда он закончится. Подход к доступному запуску разобран в статье <a href="/stati/stoimost-markirovki-piva/">о стоимости маркировки пива</a>.</p>
      </section>

      <section id="outage" aria-labelledby="outage-title">
        <p class="section-index">04 / Сбой</p><h2 id="outage-title">Что должен делать оператор, когда пропал интернет</h2>
        <p><strong>Оператору нужен короткий режимный сценарий, а не диагностика сетевого стека.</strong> Интерфейс сообщает, что станция работает локально, показывает остаток доступного задания и число операций в очереди. Скан продолжается только при готовом локальном контексте; попытка открыть новое задание или выполнить серверно зависимое действие блокируется с понятным объяснением.</p>
        <ol class="article-steps">
          <li><h3>Зафиксировать статус</h3><p>Отметить время потери связи и убедиться, что станция показывает локальный режим, а не неизвестную ошибку.</p></li>
          <li><h3>Проверить запас</h3><p>Подтвердить, что текущее задание, коды, SSCC и правила упаковки доступны на устройстве.</p></li>
          <li><h3>Продолжать без обходов</h3><p>Не переносить коды в таблицу и не заводить параллельный ручной журнал: это создаёт вторую версию истины.</p></li>
          <li><h3>Остановиться на границе</h3><p>Если локальный запас закончился или требуется новая серверная операция, завершить безопасный шаг и ждать связи.</p></li>
        </ol>
        <p>Отдельно подготовьте действия при локальном аппаратном сбое: отказ принтера, сканера или диска — не тот же сценарий, что потеря интернета. Проверку чтения кода удобно вести по отдельной схеме из статьи <a href="/stati/data-matrix-pivo-ne-schityvaetsya/">о диагностике Data Matrix на пиве</a>.</p>
      </section>

      <section id="journal" aria-labelledby="journal-title">
        <p class="section-index">05 / Данные</p><h2 id="journal-title">Почему локальный журнал важнее индикатора «онлайн»</h2>
        <p><strong>Операция считается сохранённой после записи на устройство, а не после анимации в интерфейсе.</strong> У скана должны оставаться время, станция, смена, оператор, локальный результат и связь с коробом. Исходящая очередь переживает закрытие приложения и перезапуск компьютера. Иначе короткий сбой превращается в неопределённость: физическая бутылка уже прошла дальше, а доказательства операции нет.</p>
        <p>На одной станции повторный код можно остановить по локальному реестру. Между двумя изолированными станциями мгновенная глобальная проверка невозможна: один и тот же код может быть принят обеими. Поэтому сервер после восстановления связи выбирает исходный результат по установленным правилам, а проигравшая операция становится видимым конфликтом для ответственного сотрудника. Линия не должна молча переписать историю.</p>
        <p>Как отличить повторный скан от одного кода на двух товарах, дубля отчёта и допустимой перепечати, разбираем в отдельной инструкции <a href="/stati/dubl-koda-markirovki-pivo/">о дубликатах кодов маркировки пива</a>.</p>
        <p>Такой подход особенно важен при агрегации. Принятая единица входит в конкретный короб, закрытый короб получает один SSCC, а повторная печать этикетки не создаёт новый логический короб. Полный маршрут описан в статье <a href="/stati/agregatsiya-piva-v-koroba/">об агрегации пива в короба</a>.</p>
      </section>

      <section id="recovery" aria-labelledby="recovery-title">
        <p class="section-index">06 / Восстановление</p><h2 id="recovery-title">Как синхронизировать очередь без дублей</h2>
        <p><strong>После возвращения сети нужно повторять исходные операции с теми же идентификаторами, а не создавать новые.</strong> Сетевой тайм-аут не доказывает отказ: сервер мог принять пакет, но ответ не дошёл. Если повтор сформирован как новая операция, восстановление само создаёт дубликат.</p>
        <figure class="article-visual" data-article-visual>
          <img src="/images/articles/markirovka-piva-offline-recovery.svg" width="1200" height="620" loading="lazy" decoding="async" alt="Пять шагов восстановления очереди маркировки пива после возврата интернет-соединения" data-article-diagram />
          <figcaption>Сначала сохраняется факт, затем повторяется его доставка. Очередь удаляется только после однозначного результата.</figcaption>
        </figure>
        <p>Серверный ответ полезно разделять как минимум на четыре состояния: принято, уже принято, отклонено по бизнес-правилу и временно не обработано. Конфликт с другой станцией — отдельное состояние, а не разновидность сетевой ошибки. После синхронизации сверьте количество локально принятых единиц, коробов, конфликтов и записей, которые остались в очереди.</p>
      </section>

      <section id="test" aria-labelledby="test-title">
        <p class="section-index">07 / Приёмка</p><h2 id="test-title">Как проверить офлайн-режим до реального сбоя</h2>
        <p><strong>Отключите сеть во время приёмочного прогона и проверьте восстановление на реальной копии процесса.</strong> Демонстрация, где просто исчез значок Wi‑Fi, ничего не доказывает. Нужно пройти скан, закрытие короба, печать SSCC, перезапуск станции, повторную синхронизацию и конфликт.</p>
        <div class="article-cases">
          <article><h3>Короткий разрыв</h3><p>Ответ теряется после отправки пакета. Повтор не должен удвоить операцию или очистить очередь преждевременно.</p></article>
          <article><h3>Перезапуск</h3><p>Станция закрывается с ожидающими данными. После запуска журнал, короб и очередь должны восстановиться.</p></article>
          <article><h3>Две станции</h3><p>Один код принимается локально в двух местах. После синхронизации конфликт виден и имеет путь разбора.</p></article>
        </div>
        <p>Зафиксируйте критерии заранее: допустимые локальные операции, максимальный согласованный запас, поведение при его исчерпании, ответственность за конфликт и доказательства успешной доставки. Не обещайте «неограниченную работу без сети», если испытана только десятиминутная пауза.</p>
      </section>

      <section id="markiro" aria-labelledby="markiro-title">
        <p class="section-index">08 / Markiro</p><h2 id="markiro-title">Какую границу поддерживает Markiro</h2>
        <p><strong>Текущая станция Markiro хранит рабочий контекст локально, записывает сканы в журнал, формирует устойчивую очередь и синхронизирует её повторяемыми пакетами.</strong> Для коробов заранее выделяются диапазоны SSCC на терминал, поэтому две станции не должны печатать одинаковые номера. Локальный реестр блокирует повторный код на устройстве, а межстанционные конфликты становятся видимыми после связи.</p>
        <p>Рабочая граница продукта сейчас — <strong>единица → короб → SSCC</strong>. Передача во внешние системы строится через согласованный экспорт или интеграционный слой. Прямой обмен Markiro с СУЗ или ГИС МТ нельзя считать действующим, пока он отдельно не настроен и не принят на конкретном предприятии. Эта честная граница позволяет начать с современного компактного решения и расширять автоматизацию по мере роста линии.</p>
      </section>

      <section class="article-conclusion" aria-labelledby="conclusion-title">
        <p class="section-index">Вывод</p><h2 id="conclusion-title">Устойчивый офлайн — это сохранённая операция и понятная граница</h2>
        <p>Линия переживает потерю сети, когда заранее знает разрешённый объём работы, сохраняет каждый факт до отправки и восстанавливает исходную очередь без создания новых операций. Всё, что требует свежих данных или внешнего подтверждения, честно ждёт связи.</p>
        <a class="button" href="/#demo" data-analytics="landing_demo_click" data-placement="article-conclusion">Разобрать сценарий сбоя <span aria-hidden="true">→</span></a>
      </section>

      <section class="article-related" aria-labelledby="article-related-title">
        <p class="section-index">По теме</p><h2 id="article-related-title">Продолжить проектирование устойчивой линии</h2>
        <div class="seo-related__grid"><a href="/oflayn-rabota/"><span>Офлайн-контур Markiro</span><span aria-hidden="true">→</span></a><a href="/stati/agregatsiya-piva-v-koroba/"><span>Агрегация пива в короба</span><span aria-hidden="true">→</span></a><a href="/stati/stoimost-markirovki-piva/"><span>Доступный бюджет запуска</span><span aria-hidden="true">→</span></a></div>
      </section>
    </article>
  </main>
  <LandingFooter page={article} />
  <script>import { browserLandingRuntime, initLanding } from "../../../scripts/site"; initLanding(document, browserLandingRuntime(window));</script>
</BaseLayout>
