---
import { Picture } from "astro:assets";

import articleHero from "../../../assets/beer-marking-equipment-hero.png";
import LandingFooter from "../../../components/LandingFooter.astro";
import LandingHeader from "../../../components/LandingHeader.astro";
import { BEER_MARKING_EQUIPMENT_ARTICLE } from "../../../content/articles";
import { buildArticlePageGraph } from "../../../lib/seo";
import { readPublicSiteConfig } from "../../../lib/site-config";
import BaseLayout from "../../../layouts/BaseLayout.astro";

const article = BEER_MARKING_EQUIPMENT_ARTICLE;
const config = readPublicSiteConfig({ PUBLIC_PHONE: import.meta.env.PUBLIC_PHONE });
---

<BaseLayout metadata={article} graph={buildArticlePageGraph(article)}>
  <LandingHeader page={article} phone={config.phone} />
  <main id="main" class="article-page">
    <header class="article-hero">
      <div class="container article-hero__inner">
        <nav class="breadcrumbs" aria-label="Хлебные крошки"><ol><li><a href="/">Markiro</a></li><li aria-current="page">{article.navigationLabel}</li></ol></nav>
        <div class="article-hero__layout">
          <div class="article-hero__copy">
            <p class="section-index">{article.eyebrow}</p>
            <h1>{article.heading}</h1>
            <p class="article-hero__lead">{article.introduction}</p>
            <div class="article-byline" aria-label="Сведения о публикации"><span>{article.authorName}</span><time datetime={article.publishedAt}>26 августа 2026</time><span>{article.readingTimeMinutes} минут чтения</span></div>
          </div>
          <figure class="article-hero__media" data-article-visual>
            <Picture src={articleHero} alt="Линия розлива пива с принтером, камерой и рабочим местом оператора" widths={[480, 720, 1080]} formats={["avif", "webp"]} sizes="(max-width: 767px) 100vw, 45vw" loading="eager" fetchpriority="high" data-article-hero-image />
            <figcaption>Оборудование выбирают как связанный производственный контур, а не как набор отдельных устройств.</figcaption>
          </figure>
        </div>
      </div>
    </header>

    <article class="container article-body">
      <aside class="article-summary" aria-labelledby="article-summary-title">
        <p class="section-index">Коротко</p><h2 id="article-summary-title">Что важно до запроса коммерческого предложения</h2>
        <ul>
          <li data-key-takeaway>Сначала зафиксируйте тару, место и способ нанесения, фактическую скорость линии и уровень агрегации.</li>
          <li data-key-takeaway>Разделяйте ручной 2D-сканер, стационарный считыватель и верификатор: они отвечают на разные вопросы.</li>
          <li data-key-takeaway>Проверяйте не паспортную скорость устройства, а стабильность всего цикла на реальной упаковке.</li>
          <li data-key-takeaway>Заранее определите отбраковку, повторную печать, восстановление после перезапуска и работу без сети.</li>
          <li data-key-takeaway>Интерфейсы, формат задания и журнал операций так же важны, как принтер и камера.</li>
          <li data-key-takeaway>Совместимость подтверждается пилотом на конкретном предприятии; название технологии само по себе её не доказывает.</li>
        </ul>
      </aside>

      <nav class="article-toc" aria-label="Содержание статьи"><p class="section-index">Содержание</p><ol><li><a href="#process">Процесс до оборудования</a></li><li><a href="#contour">Функции линии</a></li><li><a href="#reading">Сканер, камера, верификатор</a></li><li><a href="#application">Способ нанесения</a></li><li><a href="#interfaces">Интерфейсы и ПО</a></li><li><a href="#acceptance">Приёмочные испытания</a></li><li><a href="#supplier">Вопросы поставщику</a></li><li><a href="#markiro">Граница Markiro</a></li></ol></nav>

      <section id="process" aria-labelledby="process-title">
        <p class="section-index">01 / Исходные данные</p><h2 id="process-title">Сначала выберите процесс, потом оборудование</h2>
        <p><strong>Правильный состав линии начинается не с модели принтера, а с карты производственного процесса.</strong> Одна и та же производительность по упаковкам в час может потребовать разной техники для стеклянной бутылки, банки, ПЭТ и кега. Важны материал и геометрия поверхности, доступное окно нанесения, ориентация тары, влажность, перепады скорости, накопители и место для отбраковки.</p>
        <p><a href="https://markirovka.ru/knowledge/tovarnye-gruppy/pivo-pivniye-napitki/markirovka-tovarov-proizvedennykh-na-territorii-rf-posledovatelnost-deystviy-pivo">Официальная последовательность действий</a> для российского производителя включает описание товара и получение GTIN, заказ кодов, нанесение средств идентификации и отправку отчёта о нанесении. Агрегация выполняется при необходимости. Это задаёт функции процесса, но не предписывает одну марку оборудования.</p>
        <p>До обращения к интегратору подготовьте таблицу по каждому SKU: тип тары, размеры этикетки или крышки, место кода, максимальная и минимальная скорость, размер партии, частота переналадки, короб и требуемый SSCC. Отдельно отметьте, что может делать оператор, а что должно выполняться автоматически.</p>
        <div class="article-callout"><strong>Современное решение не обязано начинаться с капитальной перестройки линии.</strong><p>Для небольшого производства разумный первый контур — одна станция, совместимый 2D-сканер и принтер, которые уже есть на площадке или подбираются после теста. Автоматический аппликатор, машинное зрение и отбраковка добавляются, когда фактическая скорость и экономика ошибок доказывают их необходимость. Так бюджет уходит на надёжный процесс, а не на преждевременную механику.</p></div>
      </section>

      <section id="contour" aria-labelledby="contour-title">
        <p class="section-index">02 / Функциональный контур</p><h2 id="contour-title">Какие функции должна закрыть линия маркировки пива</h2>
        <p><strong>Линия должна не просто напечатать код, а провести его от производственного задания до подтверждённой упаковки.</strong> Конкретные устройства можно заменить, но функции терять нельзя.</p>
        <figure class="article-visual" data-article-visual>
          <img src="/images/articles/oborudovanie-markirovki-piva-contour.svg" width="1200" height="620" loading="lazy" decoding="async" alt="Функциональный контур оборудования: задание, нанесение, чтение, отбраковка, агрегация и журнал" data-article-diagram />
          <figcaption>Источник задания и локальный журнал связывают физические узлы в один воспроизводимый процесс.</figcaption>
        </figure>
        <ol class="article-steps">
          <li><h3>Задание и коды</h3><p>Система связывает GTIN, партию, параметры нанесения и доступный пул кодов. На линии должна быть видна активная версия задания.</p></li>
          <li><h3>Нанесение</h3><p>Код поступает на типографскую этикетку, отдельную наклейку либо печатается непосредственно на упаковке. Выбор определяет принтер, аппликатор и расходные материалы.</p></li>
          <li><h3>Чтение и решение</h3><p>Считыватель передаёт результат программе. Она отличает корректную единицу от неверного GTIN, дубля и нераспознанного символа.</p></li>
          <li><h3>Отбраковка или останов</h3><p>Автоматическая линия должна физически отделить неподтверждённую единицу и подтвердить срабатывание. На ручном посту нужен однозначный сценарий изоляции.</p></li>
          <li><h3>Короб и SSCC</h3><p>Принятые единицы собираются в состав короба; после закрытия печатается и проверяется транспортная этикетка.</p></li>
          <li><h3>Журнал и обмен</h3><p>Операции сохраняются локально до подтверждённой отправки, чтобы перезапуск или разрыв сети не создавал невидимые дубли и потери.</p></li>
        </ol>
      </section>

      <section id="reading" aria-labelledby="reading-title">
        <p class="section-index">03 / Контроль чтения</p><h2 id="reading-title">Чем отличаются 2D-сканер, стационарная камера и верификатор</h2>
        <p><strong>Эти устройства нельзя выбирать по принципу «любое читает Data Matrix».</strong> Ручной 2D-сканер помогает оператору подтвердить единицу или короб. Стационарный промышленный считыватель работает без наведения на движущемся потоке и требует согласованной оптики, света, расстояния и триггера. Система машинного зрения может дополнительно оценивать положение кода и управлять отбраковкой.</p>
        <p>Верификатор решает другую задачу: измеряет качество символа по нормированной методике. Официальные требования к Data Matrix для пива указывают ECC-200 и качество нанесения не ниже <strong>1.5 (C)</strong>; для этикетки и прямого нанесения приведены разные стандарты оценки. Подробности и рекомендуемые размеры собраны в разделе <a href="https://markirovka.ru/knowledge/tovarnye-gruppy/pivo-pivniye-napitki/kakim-dolzhen-byt-datamatrix-trebovaniya-k-preobrazovaniyu-i-kachestvu-naneseniya-pivo">о преобразовании и качестве нанесения Data Matrix</a>.</p>
        <div class="article-callout"><strong>Производственный считыватель не заменяет формальную верификацию.</strong><p>Он доказывает чтение в конкретной конфигурации линии. Верификатор оценивает сам символ по методике. Для приёмки полезны оба результата.</p></div>
      </section>

      <section id="application" aria-labelledby="application-title">
        <p class="section-index">04 / Нанесение</p><h2 id="application-title">Как способ нанесения меняет состав оборудования</h2>
        <p><strong>Для пива доступны три принципиальных сценария: заранее напечатанная этикетка, отдельная этикетка с кодом и прямое нанесение на линии.</strong> В первом случае критичны управление сериализованным рулоном и соответствие фактической упаковки заданию. Во втором добавляются принтер этикеток и ручной либо автоматический аппликатор. В третьем печатающий модуль встраивается в транспортный тракт и синхронизируется с движением продукта.</p>
        <p>Официальные материалы допускают нанесение на потребительскую упаковку, укупорочное средство, кег, групповую упаковку, этикетку или стикер при соблюдении требований. На бутылках и ПЭТ код может располагаться на крышке, кольеретке, контрэтикетке или основной этикетке. Но допустимое место ещё не означает устойчивое чтение: нужна проверка изгиба, блика, конденсата, истирания и сохранности на всём сроке годности.</p>
        <p>Не фиксируйте технологию печати до испытания реальных материалов. Запросите серию образцов на минимальной и максимальной скорости, после остановки и повторного запуска, при штатной очистке линии и в ожидаемом диапазоне температуры и влажности.</p>
      </section>

      <section id="interfaces" aria-labelledby="interfaces-title">
        <p class="section-index">05 / Интерфейсы</p><h2 id="interfaces-title">Какие подключения и программные договорённости проверить</h2>
        <p><strong>Совместимость — это не только разъём.</strong> Зафиксируйте транспорт, протокол, кодировку, управляющие символы, окончание сообщения, подтверждение операции, таймаут, повтор и идентификатор задания. Для сканера важны режим USB HID или последовательный порт и сохранность GS-разделителя. Для принтера — язык задания, транспорт и обратная связь об ошибке.</p>
        <p>Текущее рабочее место Markiro принимает HID-ввод без отдельной настройки либо последовательный сканер. Принтер может быть выбран через установленную Windows-очередь, TCP или последовательный порт; форматы печати — <strong>ZPL и TSPL</strong>. Экран настройки позволяет выполнить контрольный скан и тестовую печать, а проверка этикетки связывает конкретный принтер, язык печати и сканер.</p>
        <p>Интеграция собственной товароучётной системы с ГИС МТ через API не является обязательной: официальный раздел <a href="https://markirovka.ru/knowledge/tovarnye-gruppy/pivo-pivniye-napitki/integratsiya-sistemy-markirovki-s-tovarouchetnoy-sistemoy-uchastnika-pivo">об интеграции товароучётной системы</a> оставляет это решение участнику. Но внутри проекта всё равно нужно определить владельца обмена, точки повторной отправки и сверку локальных операций с внешним статусом.</p>
      </section>

      <section id="acceptance" aria-labelledby="acceptance-title">
        <p class="section-index">06 / Приёмка</p><h2 id="acceptance-title">Как проверить оборудование до запуска всей линии</h2>
        <p><strong>Приёмка должна покрывать рабочий диапазон и восстановление после отказов, а не один красивый прогон.</strong> Начните с одного SKU и одного рабочего места, затем расширяйте матрицу.</p>
        <figure class="article-visual" data-article-visual>
          <img src="/images/articles/oborudovanie-markirovki-piva-acceptance.svg" width="1200" height="620" loading="lazy" decoding="async" alt="Матрица приёмки оборудования по таре, скорости, качеству, отказам и восстановлению" data-article-diagram />
          <figcaption>Для каждого сценария нужны ожидаемый результат, фактический результат, владелец отклонения и повторяемое доказательство.</figcaption>
        </figure>
        <ul>
          <li><strong>Тара:</strong> все материалы, цвета, диаметры, позиции кода и крайние варианты этикетки.</li>
          <li><strong>Скорость:</strong> пуск, штатный темп, кратковременный максимум, накопление и останов.</li>
          <li><strong>Качество:</strong> хорошие и пограничные образцы, блик, смещение, складка, загрязнение и износ.</li>
          <li><strong>Ошибки:</strong> непрочитанный код, неверный GTIN, дубль, пустой пул кодов, замятие этикетки и недоступный принтер.</li>
          <li><strong>Восстановление:</strong> потеря сети, перезапуск рабочего места, повтор задания, повторная печать и сверка физического короба.</li>
        </ul>
        <p>В протоколе фиксируйте конфигурацию оборудования и ПО, образец тары, скорость, освещение, расходный материал и версию задания. Иначе успешный тест невозможно воспроизвести после переналадки.</p>
      </section>

      <section id="supplier" aria-labelledby="supplier-title">
        <p class="section-index">07 / Закупка</p><h2 id="supplier-title">Что спросить у поставщика оборудования и интегратора</h2>
        <div class="article-checklist">
          <div><h3>О фактической линии</h3><ul><li>на какой нашей таре подтверждена скорость;</li><li>каков минимальный устойчивый размер модуля;</li><li>как решены свет, ориентация и триггер;</li><li>куда физически попадает брак.</li></ul></div>
          <div><h3>Об эксплуатации</h3><ul><li>каковы расходники и срок переналадки;</li><li>как очищать и калибровать узел;</li><li>какие запчасти держать на площадке;</li><li>кто отвечает за удалённый и выездной сервис.</li></ul></div>
          <div><h3>О данных и отказах</h3><ul><li>какие интерфейсы и протоколы доступны;</li><li>как получить статус печати и отбраковки;</li><li>что сохраняется при обрыве сети;</li><li>как исключается повтор после перезапуска.</li></ul></div>
        </div>
        <p>Приложите эти ответы к приёмочной матрице и договору. Формулировка «совместимо с Честным знаком» без перечня тары, скорости, интерфейсов и сценариев отказа слишком широка для производственной гарантии.</p>
      </section>

      <section id="markiro" aria-labelledby="markiro-title">
        <p class="section-index">08 / Markiro</p><h2 id="markiro-title">Какую часть контура закрывает Markiro</h2>
        <p>Markiro связывает задание, сканер, принтер, действия оператора, состав короба и локальный журнал. Рабочее место продолжает фиксировать операции при нестабильной связи и отправляет подготовленные данные контролируемо. Текущий контур — <strong>единица → короб → SSCC</strong>; паллетная агрегация относится к следующему этапу.</p>
        <div class="article-callout article-callout--boundary"><strong>Markiro не является универсальным комплектом механики линии.</strong><p>Автоматический аппликатор, промышленное машинное зрение, верификатор, конвейер и механизм отбраковки подбираются под площадку. Совместимость оборудования подтверждается на конкретном предприятии совместным пилотом.</p></div>
        <p>Основная специализация сейчас — товарная группа «Пиво, напитки, изготавливаемые на основе пива, слабоалкогольные напитки». Новые типы продукции добавляются поэтапно. Обмен с конкретной конфигурацией ГИС МТ, 1С, ЭДО и оборудования согласуется отдельно.</p>
      </section>

      <section class="article-conclusion" aria-labelledby="conclusion-title">
        <p class="section-index">Вывод</p><h2 id="conclusion-title">Покупайте подтверждённый процесс, а не перечень устройств</h2>
        <p>Надёжная линия начинается с карты функций и заканчивается воспроизводимой приёмкой на реальной таре. Тогда принтер, считыватель и программное обеспечение работают как один контур, а границы ответственности понятны до запуска.</p>
        <a class="button" href="/#demo" data-analytics="landing_demo_click" data-placement="article-conclusion">Разобрать контур одной линии <span aria-hidden="true">→</span></a>
      </section>

      <section class="article-related" aria-labelledby="article-related-title">
        <p class="section-index">По теме</p><h2 id="article-related-title">Продолжить подготовку линии</h2>
        <div class="seo-related__grid"><a href="/stati/stoimost-markirovki-piva/"><span>Стоимость запуска маркировки</span><span aria-hidden="true">→</span></a><a href="/stati/data-matrix-pivo-ne-schityvaetsya/"><span>Диагностика Data Matrix</span><span aria-hidden="true">→</span></a><a href="/stati/markirovka-piva-2026/"><span>Маркировка пива в 2026 году</span><span aria-hidden="true">→</span></a></div>
      </section>
    </article>
  </main>
  <LandingFooter page={article} />
  <script>import { browserLandingRuntime, initLanding } from "../../../scripts/site"; initLanding(document, browserLandingRuntime(window));</script>
</BaseLayout>
