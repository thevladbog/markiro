<?xml version="1.0" encoding="utf-8"?>
<!--
  The themed-icon variant: Android 13 and newer tint `monochrome` to the user's
  wallpaper palette. The v26 file stays for everything older, which ignores the
  extra layer rather than failing to parse it.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/markiro_icon_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
