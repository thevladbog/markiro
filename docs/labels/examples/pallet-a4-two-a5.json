{
  "name": "Палета А4 · две одинаковые А5",
  "purpose": "pallet",
  "spec": {
    "schemaVersion": 2,
    "kind": "pallet_sheet",
    "dpi": 300,
    "page": {
      "size": "A4",
      "orientation": "landscape",
      "copies": 2,
      "cutLine": true,
      "marginsMm": {
        "top": 10,
        "right": 7,
        "bottom": 10,
        "left": 7
      }
    },
    "body": [
      {
        "id": "content",
        "gapMm": 1,
        "kind": "stack",
        "children": [
          {
            "id": "header",
            "gapMm": 2,
            "kind": "row",
            "children": [
              {
                "id": "logo",
                "kind": "organization_logo",
                "source": "organization",
                "fallback": "markiro",
                "maxHeightMm": 12
              },
              {
                "id": "organization",
                "gapMm": 1,
                "kind": "stack",
                "children": [
                  {
                    "id": "org-name",
                    "kind": "field",
                    "field": "organization.name",
                    "fontSizePt": 11,
                    "bold": true,
                    "maxLines": 2
                  },
                  {
                    "id": "label-title",
                    "kind": "text",
                    "text": "ПАЛЕТА",
                    "fontSizePt": 8
                  }
                ]
              }
            ]
          },
          {
            "id": "separator",
            "kind": "line",
            "thicknessMm": 0.3
          },
          {
            "id": "product",
            "kind": "field",
            "field": "product.printName",
            "fontSizePt": 16,
            "bold": true,
            "maxLines": 5,
            "reservedLines": 5
          },
          {
            "id": "quantities",
            "gapMm": 4,
            "kind": "row",
            "children": [
              {
                "id": "boxes",
                "kind": "field_row",
                "label": "КОРОБОВ",
                "field": "boxCount",
                "fontSizePt": 28,
                "labelFontSizePt": 7,
                "gapMm": 0.6
              },
              {
                "id": "units",
                "kind": "field_row",
                "label": "ЕДИНИЦ",
                "field": "itemCount",
                "fontSizePt": 28,
                "labelFontSizePt": 7,
                "gapMm": 0.6
              }
            ]
          },
          {
            "id": "dates",
            "gapMm": 4,
            "kind": "row",
            "children": [
              {
                "id": "production",
                "when": {
                  "field": "productionDate",
                  "op": "present"
                },
                "kind": "field_row",
                "label": "ПРОИЗВЕДЕНО",
                "field": "productionDate",
                "fontSizePt": 10,
                "labelFontSizePt": 7,
                "gapMm": 0.6
              },
              {
                "id": "expiry",
                "when": {
                  "field": "expiryDate",
                  "op": "present"
                },
                "kind": "field_row",
                "label": "ГОДЕН ДО",
                "field": "expiryDate",
                "fontSizePt": 10,
                "labelFontSizePt": 7,
                "gapMm": 0.6
              }
            ]
          },
          {
            "id": "identifiers",
            "gapMm": 4,
            "kind": "row",
            "children": [
              {
                "id": "gtin",
                "kind": "field_row",
                "label": "GTIN",
                "field": "product.gtin",
                "fontSizePt": 10,
                "labelFontSizePt": 7,
                "gapMm": 0.6
              },
              {
                "id": "shift",
                "when": {
                  "field": "shiftNumber",
                  "op": "present"
                },
                "kind": "field_row",
                "label": "СМЕНА",
                "field": "shiftNumber",
                "fontSizePt": 10,
                "labelFontSizePt": 7,
                "gapMm": 0.6
              }
            ]
          },
          {
            "id": "egais",
            "when": {
              "field": "product.egais",
              "op": "present"
            },
            "kind": "field_row",
            "label": "КОД ЕГАИС",
            "field": "product.egais",
            "fontSizePt": 10,
            "labelFontSizePt": 7,
            "gapMm": 0.6
          }
        ]
      }
    ],
    "footer": {
      "id": "sscc",
      "kind": "sscc",
      "source": "sscc",
      "barHeightMm": 45,
      "moduleDots": 9,
      "fallbackModuleDots": 8,
      "align": "center"
    }
  }
}
