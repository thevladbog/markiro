    <!--Устаревшие типы-->
    <xs:simpleType name="date_type">
        <xs:annotation>
            <xs:documentation>(УСТАРЕВШИЙ ТИП) Значение даты в формате ДД.ММ.ГГГГ.</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:length value="10"/>
            <xs:pattern value="(0[1-9]{1}|[1-2]{1}[0-9]{1}|3[0-1]{1})\.(0[1-9]{1}|1[0-2]{1})\.(1[0-9]{3}|20[0-9]{2})"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="reaggregation_type_type">
        <xs:annotation>
            <xs:documentation>(УСТАРЕВШИЙ ТИП) Справочник типов трансформации упаковки
                Изъятие - REMOVING
                Добавление - ADDING
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="REMOVING"/>
            <xs:enumeration value="ADDING"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="gs1_uit_uitu_type">
        <xs:annotation>
            <xs:documentation>(УСТАРЕВШИЙ ТИП) Уникальный идентификатор транспортной упаковки или товара</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:pattern value="[0-9]{18}|[A-Za-z0-9]{31}|[A-Za-z0-9]{37}|[A-Za-z0-9]{38}|[A-Za-z0-9]{44}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="kit_type">
        <xs:annotation>
            <xs:documentation>(УСТАРЕВШИЙ ТИП) КИТ (код идентификации товара)</xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:minLength value="20"/>
            <xs:maxLength value="44"/>
            <xs:pattern
                    value="(RU|AM|BY|KZ|KG)-[A-Z0-9]{6}-[A-Z0-9]{10}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{24}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{25}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{27}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{29}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{31}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{33}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{34}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{37}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{38}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{39}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{40}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{44}|[a-zA-Z0-9_.,()/=!@$^\\|\[\]&quot;#%&amp;*;&lt;&gt;&apos;+:?\-{}~`]{45}"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="product_gender_type">
        <xs:annotation>
            <xs:documentation>(Устаревший тип) Пол обуви для описания остатков товара
                Мужской - MALE
                Женский - FEMALE
                Детская - BABY
                Унисекс - UNISEX
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="MALE"/>
            <xs:enumeration value="FEMALE"/>
            <xs:enumeration value="BABY"/>
            <xs:enumeration value="UNISEX"/>
        </xs:restriction>
    </xs:simpleType>
    <xs:simpleType name="age_category_type">
        <xs:annotation>
            <xs:documentation>(УСТАРЕВШИЙ ТИП) Возраст потребителя для описания остатков
                Детское - BABY
                Взрослое - ADULT
                Без возраста - NO_AGE
            </xs:documentation>
        </xs:annotation>
        <xs:restriction base="xs:string">
            <xs:enumeration value="BABY"/>
            <xs:enumeration value="ADULT"/>
            <xs:enumeration value="NO_AGE"/>
        </xs:restriction>
    </xs:simpleType>
</xs:schema>
