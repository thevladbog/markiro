                        <xs:element name="certificate_number" type="string255_type" minOccurs="0">
                            <xs:annotation>
                                <xs:documentation>Номер документа, подтверждающего соответствие
                                </xs:documentation>
                            </xs:annotation>
                        </xs:element>
                        <xs:element name="certificate_date" type="xs:date" minOccurs="0">
