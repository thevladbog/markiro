{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "design-handoff",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8734",
        "--directory",
        "docs/design-briefs/design_handoff_markiro"
      ],
      "port": 8734
    },
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": ["-c", "set -a; . ./.env; set +a; pnpm --filter @markiro/api dev"],
      "port": 3000
    },
    {
      "name": "admin",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@markiro/admin", "dev"],
      "port": 5173
    },
    {
      "name": "kiosk",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@markiro/kiosk", "dev"],
      "port": 5373
    },
    {
      "name": "landing",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@markiro/landing", "dev"],
      "port": 5473
    },
    {
      "name": "station",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["--filter", "@markiro/station", "dev"],
      "port": 5273
    },
    {
      "name": "screenshots",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8735", "--directory", "screenshots"],
      "port": 8735
    }
  ]
}
